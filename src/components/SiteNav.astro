---
/**
 * Górny pasek menu (wzór: globalny pasek apple.com): ciemny, półprzezroczysty, przyklejony u góry.
 * Na stronach z paskiem produktu (LocalNav) nie jest przyklejony: odjeżdża, a zostaje pasek produktu.
 *
 * Pozycje, kolejność i nazwy: src/lib/navigation.ts (produkty "wkrótce" nie wchodzą do menu).
 * Telefon i wąski tablet (≤ 833 px, próg apple.com): logo + ikona menu (na razie atrapa).
 */
import { getDictionary } from '../i18n/index.ts';
import { navItems } from '../lib/navigation.ts';
import { homePath } from '../i18n/routes.ts';
import type { Locale } from '../i18n/locales.ts';
import { SITE } from '../config/site.ts';

interface Props {
  locale: Locale;
  sticky?: boolean;
}

const { locale, sticky = true } = Astro.props;
const dict = getDictionary(locale);
const items = navItems(locale);
---

<header class:list={['nav', { 'nav--static': !sticky }]}>
  <nav class="nav__inner" aria-label={dict.nav.label}>
    <a class="nav__logo" href={homePath(locale)}>
      {SITE.name}
    </a>
    <ul class="nav__list" role="list">
      {items.map((item) => (
        <li class="nav__item">
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
    <span class="nav__menu" aria-hidden="true"></span>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--color-surface-dark) 80%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    color: color-mix(in srgb, var(--color-text-on-dark) 80%, transparent);
    font-size: 0.75rem; /* 12 px */
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .nav--static {
    position: static;
  }

  .nav a {
    text-decoration: none;
  }

  .nav__item a:hover {
    color: var(--color-text-on-dark);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    max-width: 64rem; /* 1024 px */
    height: 100%;
    margin-inline: auto;
    padding-inline: 1.375rem; /* 22 px */
  }

  .nav__logo {
    flex: none;
    color: var(--color-text-on-dark);
    font-size: 0.875rem; /* 14 px */
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .nav__list {
    display: flex;
    flex: 1;
    justify-content: space-between;
    max-width: 50rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__item {
    white-space: nowrap;
  }

  /* Ikona menu: dwie kreski 18 × 1 px (jak na apple.com). */
  .nav__menu {
    display: none;
    position: relative;
    width: 1.125rem;
    height: 0.4375rem;
  }

  .nav__menu::before,
  .nav__menu::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-text-on-dark);
  }

  .nav__menu::before {
    top: 0;
  }

  .nav__menu::after {
    bottom: 0;
  }

  @media (max-width: 833px) {
    .nav__list {
      display: none;
    }

    .nav__menu {
      display: block;
    }
  }
</style>
