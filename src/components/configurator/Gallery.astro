---
/**
 * Galeria w karcie konfiguratora (wzór: apple.com, strona "Kup").
 * Zdjęcia przewijają się w bok (palcem albo strzałkami), pod spodem kropki.
 *
 * Działa bez JavaScriptu (przewijanie z przyciąganiem, scroll-snap).
 * Mały skrypt na dole tylko obsługuje strzałki i podświetla aktywną kropkę.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  /** dark: render na czerni, pokazany w całości na czarnym slajdzie. */
  images: { src: ImageMetadata; alt: string; dark?: boolean }[];
  labels: { prev: string; next: string; dot: string };
}

const { images, labels } = Astro.props;
const dotLabel = (n: number) =>
  labels.dot.replace('{n}', String(n)).replace('{total}', String(images.length));
---

<div class="gallery" data-gallery>
  <div class="gallery__track" data-track tabindex="0">
    {images.map((image, i) => (
      <div class:list={['gallery__slide', { 'gallery__slide--dark': image.dark }]} data-slide>
        <Picture
          class="gallery__image"
          src={image.src}
          alt={image.alt}
          formats={['avif', 'webp']}
          widths={[800, 1200, 1600, 2000]}
          sizes="(max-width: 899px) 100vw, 800px"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      </div>
    ))}
  </div>

  {images.length > 1 && (
    <div class="gallery__controls">
      <button class="gallery__arrow" type="button" data-prev aria-label={labels.prev} disabled>
        <span class="gallery__chevron gallery__chevron--left" aria-hidden="true" />
      </button>
      <div class="gallery__dots">
        {images.map((_, i) => (
          <button
            class="gallery__dot"
            type="button"
            data-dot={i}
            aria-label={dotLabel(i + 1)}
            aria-current={i === 0 ? 'true' : undefined}
          />
        ))}
      </div>
      <button class="gallery__arrow" type="button" data-next aria-label={labels.next}>
        <span class="gallery__chevron gallery__chevron--right" aria-hidden="true" />
      </button>
    </div>
  )}
</div>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('[data-track]');
    const prev = gallery.querySelector<HTMLButtonElement>('[data-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-next]');
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (!track || dots.length === 0) continue;

    const count = dots.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) =>
      track.scrollTo({ left: Math.max(0, Math.min(count - 1, i)) * track.clientWidth });

    const update = () => {
      const i = current();
      dots.forEach((dot, n) => dot.toggleAttribute('aria-current', n === i));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === count - 1;
    };

    prev?.addEventListener('click', () => go(current() - 1));
    next?.addEventListener('click', () => go(current() + 1));
    dots.forEach((dot, n) => dot.addEventListener('click', () => go(n)));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(current() - 1);
      if (e.key === 'ArrowRight') go(current() + 1);
    });
  }
</script>

<style>
  .gallery {
    position: relative;
    height: 100%;
  }

  .gallery__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: inherit;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__track:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .gallery__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
  }

  .gallery__slide--dark {
    background: var(--color-bg-dark);
  }

  .gallery__slide.gallery__slide--dark :global(.gallery__image) {
    object-fit: contain;
  }

  .gallery__slide :global(picture) {
    height: 100%;
  }

  .gallery__slide :global(.gallery__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Strzałki i kropki (jak u Apple) ---------- */
  .gallery__controls {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    translate: -50% 0;
  }

  .gallery__arrow {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-text) 10%, var(--color-bg));
    color: var(--color-text);
    cursor: pointer;
  }

  .gallery__arrow:disabled {
    color: var(--color-line);
    cursor: default;
  }

  .gallery__chevron {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }

  .gallery__chevron--right {
    translate: -70% -50%;
    rotate: 45deg;
  }

  .gallery__chevron--left {
    translate: -30% -50%;
    rotate: -135deg;
  }

  .gallery__dots {
    display: flex;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    border-radius: 980px;
    background: color-mix(in srgb, var(--color-text) 10%, var(--color-bg));
  }

  .gallery__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-text-2);
    opacity: 0.5;
    cursor: pointer;
  }

  .gallery__dot[aria-current] {
    background: var(--color-text);
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gallery__track {
      scroll-behavior: smooth;
    }

    .gallery__dot,
    .gallery__arrow {
      transition:
        opacity 200ms var(--ease-out),
        background-color 200ms var(--ease-out),
        color 200ms var(--ease-out);
    }
  }

  @media (hover: hover) {
    .gallery__arrow:not(:disabled):hover {
      background: color-mix(in srgb, var(--color-text) 16%, var(--color-bg));
    }
  }
</style>
