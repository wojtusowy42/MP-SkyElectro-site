---
/**
 * Galeria w karcie konfiguratora (wzór: apple.com, strona "Kup").
 * Zdjęcia przewijają się w bok (palcem albo strzałkami), pod spodem kropki.
 *
 * Działa bez JavaScriptu (przewijanie z przyciąganiem, scroll-snap).
 * Mały skrypt na dole obsługuje strzałki, podświetla aktywną kropkę i słucha konfiguratora
 * (zdarzenie 'configurator:change'): przewija do slajdu świeżo wybranej opcji. Wersje zdjęć
 * w slajdach (data-versions, kolor, wariant) podmienia showVersions z src/lib/versions.ts. Rendery są na białym tle, jak karta.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  /**
   * Slajd = jedno zdjęcie albo kilka wersji (widać jedną). match: co wersja pokazuje,
   * 'krok=opcja' po spacji, np. 'variant=v1 color=blue'. Bez wyborów widać pierwszą.
   * show: id opcji, po których wybraniu galeria przewija do tego slajdu;
   * showAt: id kroku konfiguratora albo 'summary' ([data-step]); przewija do slajdu, gdy ten krok wjedzie na ekran.
   */
  images: {
    pictures: { src: ImageMetadata; alt: string; match?: string }[];
    show?: string[];
    showAt?: string;
    /** Slajd tylko dla tych wyborów ('krok=opcja' po spacji); gdy klient wybrał coś innego, znika razem z kropką. */
    only?: string;
    /** Zdjęcie przycięte do całej karty (object-fit: cover) zamiast całego w środku. */
    fill?: boolean;
  }[];
  labels: { prev: string; next: string; dot: string };
}

const { images, labels } = Astro.props;
const dotLabel = (n: number) =>
  labels.dot.replace('{n}', String(n)).replace('{total}', String(images.length));
---

<div class="gallery" data-gallery>
  <div class="gallery__track" data-track tabindex="0">
    {images.map((image, i) => (
      <div
        class:list={['gallery__slide', { 'gallery__slide--fill': image.fill }]}
        data-slide
        data-versions
        data-show={image.show?.join(' ')}
        data-show-at={image.showAt}
        data-only={image.only}
      >
        {image.pictures.map((picture, n) => (
          <div class="gallery__picture" data-match={picture.match} hidden={n > 0}>
            <Picture
              class="gallery__image"
              src={picture.src}
              alt={picture.alt}
              formats={['avif', 'webp']}
              widths={[800, 1200, 1600, 2000]}
              sizes="(max-width: 899px) 100vw, 800px"
              loading={i === 0 && n === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 && n === 0 ? 'high' : 'auto'}
            />
          </div>
        ))}
      </div>
    ))}
  </div>

  {images.length > 1 && (
    <div class="gallery__controls">
      <button class="gallery__arrow" type="button" data-prev aria-label={labels.prev} disabled>
        <span class="gallery__chevron gallery__chevron--left" aria-hidden="true" />
      </button>
      <div class="gallery__dots">
        {images.map((_, i) => (
          <button
            class="gallery__dot"
            type="button"
            data-dot={i}
            aria-label={dotLabel(i + 1)}
            aria-current={i === 0 ? 'true' : undefined}
          />
        ))}
      </div>
      <button class="gallery__arrow" type="button" data-next aria-label={labels.next}>
        <span class="gallery__chevron gallery__chevron--right" aria-hidden="true" />
      </button>
    </div>
  )}
</div>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('[data-track]');
    const prev = gallery.querySelector<HTMLButtonElement>('[data-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-next]');
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (!track || dots.length === 0) continue;

    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')];
    // Widoczne slajdy: te, których warunek (data-only) pasuje do wyborów; reszta ma hidden i nie liczy się w kropkach.
    const visible = () => slides.filter((s) => !s.hidden);
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) =>
      track.scrollTo({
        left: Math.max(0, Math.min(visible().length - 1, i)) * track.clientWidth,
      });

    const update = () => {
      const shown = visible();
      const i = current();
      dots.forEach((dot, n) => {
        dot.hidden = slides[n]!.hidden;
        dot.toggleAttribute('aria-current', shown[i] === slides[n]);
      });
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i >= shown.length - 1;
    };

    prev?.addEventListener('click', () => go(current() - 1));
    next?.addEventListener('click', () => go(current() + 1));
    dots.forEach((dot, n) => dot.addEventListener('click', () => go(visible().indexOf(slides[n]!))));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(current() - 1);
      if (e.key === 'ArrowRight') go(current() + 1);
    });

    // Konfigurator: wersje zdjęć podmienia showVersions (src/lib/versions.ts, wywoływane przez stronę).
    // Tutaj tylko przewijanie: świeżo wybrana opcja przewija do swojego slajdu (kolor nie przewija).
    let previous: string[] = [];
    window.addEventListener('configurator:change', (e) => {
      const selection = (e as CustomEvent<Record<string, string>>).detail;
      for (const s of slides) {
        s.hidden = (s.dataset.only ?? '')
          .split(' ')
          .filter(Boolean)
          .some((pair) => {
            const [step, opt] = pair.split('=') as [string, string];
            return selection[step] !== undefined && selection[step] !== opt;
          });
      }
      const values = Object.values(selection);
      const changed = values.filter((v) => !previous.includes(v));
      previous = values;
      const target = slides.findIndex(
        (s) => !s.hidden && changed.some((v) => s.dataset.show?.split(' ').includes(v)),
      );
      if (target !== -1) go(visible().indexOf(slides[target]!));
      else go(current());
      update();
    });

    // Kroki i podsumowanie ([data-step]) pojawiają się i znikają razem z wyborami (Svelte), więc po każdej
    // zmianie dopinamy obserwację nowych. Próg: górna krawędź powyżej 55% wysokości ekranu ("zjechałeś
    // trochę niżej"); przy łagodniejszym progu podsumowanie mogło trafić w strefę od razu po kliknięciu.
    const at = new Map(
      slides.flatMap((s, i) => (s.dataset.showAt ? [[s.dataset.showAt, i] as const] : [])),
    );
    if (at.size > 0) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const i = at.get((e.target as HTMLElement).dataset.step ?? '');
            if (e.isIntersecting && i !== undefined && !slides[i]!.hidden) go(visible().indexOf(slides[i]!));
          }
        },
        { rootMargin: '0px 0px -45% 0px' },
      );
      const watched = new Set<Element>();
      window.addEventListener('configurator:change', () =>
        requestAnimationFrame(() => {
          for (const el of document.querySelectorAll<HTMLElement>('[data-step]')) {
            if (at.has(el.dataset.step ?? '') && !watched.has(el)) {
              io.observe(el);
              watched.add(el);
            }
          }
        }),
      );
    }
  }
</script>

<style>
  .gallery {
    position: relative;
    height: 100%;
  }

  .gallery__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: inherit;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__track:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  /* Wersje zdjęcia leżą jedna na drugiej; zmiana wyboru robi płynne przenikanie (opacity) zamiast cięcia. */
  .gallery__slide {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    flex: 0 0 100%;
    scroll-snap-align: center;
  }

  .gallery__slide[hidden],
  .gallery__dot[hidden] {
    display: none;
  }

  .gallery__picture,
  .gallery__slide :global(picture) {
    height: 100%;
  }

  /* multiply musi być na elemencie, który przenika (opacity): na samym <img> w środku warstwa opacity
     odcina go od szarej karty i na czas przejścia widać białe tło renderu. */
  .gallery__picture {
    grid-area: 1 / 1;
    mix-blend-mode: multiply;
  }

  .gallery__picture[hidden] {
    display: block;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gallery__picture {
      transition:
        opacity 350ms var(--ease-out),
        visibility 0s;
    }

    .gallery__picture[hidden] {
      transition:
        opacity 350ms var(--ease-out),
        visibility 0s 350ms;
    }
  }

  /* Rendery całe, bez przycinania; multiply: białe tło renderu przyjmuje szary kolor karty. */
  .gallery__slide :global(.gallery__image) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Produkt środkuje się nad paskiem strzałek i kropek, nie na całej karcie (pasek zabierał dół). */
  .gallery__slide:not(.gallery__slide--fill) :global(.gallery__image) {
    box-sizing: border-box;
    padding-bottom: 4.5rem;
  }

  .gallery__slide--fill :global(.gallery__image) {
    object-fit: cover;
  }

  /* ---------- Strzałki i kropki (jak u Apple) ---------- */
  .gallery__controls {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    translate: -50% 0;
  }

  .gallery__arrow {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-text) 10%, var(--color-surface));
    color: var(--color-text);
    cursor: pointer;
  }

  .gallery__arrow:disabled {
    color: var(--color-line);
    cursor: default;
  }

  .gallery__chevron {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }

  .gallery__chevron--right {
    translate: -70% -50%;
    rotate: 45deg;
  }

  .gallery__chevron--left {
    translate: -30% -50%;
    rotate: -135deg;
  }

  .gallery__dots {
    display: flex;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    border-radius: 980px;
    background: color-mix(in srgb, var(--color-text) 10%, var(--color-surface));
  }

  .gallery__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-text-2);
    opacity: 0.5;
    cursor: pointer;
  }

  .gallery__dot[aria-current] {
    background: var(--color-text);
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gallery__track {
      scroll-behavior: smooth;
    }

    .gallery__dot,
    .gallery__arrow {
      transition:
        opacity 200ms var(--ease-out),
        background-color 200ms var(--ease-out),
        color 200ms var(--ease-out);
    }
  }

  @media (hover: hover) {
    .gallery__arrow:not(:disabled):hover {
      background: color-mix(in srgb, var(--color-text) 16%, var(--color-surface));
    }
  }
</style>
