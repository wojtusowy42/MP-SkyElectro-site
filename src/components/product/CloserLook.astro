---
/**
 * "Przyjrzyj się bliżej" (wzór: "Take a closer look" na apple.com).
 * Produkt obracany o 360°: sekwencja klatek z Blendera rysowana na canvasie.
 *
 * Dlaczego klatki, a nie 3D w przeglądarce: jakość renderu z Cycles, zero bibliotek,
 * a koszt to tylko waga klatek, które ładują się dopiero, gdy sekcja się zbliża.
 *
 * Płynność: pozycja obrotu jest ułamkowa, a canvas przenika dwie sąsiednie klatki
 * proporcjonalnie (np. 40% między klatką 12 i 13), więc ruch jest ciągły mimo kroku 3°.
 * Rysowanie najwyżej raz na klatkę ekranu (requestAnimationFrame).
 *
 * Obsługa:
 *  - przeciąganie myszą / palcem (z bezwładnością); w pionie strona przewija się normalnie,
 *    puszczenie blisko widoku (do 15°) delikatnie dociąga do niego,
 *  - przyciski widoków: produkt obraca się do ujęcia najkrótszą drogą (ease-out),
 *  - klawiatura: scena to suwak (strzałki obracają, Home / End = pierwszy / ostatni widok),
 *  - gdy produkt stoi na widoku, rysują się opisy: kreska od podpisu do elementu.
 *    Desktop: podpisy po bokach. Telefon: numerowane punkty na produkcie i lista pod nim,
 *  - raz, przy pierwszym pokazaniu, krótki obrót do pierwszego widoku (podpowiedź),
 *  - prefers-reduced-motion: bez animacji (przyciski przeskakują, bez bezwładności, opisy od razu),
 *  - bez JS: zwykły obrazek pierwszej klatki.
 *
 * Klatki: public/<frames>/<szerokość>/<numer>.webp, numery od 000. Ładowanie stopniowe:
 * najpierw co 8. klatka, potem co 4., co 2. i reszta.
 */
import { richText } from '../../i18n/rich-text.ts';

export interface CloserLookCallout {
  /** Punkt na klatce, 0-1 od lewego górnego rogu. */
  x: number;
  y: number;
  /** Po której stronie produktu stoi podpis (desktop). */
  side: 'left' | 'right';
  /** Opcjonalnie: klamra pod grupą elementów, od x1 do x2 (na wysokości y). Punkt = środek klamry. */
  span?: [number, number] | undefined;
  /**
   * Obszar w pełnym świetle (reszta produktu przyciemniona): elipsa, wszystko jako ułamek
   * SZEROKOŚCI klatki. Domyślnie okrąg o promieniu 0.08 wokół punktu.
   */
  focus?: { x: number; y: number; rx: number; ry: number } | undefined;
  title: string;
  text: string;
}

export interface CloserLookView {
  id: string;
  label: string;
  /** Numer klatki z tym ujęciem. */
  frame: number;
  callouts: CloserLookCallout[];
}

interface Props {
  heading: string;
  /** Mała etykieta nad nagłówkiem, jak w rozdziałach (StoryChapter). */
  eyebrow?: string | undefined;
  /** Wstęp pod nagłówkiem, z wyróżnieniami *...* (richText). */
  intro?: string | undefined;
  hint: string;
  /** Opis sceny dla czytników ekranu. */
  stageLabel: string;
  /** Tekst wartości suwaka: {deg}, {view}. */
  valueText: string;
  viewsLabel: string;
  views: CloserLookView[];
  /** Ścieżka w public/ bez końcowego ukośnika, np. '/sequence/skytimer-1/obrot'. */
  frames: string;
  count: number;
  /** Szerokości dostępnych zestawów klatek (rosnąco), np. [720, 1130]. */
  widths: number[];
  /** Proporcje klatki (szerokość / wysokość). */
  aspect: number;
}

const {
  heading,
  eyebrow,
  intro,
  hint,
  stageLabel,
  valueText,
  viewsLabel,
  views,
  frames,
  count,
  widths,
  aspect,
} = Astro.props;
const first = views[0]?.frame ?? 0;
const pad = (n: number) => String(n).padStart(3, '0');
const posterSrc = (w: number) => `${frames}/${w}/${pad(first)}.webp`;

// Maska przyciemnienia: każda elipsa to warstwa "czarne wszędzie poza elipsą"; część wspólna
// warstw (mask-composite: intersect) = czarne wszędzie poza wszystkimi elipsami.
const pct = (n: number) => `${+(n * 100).toFixed(2)}%`;
function shadeMask(callouts: CloserLookCallout[]): string {
  return callouts
    .map((c) => {
      const f = c.focus ?? { x: c.x, y: c.y, rx: 0.08, ry: 0.08 };
      // ry podane względem szerokości, a w gradiencie % liczy się od wysokości: × proporcje.
      return `radial-gradient(ellipse ${pct(f.rx)} ${pct(f.ry * aspect)} at ${pct(f.x)} ${pct(f.y)}, transparent 62%, #000 100%)`;
    })
    .join(', ');
}

const config = {
  frames,
  count,
  widths,
  valueText,
  views: views.map(({ id, label, frame }) => ({ id, label, frame })),
};
---

<section
  class="closer"
  aria-labelledby="closer-title"
  data-closer
  data-config={JSON.stringify(config)}
>
  <div class="closer__inner">
    <header class="closer__title" data-reveal>
      {eyebrow && <p class="closer__eyebrow">{eyebrow}</p>}
      <h2 class="closer__heading" id="closer-title">
        {heading}
      </h2>
      {intro && <p class="closer__intro" set:html={richText(intro)} />}
    </header>

    <div class="closer__wrap" data-wrap>
      <div
        class="closer__stage"
        style={`--aspect: ${aspect}`}
        role="slider"
        tabindex="0"
        aria-label={stageLabel}
        aria-valuemin="0"
        aria-valuemax="359"
        aria-valuenow="0"
        data-stage
      >
        <img
          class="closer__poster"
          src={posterSrc(widths.at(-1) ?? 1130)}
          srcset={widths.map((w) => `${posterSrc(w)} ${w}w`).join(', ')}
          sizes="(max-width: 899px) 100vw, 760px"
          alt=""
          loading="lazy"
          decoding="async"
          draggable="false"
        />
        <canvas class="closer__canvas" aria-hidden="true" data-canvas></canvas>

        {/* Reflektor: przyciemnienie z wycięciami na opisywane elementy (maska CSS, bez JS) */}
        {views.map((v) => (
          <span
            class="closer__shade"
            style={`--mask: ${shadeMask(v.callouts)}`}
            data-shade={v.id}
            aria-hidden="true"
          />
        ))}

        {/* Klamry pod grupami elementów (np. przełączniki 1-4) */}
        {views.map((v) =>
          v.callouts.map(
            (c, i) =>
              c.span && (
                <span
                  class="closer__bracket"
                  style={`left: ${c.span[0] * 100}%; width: ${(c.span[1] - c.span[0]) * 100}%; top: ${c.y * 100}%; --i: ${i}`}
                  data-bracket={v.id}
                  aria-hidden="true"
                />
              ),
          ),
        )}

        {/* Punkty na produkcie (na telefonie z numerem) */}
        {views.map((v) =>
          v.callouts.map((c, i) => (
            <span
              class="closer__dot"
              style={`left: ${c.x * 100}%; top: ${c.y * 100}%; --i: ${i}`}
              data-dot={v.id}
              aria-hidden="true"
            >
              <span class="closer__dot-num">{i + 1}</span>
            </span>
          )),
        )}
      </div>

      {/* Kreski od podpisu do punktu (desktop). Ścieżki liczone w JS względem warstwy. */}
      <svg class="closer__lines" aria-hidden="true" data-lines>
        {views.map((v) =>
          v.callouts.map((_, i) => (
            <path data-line={v.id} data-index={i} pathLength="1" style={`--i: ${i}`} />
          )),
        )}
      </svg>

      {/* Podpisy: desktop po bokach (pozycje z JS), telefon lista pod produktem */}
      {views.map((v) => (
        <ol class="closer__labels" data-labels={v.id}>
          {v.callouts.map((c, i) => (
            <li
              class:list={['closer__label', `closer__label--${c.side}`]}
              style={`--i: ${i}`}
              data-side={c.side}
              data-x={c.x}
              data-y={c.y}
            >
              <span class="closer__label-num" aria-hidden="true">
                {i + 1}
              </span>
              <span class="closer__label-body">
                <strong class="closer__label-title">{c.title}</strong>
                <span class="closer__label-text">{c.text}</span>
              </span>
            </li>
          ))}
        </ol>
      ))}
    </div>

    <p class="closer__hint" data-hint>
      <svg viewBox="0 0 24 12" aria-hidden="true" width="24" height="12">
        <path
          d="M5 1 1 6l4 5M19 1l4 5-4 5M1 6h22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
      {hint}
    </p>

    <div class="closer__controls">
      <div class="closer__views" role="group" aria-label={viewsLabel}>
        {views.map((v, i) => (
          <button
            type="button"
            class="closer__view"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-view={v.id}
          >
            {v.label}
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  interface View {
    id: string;
    label: string;
    frame: number;
  }
  interface Config {
    frames: string;
    count: number;
    widths: number[];
    valueText: string;
    views: View[];
  }

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = matchMedia('(min-width: 900px)');
  const pad = (n: number) => String(n).padStart(3, '0');
  const mod = (n: number, m: number) => ((n % m) + m) % m;
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

  for (const root of document.querySelectorAll<HTMLElement>('[data-closer]')) {
    const cfg = JSON.parse(root.dataset.config ?? '{}') as Config;
    const wrap = root.querySelector<HTMLElement>('[data-wrap]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const linesSvg = root.querySelector<SVGSVGElement>('[data-lines]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const N = cfg.count;

    // ---------- Stan ----------
    let pos = cfg.views[0]?.frame ?? 0; // pozycja w klatkach (ułamkowa)
    let anim: number | null = null; // animacja obrotu / bezwładności
    let raf: number | null = null; // zaplanowane rysowanie
    const images: (HTMLImageElement | null)[] = new Array(N).fill(null);
    let started = false;
    let shownView = ''; // widok, którego opisy są teraz pokazane

    // ---------- Ładowanie klatek ----------
    // Najmniejszy zestaw, który pokryje scenę; do 15% powiększenia jest niewidoczne
    // (np. iPhone: scena 393 px × 2 = 786 px, wystarcza zestaw 720 px).
    function pickWidth(): number {
      const need = stage.clientWidth * Math.min(devicePixelRatio || 1, 2);
      return cfg.widths.find((w) => w * 1.15 >= need) ?? cfg.widths[cfg.widths.length - 1]!;
    }

    function load() {
      if (started) return;
      started = true;
      const w = pickWidth();
      const order: number[] = [];
      for (const step of [8, 4, 2, 1]) {
        for (let i = 0; i < N; i += step) if (!order.includes(i)) order.push(i);
      }
      let next = 0;
      const worker = async () => {
        while (next < order.length) {
          const i = order[next++]!;
          const img = new Image();
          img.src = `${cfg.frames}/${w}/${pad(i)}.webp`;
          try {
            await img.decode();
            images[i] = img;
            requestRender();
          } catch {
            /* brak klatki: zostaje najbliższa wczytana */
          }
        }
      };
      for (let k = 0; k < 4; k++) void worker(); // 4 równoległe pobrania
    }

    function nearestLoaded(i: number): number {
      for (let d = 0; d <= N / 2; d++) {
        if (images[mod(i + d, N)]) return mod(i + d, N);
        if (images[mod(i - d, N)]) return mod(i - d, N);
      }
      return -1;
    }

    // ---------- Rysowanie ----------
    function sizeCanvas() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const w = Math.round(stage.clientWidth * dpr);
      const h = Math.round(stage.clientHeight * dpr);
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
      }
    }

    function requestRender() {
      if (raf === null) raf = requestAnimationFrame(draw);
    }

    function draw() {
      raf = null;
      const base = Math.floor(pos);
      const t = pos - base;
      const a = mod(base, N);
      const b = mod(base + 1, N);
      // Obie sąsiednie klatki wczytane: przenikanie. Inaczej najbliższa wczytana.
      const exactA = images[a];
      const exactB = images[b];
      const fallback = nearestLoaded(mod(Math.round(pos), N));
      if (fallback < 0) return;
      sizeCanvas();
      ctx.imageSmoothingQuality = 'high';
      if (exactA && exactB) {
        ctx.globalAlpha = 1;
        ctx.drawImage(exactA, 0, 0, canvas.width, canvas.height);
        if (t > 0.01) {
          ctx.globalAlpha = t;
          ctx.drawImage(exactB, 0, 0, canvas.width, canvas.height);
          ctx.globalAlpha = 1;
        }
      } else {
        ctx.globalAlpha = 1;
        ctx.drawImage(images[fallback]!, 0, 0, canvas.width, canvas.height);
      }
      root.classList.add('is-ready');
      updateUi();
    }

    // Najbliższy widok i odległość do niego (w klatkach).
    function nearestView(p = pos): { view: View; dist: number; delta: number } {
      let view = cfg.views[0]!;
      let best = Infinity;
      let bestDelta = 0;
      for (const v of cfg.views) {
        let d = mod(v.frame - p, N);
        if (d > N / 2) d -= N;
        if (Math.abs(d) < best) [best, view, bestDelta] = [Math.abs(d), v, d];
      }
      return { view, dist: best, delta: bestDelta };
    }

    let pressedView = '';
    function updateUi() {
      const f = mod(Math.round(pos), N);
      const deg = Math.round((f / N) * 360) % 360;
      const { view, dist } = nearestView();
      stage.setAttribute('aria-valuenow', String(deg));
      stage.setAttribute(
        'aria-valuetext',
        cfg.valueText.replace('{deg}', String(deg)).replace('{view}', view.label),
      );
      const exact = dist < 0.5 ? view.id : '';
      if (exact === pressedView) return;
      pressedView = exact;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.view === exact));
    }

    // ---------- Opisy (kreski + podpisy) ----------
    const calloutParts = (id?: string) =>
      root.querySelectorAll<Element>(
        id
          ? `[data-shade="${id}"], [data-dot="${id}"], [data-bracket="${id}"], [data-line="${id}"], [data-labels="${id}"]`
          : '[data-shade], [data-dot], [data-bracket], [data-line], [data-labels]',
      );

    function hideCallouts() {
      if (!shownView) return;
      shownView = '';
      for (const el of calloutParts()) el.classList.remove('is-on');
    }

    function showCallouts(id: string) {
      layoutCallouts(id);
      shownView = id;
      // Klasa w następnej klatce, żeby przejście CSS ruszyło od stanu ukrytego.
      requestAnimationFrame(() => {
        if (shownView !== id) return;
        for (const el of calloutParts(id)) el.classList.add('is-on');
      });
    }

    // Desktop: podpisy po bokach produktu, na wysokości swojego punktu (rozsunięte, gdy
    // nachodzą na siebie), kreska: poziomo od podpisu, potem prosto do punktu.
    function layoutCallouts(id: string) {
      if (!desktop.matches) return;
      const wr = wrap.getBoundingClientRect();
      const sr = stage.getBoundingClientRect();
      linesSvg.setAttribute('viewBox', `0 0 ${wr.width} ${wr.height}`);
      const list = root.querySelector<HTMLElement>(`[data-labels="${id}"]`);
      if (!list) return;
      const items = [...list.querySelectorAll<HTMLElement>('.closer__label')];
      const gap = 20; // odstęp podpisu od krawędzi produktu
      for (const side of ['left', 'right'] as const) {
        const group = items
          .filter((el) => el.dataset.side === side)
          .map((el) => ({ el, ay: sr.top - wr.top + Number(el.dataset.y) * sr.height }))
          .sort((p, q) => p.ay - q.ay);
        let lastBottom = -Infinity;
        for (const g of group) {
          const h = g.el.offsetHeight;
          let top = Math.max(g.ay - h / 2, lastBottom + 16);
          top = Math.min(top, wr.height - h);
          g.el.style.top = `${top}px`;
          if (side === 'left') {
            g.el.style.right = `${wr.right - sr.left + gap}px`;
            g.el.style.left = 'auto';
          } else {
            g.el.style.left = `${sr.right - wr.left + gap}px`;
            g.el.style.right = 'auto';
          }
          lastBottom = top + h;
        }
      }
      // Ścieżki
      items.forEach((el, i) => {
        const path = linesSvg.querySelector<SVGPathElement>(
          `[data-line="${id}"][data-index="${i}"]`,
        );
        if (!path) return;
        const er = el.getBoundingClientRect();
        const ax = sr.left - wr.left + Number(el.dataset.x) * sr.width;
        const ay = sr.top - wr.top + Number(el.dataset.y) * sr.height;
        const ly = er.top - wr.top + 14; // na wysokości tytułu
        const left = el.dataset.side === 'left';
        const lx = left ? er.right - wr.left + 12 : er.left - wr.left - 12;
        // Łamanie: poziomo do krawędzi produktu, dalej prosto do punktu.
        const ex = left ? sr.left - wr.left + 6 : sr.right - wr.left - 6;
        const bend = (left && ex < ax) || (!left && ex > ax) ? ex : (lx + ax) / 2;
        path.setAttribute('d', `M${lx} ${ly} H${bend} L${ax} ${ay}`);
      });
    }

    function stop() {
      if (anim !== null) cancelAnimationFrame(anim);
      anim = null;
    }

    // Po zatrzymaniu: na widoku pokaż opisy.
    function settled() {
      const { view, dist } = nearestView();
      if (dist < 0.5) {
        pos = Math.round(pos);
        requestRender();
        showCallouts(view.id);
      }
    }

    // Obrót do klatki najkrótszą drogą, ease-out. Czas rośnie z odległością.
    function rotateTo(target: number, minMs = 0) {
      stop();
      hideCallouts();
      let delta = mod(target - pos, N);
      if (delta > N / 2) delta -= N;
      if (reduce || Math.abs(delta) < 0.05) {
        pos = target;
        requestRender();
        settled();
        return;
      }
      const from = pos;
      const ms = Math.max(minMs, 450 + (Math.abs(delta) / (N / 2)) * 750);
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - t0) / ms);
        pos = from + delta * easeOut(t);
        draw();
        if (t < 1) anim = requestAnimationFrame(tick);
        else {
          anim = null;
          settled();
        }
      };
      anim = requestAnimationFrame(tick);
    }

    // Po puszczeniu: blisko widoku (do 15°) dociągnij do niego, inaczej zostań.
    function snapOrSettle() {
      const { view, dist } = nearestView();
      if (dist > 0.05 && dist <= N / 24) rotateTo(view.frame);
      else settled();
    }

    // ---------- Przeciąganie z bezwładnością ----------
    let dragging = false;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0; // klatki / ms
    const framesPerPx = () => N / Math.max(stage.clientWidth * 1.1, 1); // ~szerokość sceny = pełny obrót

    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      stop();
      hideCallouts();
      dragging = true;
      lastX = e.clientX;
      lastT = e.timeStamp;
      velocity = 0;
      stage.setPointerCapture(e.pointerId);
      stage.classList.add('is-dragging');
      hideHint();
    });

    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      const dt = Math.max(e.timeStamp - lastT, 1);
      // Przeciągnięcie w prawo obraca produkt w prawo (klatki maleją).
      const df = -dx * framesPerPx();
      pos += df;
      velocity = 0.8 * (df / dt) + 0.2 * velocity;
      lastX = e.clientX;
      lastT = e.timeStamp;
      requestRender();
    });

    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      stage.classList.remove('is-dragging');
      if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
      // Puszczenie po chwili bez ruchu = bez bezwładności.
      if (reduce || e.timeStamp - lastT > 80 || Math.abs(velocity) < 0.002) {
        snapOrSettle();
        return;
      }
      let v = velocity;
      let prev = performance.now();
      const tick = (now: number) => {
        const dt = now - prev;
        prev = now;
        pos += v * dt;
        v *= Math.pow(0.994, dt); // tarcie
        draw();
        if (Math.abs(v) > 0.0015) anim = requestAnimationFrame(tick);
        else {
          anim = null;
          snapOrSettle();
        }
      };
      anim = requestAnimationFrame(tick);
    };
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);

    // ---------- Klawiatura (suwak) ----------
    stage.addEventListener('keydown', (e) => {
      const step = N / 30; // 12°
      const keys: Record<string, () => void> = {
        ArrowLeft: () => rotateTo(Math.round(pos + step)),
        ArrowDown: () => rotateTo(Math.round(pos + step)),
        ArrowRight: () => rotateTo(Math.round(pos - step)),
        ArrowUp: () => rotateTo(Math.round(pos - step)),
        Home: () => rotateTo(cfg.views[0]?.frame ?? 0),
        End: () => rotateTo(cfg.views[cfg.views.length - 1]?.frame ?? 0),
      };
      const fn = keys[e.key];
      if (!fn) return;
      e.preventDefault();
      hideHint();
      fn();
    });

    // ---------- Przyciski widoków ----------
    for (const b of buttons) {
      b.addEventListener('click', () => {
        const v = cfg.views.find((x) => x.id === b.dataset.view);
        if (!v) return;
        hideHint();
        rotateTo(v.frame);
      });
    }

    function hideHint() {
      hint.classList.add('is-hidden');
    }

    // ---------- Start: ładowanie, gdy sekcja się zbliża; podpowiedź przy pierwszym pokazaniu ----------
    let hinted = false;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          load();
          if (e.intersectionRatio >= 0.5 && !hinted) {
            hinted = true;
            const home = cfg.views[0]?.frame ?? 0;
            if (reduce) {
              settled();
            } else {
              pos = home + N / 8; // start 45° obok, obrót do pierwszego widoku
              requestRender();
              setTimeout(() => rotateTo(home, 1500), 150);
            }
          }
        }
      },
      { rootMargin: '600px 0px', threshold: [0, 0.5] },
    );
    io.observe(stage);

    new ResizeObserver(() => {
      requestRender();
      if (shownView) layoutCallouts(shownView);
    }).observe(wrap);
  }
</script>

