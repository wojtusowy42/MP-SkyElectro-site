---
/**
 * "Liczby mówią same za siebie." (wzór: liczby wyświetlacza na stronie MacBooka Pro z PROLED XDR).
 * Siatka: mała etykieta nad liczbą, duża liczba, krótki podpis pod nią. Wszystko na środku.
 * Liczby białe; kolor produktu zostaje dla jednej, głównej liczby rozdziału (nie tutaj).
 */
export interface Stat {
  label?: string | undefined;
  value: string;
  caption?: string | undefined;
}

interface Props {
  heading?: string | undefined;
  stats: Stat[];
  /** box: liczby w obramowanej ramce (wzór: liczby baterii na apple.com). */
  variant?: 'plain' | 'box';
}

const { heading, stats, variant = 'plain' } = Astro.props;
---

<div class:list={['stats', `stats--${variant}`]} data-reveal>
  {heading && <h3 class="stats__heading">{heading}</h3>}
  <dl class="stats__grid">
    {stats.map((s) => (
      <div class="stats__item">
        <dt class="stats__label">
          {s.label && <span class="stats__eyebrow">{s.label}</span>}
          {s.caption && <span class="stats__caption">{s.caption}</span>}
        </dt>
        <dd class="stats__value">{s.value}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .stats {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .stats--box .stats__grid {
    padding: clamp(2.5rem, 1.5rem + 3vw, 4rem) clamp(1.5rem, 1rem + 2vw, 3rem);
    border-radius: 1.75rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }

  .stats__heading {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) 1.5rem;
    margin: 0;
  }

  /* Kolejność wizualna: etykieta, liczba, podpis. W kodzie dt (etykieta + podpis) przed dd,
     więc czytnik czyta "Krok czasu flop, ... : 0,2 s". Podpis przenosi się pod liczbę gridem. */
  .stats__item {
    display: grid;
    grid-template-areas: 'eyebrow' 'value' 'caption';
    justify-items: center;
    align-content: start;
  }

  .stats__label {
    display: contents;
  }

  .stats__eyebrow {
    grid-area: eyebrow;
    margin-bottom: 0.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .stats__value {
    grid-area: value;
    margin: 0;
    font-size: clamp(2.25rem, 1.6rem + 2.1vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .stats__caption {
    grid-area: caption;
    max-width: 16rem;
    margin-top: 0.375rem;
    color: var(--color-text-2-on-dark);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  @media (max-width: 734px) {
    .stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 1rem;
    }

    /* Ramka z trzema liczbami: jedna kolumna (2 + 1 wyglądałoby na brak). */
    .stats--box .stats__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .stats__value {
      font-size: clamp(1.75rem, 1rem + 3.4vw, 2.25rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .stats:not(:global(.is-in)) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .stats {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }
  }
</style>
