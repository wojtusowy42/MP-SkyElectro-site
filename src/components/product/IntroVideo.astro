---
/**
 * Animacja otwierająca stronę produktu (wzór: wejście na stronę nowego produktu na apple.com).
 *
 * Wideo odtwarza się samo, RAZ, bez dźwięku, i zatrzymuje się na ostatniej klatce.
 * Po zakończeniu pojawia się nazwa produktu w pustej górnej części kadru.
 *
 * - Zanim wideo się wczyta, widać ostatnią klatkę (poster), więc ekran nigdy nie jest pusty.
 * - Przy włączonym "ograniczeniu ruchu" w systemie wideo się nie odtwarza: od razu ostatnia
 *   klatka i nazwa.
 * - AV1 (WebM) dla przeglądarek, które go obsługują (mniejszy plik), H.264 (MP4) dla reszty.
 *   Na wąskich ekranach mniejsza wersja (1280 px).
 *
 * Pliki wideo: public/video/<produkt>/ (nie przechodzą przez Astro, są już skompresowane).

 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  tagline?: string | undefined;
  /** Ścieżki do plików w public/, bez rozszerzenia, np. '/video/skytimer-1/zlozenie'. */
  video: string;
  /** Ostatnia klatka animacji (pokazywana przed wczytaniem i po zakończeniu). */
  poster: ImageMetadata;
  /** Opis tego, co dzieje się na animacji (dla czytników ekranu). */
  description: string;
}

const { title, tagline, video, poster, description } = Astro.props;
const posterImage = await getImage({ src: poster, format: 'webp', width: 1920, quality: 85 });
---

<section class="intro" data-intro>
  <video
    class="intro__video"
    muted
    playsinline
    preload="auto"
    poster={posterImage.src}
    aria-label={description}
    data-intro-video
  >
    <source
      src={`${video}-1280.webm`}
      type='video/webm; codecs="av01.0.05M.08"'
      media="(max-width: 900px)"
    />
    <source src={`${video}-1280.mp4`} type="video/mp4" media="(max-width: 900px)" />
    <source src={`${video}-1920.webm`} type='video/webm; codecs="av01.0.08M.08"' />
    <source src={`${video}-1920.mp4`} type="video/mp4" />
  </video>

  <div class="intro__copy">
    <h1 class="intro__title">{title}</h1>
    {tagline && <p class="intro__tagline">{tagline}</p>}
  </div>
</section>

<script>
  for (const intro of document.querySelectorAll<HTMLElement>('[data-intro]')) {
    const video = intro.querySelector<HTMLVideoElement>('[data-intro-video]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const done = () => intro.classList.add('is-done');

    if (!video || reduce) {
      done();
      continue;
    }

    intro.classList.add('is-playing');
    video.addEventListener('ended', done, { once: true });
    video.addEventListener('error', done, { once: true });
    // Autoplay może być zablokowany (np. tryb oszczędzania energii): wtedy zostaje poster.
    video.play().catch(done);
  }
</script>

<style>
  /*
   * ROZSTAWIENIE (desktop)
   * Sekcja ma wysokość ekranu pod paskiem menu. Wideo jest ustawione tak, żeby ŚRODEK
   * płytki wypadał na 56% wysokości sekcji (trochę poniżej środka, jak u Apple: optycznie
   * środek kompozycji "tytuł + produkt"). Nazwa stoi nad płytką z odstępem --gap-title.
   * Dół wideo jest czarny, więc jego ucięcie niczego nie zabiera.
   *
   * Liczby z kadru animacji (ostatnia klatka, ułamki wysokości wideo):
   *   --subject-center: środek płytki, --subject-top: górna krawędź płytki.
   * Nowa animacja z innym kadrem = zmiana tylko tych dwóch liczb.
   */
  .intro {
    --section-h: max(32rem, calc(100svh - var(--nav-h) - var(--story-local-nav, 0px)));
    --subject-center: 0.464;
    --subject-top: 0.28;
    --subject-bottom: 0.655; /* dolna krawędź płytki (z odbiciem) */
    --target: 0.56;
    --gap-title: clamp(1.5rem, 4vh, 3rem);
    --gap-bottom: clamp(3rem, 9vh, 6rem);

    position: relative;
    /*
     * Rozstawienie liczone jak dla pełnego ekranu (--section-h), ale sekcja kończy się
     * --gap-bottom pod płytką: bez pustej czerni przed kolejną sceną.
     * (100vw zamiast cqw: sekcja jest swoim własnym kontenerem, więc cqw liczy się od rodzica.)
     */
    height: min(
      var(--section-h),
      calc(
        var(--section-h) * var(--target) + min(100vw, 120rem) * 0.5625 *
          (var(--subject-bottom) - var(--subject-center)) + var(--gap-bottom)
      )
    );
    overflow: hidden;
    container-type: inline-size;
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
  }

  .intro__video {
    --video-w: min(100cqw, 120rem);
    --video-h: calc(var(--video-w) * 0.5625);
    --video-top: calc(var(--section-h) * var(--target) - var(--video-h) * var(--subject-center));

    position: absolute;
    top: var(--video-top);
    left: 50%;
    display: block;
    width: var(--video-w);
    height: var(--video-h);
    translate: -50% 0;
  }

  /* Nazwa nad płytką: dół bloku tekstu = górna krawędź płytki minus odstęp. */
  .intro__copy {
    --video-w: min(100cqw, 120rem);
    --video-h: calc(var(--video-w) * 0.5625);
    --video-top: calc(var(--section-h) * var(--target) - var(--video-h) * var(--subject-center));

    position: absolute;
    right: 0;
    bottom: calc(
      var(--section-h) - (var(--video-top) + var(--video-h) * var(--subject-top)) + var(--gap-title)
    );
    left: 0;
    z-index: 1;
    padding-inline: 1.5rem;
    text-align: center;
  }

  .intro__title {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .intro__tagline {
    margin-top: 0.75rem;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.0625rem, 0.9rem + 0.6vw, 1.5rem);
    letter-spacing: -0.012em;
  }

  /*
   * ROZSTAWIENIE (telefon)
   * Kadr 16:9 jest za niski, więc: napis, pod nim wideo przycięte z boków do 4:3
   * (płytka większa), całość wyśrodkowana w pionie na ekranie.
   */
  @media (max-width: 734px) {
    .intro {
      display: flex;
      flex-direction: column-reverse;
      justify-content: center;
      gap: 1rem;
      height: auto;
      padding-block: clamp(3rem, 10vh, 5rem) clamp(1.5rem, 5vh, 2.5rem);
    }

    .intro__video {
      position: static;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      translate: none;
    }

    .intro__copy {
      position: static;
    }
  }

  /* Podczas animacji napis jest ukryty, pojawia się po jej zakończeniu. */
  .intro.is-playing:not(.is-done) .intro__copy {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro__copy {
      transition:
        opacity 900ms var(--ease-out),
        transform 900ms var(--ease-out);
    }
  }
</style>
