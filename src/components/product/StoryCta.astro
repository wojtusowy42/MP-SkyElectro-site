---
/**
 * Zakończenie strony "Dowiedz się więcej": render, hasło, przejście do strony Kup.
 * Bez cen: ceny i konfigurator są tylko na stronie Kup.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  heading: string;
  text: string;
  image: ImageMetadata;
  alt: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
}

const { heading, text, image, alt, primaryLabel, primaryHref, secondaryLabel, secondaryHref } =
  Astro.props;
---

<section class="cta" data-reveal>
  <Picture
    class="cta__img"
    src={image}
    alt={alt}
    widths={[600, 900, 1200]}
    sizes="(max-width: 734px) 80vw, 480px"
    formats={['avif', 'webp']}
    quality={80}
    loading="lazy"
  />
  <h2 class="cta__heading">{heading}</h2>
  <p class="cta__text">{text}</p>
  <div class="cta__actions">
    <a class="cta__button cta__button--primary" href={primaryHref}>
      {primaryLabel}
    </a>
    <a class="cta__button" href={secondaryHref}>
      {secondaryLabel}
    </a>
  </div>
</section>

<style>
  .cta {
    padding: clamp(6rem, 13vw, 11rem) var(--gutter) 0;
    text-align: center;
  }

  .cta :global(.cta__img) {
    width: min(100%, 30rem);
    height: auto;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
  }

  .cta__heading {
    font-size: clamp(2.75rem, 1.6rem + 4.6vw, 5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .cta__text {
    margin-top: 1rem;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.3125rem);
    font-weight: 600;
    text-wrap: balance;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .cta__button {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: 1.375rem;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-line-on-dark);
    text-decoration: none;
  }

  .cta__button--primary {
    background: var(--color-text-on-dark);
    box-shadow: none;
    color: var(--color-bg-dark);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .cta:not(:global(.is-in)) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .cta {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }
  }
</style>
