---
/**
 * ChipReveal: mikrokontroler w obudowie TQFP-32 (jak ATmega328P na płytce SkyTimera)
 * pokazany w stylu chipów na apple.com. Wypełnia rodzica (kafelek w siatce wyróżników).
 *
 * Wygląd: grafitowa obudowa z kropką pinu 1, po 8 nóżek z każdej strony, cienka krawędź
 * w kolorach produktu, pod spodem poświata, duży napis.
 *
 * Sekwencja (raz, gdy chip wejdzie w kadr):
 *   1. obudowa opada z lekkim przechyleniem 3D,
 *   2. światło biegnie po nóżkach dookoła obudowy (od pinu 1, przeciwnie do wskazówek zegara,
 *      jak numeracja pinów w TQFP),
 *   3. błysk obiega krawędź obudowy i zostaje delikatna krawędź w kolorach produktu,
 *   4. odsłania się napis.
 * Bez pętli. prefers-reduced-motion i brak JS: od razu stan końcowy.
 * Kolory domyślnie z gradientu SkyTimera 1 (#FFB08A → #F0142F), patrz decyzje sekcja 13.
 */
interface Props {
  name?: string;
  model?: string;
  c1?: string | undefined;
  c2?: string | undefined;
}
const { name = 'ATmega', model = '328P', c1 = '#FFB08A', c2 = '#F0142F' } = Astro.props;

// Nóżki: 8 na bok. Kolejność jak numeracja TQFP: od pinu 1 (lewy górny róg) w dół lewej
// krawędzi, dół, prawa w górę, góra w lewo. --n = numer w sekwencji światła.
const PER_SIDE = 8;
const sides = ['left', 'bottom', 'right', 'top'] as const;
const pins = sides.flatMap((side, s) =>
  Array.from({ length: PER_SIDE }, (_, i) => ({
    side,
    // pozycja wzdłuż boku: lewy i dolny bok rosnąco, prawy i górny malejąco (obieg dookoła)
    pos: s < 2 ? i : PER_SIDE - 1 - i,
    n: s * PER_SIDE + i,
  })),
);
---

<div
  class="chip-wrap"
  style={`--c1:${c1};--c2:${c2}`}
  data-chip
  role="img"
  aria-label={`${name}${model}`}
>
  <div class="chip">
    <div class="chip__glow"></div>
    {pins.map((p) => (
      <span
        class:list={['chip__pin', `chip__pin--${p.side}`]}
        style={`--pos: ${p.pos}; --n: ${p.n}`}
      />
    ))}
    <div class="chip__body">
      <span class="chip__dot"></span>
      <div class="chip__label" aria-hidden="true">
        <span class="chip__name">{name}</span>
        <span class="chip__model">{model}</span>
      </div>
      <div class="chip__ring"></div>
    </div>
  </div>
</div>

<script>
  document.documentElement.classList.add('chip-js');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-chip]').forEach((el) => {
    if (reduce || !('IntersectionObserver' in window)) {
      el.classList.add('is-in');
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            el.classList.add('is-in');
            io.disconnect();
          }
        }
      },
      { threshold: 0.5 },
    );
    io.observe(el);
  });
</script>

<!-- @property musi być globalne. -->
<style is:global>
  @property --chip-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @property --chip-reveal {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 130%;
  }
</style>

<style>
  .chip-wrap {
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    /* Wymiary w cqi: liczą się od szerokości chipa, a nie okna. */
    --body: 62cqi; /* bok obudowy */
    --pin-len: 9cqi;
    --pin-w: 2.4cqi;
    --pin-span: 50cqi; /* odcinek boku zajęty przez 8 nóżek */
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    perspective: 900px;
  }

  .chip {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  /* Poświata pod obudową w kolorach produktu. */
  .chip__glow {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--c2) 85%, transparent) 0%,
      color-mix(in oklab, var(--c1) 40%, transparent) 42%,
      transparent 70%
    );
    filter: blur(20px);
    opacity: 0.75;
  }

  /* ---------- Nóżki ---------- */
  .chip__pin {
    --step: calc(var(--pin-span) / 7);
    --start: calc(50cqi - var(--pin-span) / 2);
    position: absolute;
    border-radius: 0.4cqi;
    background: linear-gradient(
      var(--pin-dir, 90deg),
      #6e6e74 0%,
      #d8d8de 45%,
      #f4f4f7 55%,
      #8e8e95 100%
    );
    box-shadow: 0 0 0 0.15cqi rgb(0 0 0 / 0.5);
  }

  .chip__pin--left,
  .chip__pin--right {
    --pin-dir: 180deg;
    top: calc(var(--start) + var(--pos) * var(--step) - var(--pin-w) / 2);
    width: var(--pin-len);
    height: var(--pin-w);
  }

  .chip__pin--left {
    left: calc(50cqi - var(--body) / 2 - var(--pin-len) + 1cqi);
  }

  .chip__pin--right {
    right: calc(50cqi - var(--body) / 2 - var(--pin-len) + 1cqi);
  }

  .chip__pin--top,
  .chip__pin--bottom {
    left: calc(var(--start) + var(--pos) * var(--step) - var(--pin-w) / 2);
    width: var(--pin-w);
    height: var(--pin-len);
  }

  .chip__pin--top {
    top: calc(50cqi - var(--body) / 2 - var(--pin-len) + 1cqi);
  }

  .chip__pin--bottom {
    bottom: calc(50cqi - var(--body) / 2 - var(--pin-len) + 1cqi);
  }

  /* ---------- Obudowa ---------- */
  .chip__body {
    position: absolute;
    top: calc(50cqi - var(--body) / 2);
    left: calc(50cqi - var(--body) / 2);
    width: var(--body);
    height: var(--body);
    overflow: hidden;
    border-radius: 3.5cqi;
    background:
      radial-gradient(120% 90% at 18% 0%, rgb(255 255 255 / 0.1), transparent 45%),
      linear-gradient(150deg, #2b2b30 0%, #151517 48%, #0b0b0c 100%);
    box-shadow:
      inset 0 0 0 0.25cqi rgb(255 255 255 / 0.07),
      inset 0 -1.2cqi 2.5cqi rgb(0 0 0 / 0.6),
      0 2cqi 5cqi rgb(0 0 0 / 0.7);
  }

  /* Kropka pinu 1 (wgłębienie w obudowie, jak w prawdziwym TQFP). */
  .chip__dot {
    position: absolute;
    top: 5cqi;
    left: 5cqi;
    width: 3.2cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #070708;
    box-shadow:
      inset 0 0.3cqi 0.5cqi rgb(0 0 0 / 0.9),
      0 0.15cqi 0 rgb(255 255 255 / 0.08);
  }

  /*
   * Krawędź w kolorach produktu: stała, delikatna (sam .chip__ring) + błysk, który obiega
   * krawędź raz i gaśnie (::after, --chip-angle). Obie warstwy to pierścień: maska wycina środek.
   */
  .chip__ring,
  .chip__ring::after {
    position: absolute;
    inset: 0;
    padding: 0.45cqi;
    border-radius: inherit;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }

  .chip__ring {
    padding: 0.55cqi;
    background: linear-gradient(
      135deg,
      var(--c1),
      color-mix(in oklab, var(--c2) 75%, transparent) 50%,
      color-mix(in oklab, var(--c2) 25%, transparent)
    );
  }

  .chip__ring::after {
    content: '';
    padding: 0.6cqi;
    background: conic-gradient(
      from var(--chip-angle),
      transparent 0deg,
      transparent 260deg,
      var(--c2) 315deg,
      var(--c1) 338deg,
      #fff 350deg,
      transparent 360deg
    );
    opacity: 0;
  }

  /* ---------- Napis ---------- */
  .chip__label {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6cqi;
    font-optical-sizing: auto;
    -webkit-mask-image: linear-gradient(
      110deg,
      #000 calc(var(--chip-reveal) - 20%),
      transparent var(--chip-reveal)
    );
    mask-image: linear-gradient(
      110deg,
      #000 calc(var(--chip-reveal) - 20%),
      transparent var(--chip-reveal)
    );
  }

  .chip__name,
  .chip__model {
    line-height: 1;
    background: linear-gradient(180deg, #ffffff 0%, color-mix(in oklab, var(--c1) 30%, #fff) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .chip__name {
    font-size: 12.5cqi;
    font-weight: 600;
    letter-spacing: -0.035em;
    padding-bottom: 0.06em;
  }

  .chip__model {
    font-size: 7.5cqi;
    font-weight: 500;
    letter-spacing: 0.02em;
    opacity: 0.85;
  }

  /* ---------- Stan startowy (tylko z JS i bez ograniczenia ruchu) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.chip-js) .chip-wrap:not(.is-in) .chip {
      opacity: 0;
      transform: translateY(6cqi) rotateX(32deg) rotateZ(-8deg) scale(0.86);
    }

    :global(.chip-js) .chip-wrap:not(.is-in) .chip__glow {
      opacity: 0;
    }

    :global(.chip-js) .chip-wrap:not(.is-in) .chip__pin {
      filter: brightness(0.35);
    }

    :global(.chip-js) .chip-wrap:not(.is-in) .chip__ring {
      opacity: 0;
    }

    :global(.chip-js) .chip-wrap:not(.is-in) .chip__label {
      --chip-reveal: 0%;
    }

    /* 1. Obudowa opada z przechyleniem. */
    .chip-wrap.is-in .chip {
      animation: chip-in 1.3s var(--ease) both;
    }

    .chip-wrap.is-in .chip__glow {
      animation: glow-in 1.6s 0.5s var(--ease) both;
    }

    /* 2. Światło biegnie po nóżkach dookoła (32 nóżki w ok. 0,9 s). */
    .chip-wrap.is-in .chip__pin {
      animation: pin-lit 0.7s calc(0.55s + var(--n) * 28ms) ease-out both;
    }

    /* 3. Delikatna krawędź się pojawia, błysk obiega ją raz i gaśnie. */
    .chip-wrap.is-in .chip__ring {
      animation: ring-in 0.5s 0.7s ease-out both;
    }

    .chip-wrap.is-in .chip__ring::after {
      animation: ring-sweep 1.6s 0.7s cubic-bezier(0.45, 0, 0.2, 1) both;
    }

    /* 4. Napis. */
    .chip-wrap.is-in .chip__label {
      animation: reveal 1.1s 1.2s cubic-bezier(0.45, 0, 0.2, 1) both;
    }
  }

  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(6cqi) rotateX(32deg) rotateZ(-8deg) scale(0.86);
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes glow-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    45% {
      opacity: 1;
    }
    to {
      opacity: 0.75;
      transform: none;
    }
  }

  @keyframes pin-lit {
    0% {
      filter: brightness(0.35);
    }
    35% {
      filter: brightness(1.9) drop-shadow(0 0 1.2cqi var(--c1));
    }
    100% {
      filter: brightness(1);
    }
  }

  @keyframes ring-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Jeden obieg: łuk rozjaśnia się na starcie i gaśnie na końcu. */
  @keyframes ring-sweep {
    0% {
      --chip-angle: 0deg;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      --chip-angle: 360deg;
      opacity: 0;
    }
  }

  @keyframes reveal {
    from {
      --chip-reveal: 0%;
    }
    to {
      --chip-reveal: 130%;
    }
  }
</style>
