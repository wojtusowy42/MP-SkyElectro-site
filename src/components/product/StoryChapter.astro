---
/**
 * Rozdział strony "Dowiedz się więcej" (wzór: rozdziały strony MacBooka Pro z PROLED XDR
 * na apple.com: "Konstrukcja", "Wyświetlacz", "Bateria"...).
 *
 * Nagłówek do lewej: mała szara etykieta (eyebrow) → duży nagłówek → akapit wstępu.
 * Wstęp jak u Apple: półgruby, szary, z białymi frazami (*fraza* w słowniku, patrz richText).
 * Półgruby, a nie zwykły: szary zwykły tekst na czerni optycznie znikał (decyzje, sekcja 13).
 *
 * Pod nagłówkiem slot: obraz, symulator, siatka liczb, kafelki rozdziału.
 * Wejście nagłówka raz, przy pojawieniu się (data-reveal, skrypt w ProductStory).
 */
import { richText } from '../../i18n/rich-text.ts';

interface Props {
  /** Kotwica rozdziału (np. do linków z galerii wyróżników). */
  id: string;
  eyebrow: string;
  heading: string;
  /** Wstęp z wyróżnieniami *...*. */
  intro?: string | undefined;
}

const { id, eyebrow, heading, intro } = Astro.props;
const headingId = `${id}-title`;
---

<section class="chapter" id={id} aria-labelledby={headingId}>
  <header class="chapter__head" data-reveal>
    <p class="chapter__eyebrow">{eyebrow}</p>
    <h2 class="chapter__heading" id={headingId}>
      {heading}
    </h2>
    {intro && <p class="chapter__intro" set:html={richText(intro)} />}
  </header>
  <div class="chapter__body">
    <slot />
  </div>
</section>

<style>
  .chapter {
    padding-top: clamp(5rem, 9vw, 8rem);
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    /* Przewijanie do kotwicy zostawia miejsce na przyklejony pasek produktu. */
    scroll-margin-top: var(--local-nav-height);
  }

  /*
   * Nagłówek jak na apple.com (MacBook Pro): do lewej, nie na środku. Wyśrodkowany akapit
   * na 2-3 linie czytał się źle (każda linia zaczyna się gdzie indziej).
   */
  .chapter__head {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Mała szara etykieta: nie konkuruje z nagłówkiem. */
  .chapter__eyebrow {
    margin-bottom: 0.625rem;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .chapter__heading {
    font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .chapter__intro {
    max-width: 38rem;
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.3125rem);
    font-weight: 600;
    line-height: 1.43;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .chapter__intro :global(strong) {
    color: var(--color-text-on-dark);
    font-weight: inherit;
  }

  .chapter__body {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .chapter__head:not(:global(.is-in)) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .chapter__head {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }
  }
</style>
