---
/**
 * "Poznaj SkyTimer 1": siatka wyróżników (wzór: "Poznaj MacBooka Pro" na apple.com).
 *
 * Druga "scena" strony: ciemnoszare tło na całą szerokość (--color-surface-dark),
 * na nim czarne kafelki. Pierwsza scena (animacja) zostaje czarna.
 *
 * Układ (desktop, siatka 6 kolumn):
 *   1. przełączniki: zdjęcie makro + 3 liczby               pełna szerokość
 *   2. złącze: duży render                                    pełna szerokość
 *   3. energia (duża liczba)  |  chip ATmega328P              1/3 + 2/3
 *   4. zabezpieczenia         |  rozmiar                       1/2 + 1/2
 * Telefon: jedna kolumna. (Ceny i "Zamów": sekcja "Który SkyTimer" na końcu strony.)
 *
 * Zasada jak u Apple: zdjęcie niesie kafelek, tekst to nagłówek i najwyżej jedno zdanie.
 * Rendery: ciemne studio ze sceny animacji (Blender, kolekcja "Kadry strony"),
 * oryginały w Raw Assets/Blender Renders/SkyTimer strona produktu/.
 * Teksty: słownik (products.skytimer-1.story.highlights), fakty z podręcznika użytkownika.
 */
import { Picture } from 'astro:assets';
import type { ImageOutputFormat } from 'astro';
import type { ComponentProps } from 'astro/types';
import HighlightTile from '../HighlightTile.astro';
import ChipReveal from '../ChipReveal.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { getDictionary } from '../../../i18n/index.ts';
import { getProduct } from '../../../data/products/index.ts';
import dipImage from '../../../assets/renders/skytimer-1/poznaj/przelaczniki-makro.png';
import connectorImage from '../../../assets/renders/skytimer-1/poznaj/zlacze.png';
import topImage from '../../../assets/renders/skytimer-1/poznaj/gora.png';
import angleImage from '../../../assets/renders/skytimer-1/poznaj/trzy-czwarte.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const id = 'skytimer-1';
const dict = getDictionary(locale);
const h = dict.products[id].story.highlights;
const product = getProduct(id);
if (!product) throw new Error('Brak produktu skytimer-1 w danych');

const [c1, c2] = product.colors ?? [undefined, undefined];

// Wspólne ustawienia obrazów: AVIF/WebP, jakość wyższa niż domyślna (rendery z drobnymi napisami).
const img = {
  formats: ['avif', 'webp'] satisfies ImageOutputFormat[],
  quality: 80,
  loading: 'lazy',
} as const satisfies Partial<ComponentProps<typeof Picture>>;
---

<section
  class="highlights"
  aria-labelledby="highlights-title"
  style={c1 && c2 ? `--accent-from: ${c1}; --accent-to: ${c2}` : undefined}
>
  <div class="highlights__inner">
    <h2 class="highlights__title" id="highlights-title" data-reveal>
      {h.heading}
    </h2>

    <div class="highlights__grid">
      {/* 1. Przełączniki */}
      <HighlightTile span="full" title={h.dip.title} text={h.dip.text} index={0}>
        <div class="dip">
          <Picture
            class="dip__img"
            src={dipImage}
            alt={h.dip.alt}
            widths={[800, 1300, 1960]}
            sizes="(max-width: 734px) 100vw, 980px"
            {...img}
          />
          <dl class="stats">
            {h.dip.stats.map((s) => (
              <div class="stats__item">
                <dt class="stats__label">{s.label}</dt>
                <dd class="stats__value">{s.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </HighlightTile>

      {/* 2. Złącze */}
      <HighlightTile span="full" title={h.connector.title} text={h.connector.text} index={1}>
        <Picture
          class="highlights__img highlights__img--wide"
          src={connectorImage}
          alt={h.connector.alt}
          widths={[800, 1300, 1960]}
          sizes="(max-width: 734px) 100vw, 980px"
          {...img}
        />
      </HighlightTile>

      {/* 3. Energia | chip */}
      <HighlightTile span="third" title={h.power.title} text={h.power.text} index={2}>
        <p slot="before" class="big-value">
          {h.power.value}
        </p>
      </HighlightTile>

      <HighlightTile span="two-thirds" title={h.brain.title} text={h.brain.text} index={3}>
        <div class="highlights__chip">
          <ChipReveal name="ATmega" model="328P" c1={c1} c2={c2} />
        </div>
      </HighlightTile>

      {/* 4. Zabezpieczenia | rozmiar */}
      <HighlightTile span="half" title={h.safety.title} text={h.safety.text} index={4}>
        <Picture
          class="highlights__img"
          src={topImage}
          alt={h.safety.alt}
          widths={[600, 980]}
          sizes="(max-width: 734px) 100vw, 490px"
          {...img}
        />
      </HighlightTile>

      <HighlightTile span="half" title={h.size.title} text={h.size.text} index={5}>
        <Picture
          class="highlights__img"
          src={angleImage}
          alt={h.size.alt}
          widths={[600, 980]}
          sizes="(max-width: 734px) 100vw, 490px"
          {...img}
        />
      </HighlightTile>
    </div>
  </div>
</section>

<style>
  /* Druga scena: ciemnoszare tło na całą szerokość, czarne kafelki (jak u Apple). */
  .highlights {
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark);
  }

  .highlights__inner {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(4.5rem, 10vw, 8rem) var(--gutter) clamp(5rem, 10vw, 8rem);
  }

  .highlights__title {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.03em;
  }

  .highlights__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 734px) {
    .highlights__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
  }

  /* ---------- Obrazy ---------- */
  .highlights__grid :global(picture) {
    display: block;
    width: 100%;
  }

  .highlights__grid :global(.highlights__img) {
    width: 100%;
    height: auto;
  }

  .highlights__grid :global(.highlights__img--wide) {
    margin-top: 0.5rem;
  }

  /* ---------- 1. Przełączniki: zdjęcie + liczby ---------- */
  .dip {
    width: 100%;
  }

  /* Zdjęcie wypełnia kartę, górna krawędź płynnie znika w czerni (płytka jest ucięta kadrem). */
  .dip :global(.dip__img) {
    width: 100%;
    height: auto;
    margin-top: 1.5rem;
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 28%,
      #000 78%,
      transparent 100%
    );
    mask-image: linear-gradient(180deg, transparent 0%, #000 28%, #000 78%, transparent 100%);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 2.5rem 2.5rem 3rem;
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.375rem;
  }

  .stats__value {
    margin: 0;
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .stats__label {
    color: var(--color-text-2-on-dark);
    font-size: 1.0625rem;
  }

  @media (max-width: 734px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding: 1.5rem 1.5rem 2.25rem;
    }
  }

  /* ---------- 3. Energia: duża liczba w kolorach produktu ---------- */
  .big-value {
    width: fit-content;
    margin-inline: auto;
    font-size: clamp(2.75rem, 2rem + 1.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
    background: linear-gradient(
      90deg,
      var(--accent-from, var(--color-text-on-dark)),
      var(--accent-to, var(--color-text-on-dark))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Wąska karta: tytuł mniejszy niż w kartach bez obrazu, żeby mieścił się w 2 liniach. */
  .highlights__grid :global(.tile--third .tile__title) {
    font-size: clamp(1.5rem, 1.3rem + 0.5vw, 1.75rem);
  }

  /* ---------- 3. Chip ---------- */
  .highlights__chip {
    width: min(17rem, 62%);
    padding-block: 2.5rem 3rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .highlights__title:not(.is-in) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .highlights__title {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }
  }
</style>
