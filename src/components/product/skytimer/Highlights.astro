---
/**
 * "Co go wyróżnia." dla SkyTimer 1: poziomy rząd kart (FeatureGallery), zapowiedź rozdziałów
 * niżej, jak na stronie MacBooka Pro z PROLED XDR. Każda karta z innym rodzajem obrazu.
 *
 * Rendery: ciemne studio (F1E_SkyTimer_v0.1.blend, scena SkyTimer_Anim_Zlozenie, tło #000),
 * oryginały w Raw Assets/Blender Renders/SkyTimer strona produktu/:
 *   01 → przelaczniki-makro (całe), 02 → zlacze-skos (przycięte do produktu z cieniem),
 *   04 → gora (przycięte). Karta "odtwarzanie": grafika sygnałów (bez renderu).
 */
import FeatureGallery, { type GalleryItem } from '../FeatureGallery.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { HTML_LANG } from '../../../i18n/locales.ts';
import { getProduct } from '../../../data/products/index.ts';
import { SKYTIMER_1_TIMING as T } from '../../../data/skytimer-1-spec.ts';
import { formatDuration } from '../../../lib/duration.ts';
import dipImage from '../../../assets/renders/skytimer-1/story/przelaczniki-makro.png';
import connectorImage from '../../../assets/renders/skytimer-1/story/zlacze-skos.png';
import topImage from '../../../assets/renders/skytimer-1/story/gora.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const story = getDictionary(locale).products['skytimer-1'].story;
const g = story.gallery;
const dur = (ms: number) => formatDuration(ms, story.units, HTML_LANG[locale]);

// Karta "odtwarzanie": przykład z rozdziału, 2 min 15 s = długi, długi, krótki.
const signals = [T.playback.long, T.playback.long, T.playback.short];
const signalsTotal = signals.reduce((a, b) => a + b, 0);
const physical = getProduct('skytimer-1')?.physical;
if (!physical) throw new Error('Brak wymiarów i masy (physical) w danych skytimer-1');
const [short, long] = physical.sizeMm;
const size = { weight: physical.weightG, short, long };

const items: GalleryItem[] = [
  { id: 'dip', text: g.items.dip.text, image: dipImage, alt: g.items.dip.alt, fit: 'cover' },
  {
    id: 'connector',
    text: g.items.connector.text,
    image: connectorImage,
    alt: g.items.connector.alt,
  },
  { id: 'playback', text: g.items.playback.text },
  { id: 'size', text: format(g.items.size.text, size), image: topImage, alt: g.items.size.alt },
];
---

<FeatureGallery
  heading={g.heading}
  items={items}
  prevLabel={g.prev}
  nextLabel={g.next}
  dotLabel={g.dot}
>
  {/* Sygnały z podpisami i sumą. Ozdoba: treść jest w tekście karty. */}
  <div slot="playback" class="beeps" aria-hidden="true" data-reveal>
    <div class="beeps__row">
      {signals.map((ms, i) => (
        <div class="beeps__signal" style={`--n: ${i}`}>
          <span
            class:list={[
              'beeps__pill',
              ms === T.playback.long ? 'beeps__pill--long' : 'beeps__pill--short',
            ]}
          />
          <span class="beeps__label">{dur(ms)}</span>
        </div>
      ))}
    </div>
    <p class="beeps__total">{format(g.items.playback.total, { time: dur(signalsTotal) })}</p>
  </div>
</FeatureGallery>

<style>
  .beeps {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
    height: 100%;
    padding-bottom: 6%;
  }

  .beeps__row {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .beeps__signal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
  }

  .beeps__pill {
    height: clamp(0.875rem, 0.6rem + 0.8vw, 1.25rem);
    border-radius: 999px;
    background: var(--color-text-on-dark);
  }

  .beeps__pill--long {
    width: clamp(5.5rem, 3rem + 9vw, 10rem);
  }

  .beeps__pill--short {
    width: clamp(0.875rem, 0.6rem + 0.8vw, 1.25rem);
  }

  .beeps__label {
    color: var(--color-text-2-on-dark);
    font-size: clamp(0.875rem, 0.75rem + 0.4vw, 1.0625rem);
    font-weight: 600;
    white-space: nowrap;
  }

  .beeps__total {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  /* Raz, przy pojawieniu się karty: sygnały "grają" po kolei jak z buzzera, potem suma.
     clip-path, nie scaleX: skalowanie spłaszczałoby zaokrąglone końce. */
  @media (prefers-reduced-motion: no-preference) {
    .beeps__pill {
      clip-path: inset(0 0 0 0 round 999px);
    }

    :global(.reveal-js) .beeps:not(:global(.is-in)) .beeps__pill {
      clip-path: inset(0 100% 0 0 round 999px);
    }

    :global(.reveal-js) .beeps:not(:global(.is-in)) :is(.beeps__label, .beeps__total) {
      opacity: 0;
    }

    .beeps:global(.is-in) .beeps__pill {
      transition: clip-path 420ms var(--ease-out) calc(300ms + var(--n) * 560ms);
    }

    .beeps:global(.is-in) .beeps__label {
      transition: opacity 300ms var(--ease-out) calc(500ms + var(--n) * 560ms);
    }

    .beeps:global(.is-in) .beeps__total {
      transition: opacity 400ms var(--ease-out) 1900ms;
    }
  }
</style>
