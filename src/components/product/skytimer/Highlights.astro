---
/**
 * "Poznaj SkyTimer 1": siatka wyróżników (wzór: kafelki "Poznaj..." na apple.com).
 *
 * Druga "scena" strony: ciemnoszare tło na całą szerokość (--color-surface-dark),
 * na nim czarne kafelki. Pierwsza scena (animacja) zostaje czarna.
 *
 * Układ (desktop, siatka 6 kolumn), każdy kafelek z innym rodzajem obrazu:
 *   1. przełączniki: makro + 3 liczby                         pełna szerokość
 *   2. złącze: render od frontu                                pełna szerokość
 *   3. zasilanie | sygnały (kafelki tekstowe)                  1/2 + 1/2
 *   4. zabezpieczenia: trzy punkty (RDT, AFA, ostrzeżenia)     pełna szerokość
 *   5. rozmiar: masa i tekst po lewej, rzut z góry z wymiarami pełna szerokość, dzielony
 * Telefon: jedna kolumna. (Ceny i "Zamów": pasek produktu u góry.)
 *
 * Tekst kafelka: tytuł + najwyżej dwa krótkie zdania (HighlightTile).
 * Rendery: ciemne studio ze sceny animacji (Blender, F1E_SkyTimer_v0.1.blend, scena
 * SkyTimer_Anim_Zlozenie), oryginały w Raw Assets/Blender Renders/SkyTimer strona produktu/:
 *   01 przełączniki-makro (kamera Kadr_01_dip_makro),
 *   05 zlacze-front (kamera od frontu, 20° nad płytką, 135 mm; przycięte 1440 × 655),
 *   06 gora-wymiary (kamera ortograficzna z góry, ortho_scale 4.4, 1600 × 1200).
 * Teksty: słownik (products.skytimer-1.story.highlights), wymiary i masa: dane produktu.
 */
import { Picture } from 'astro:assets';
import type { ImageOutputFormat } from 'astro';
import type { ComponentProps } from 'astro/types';
import HighlightTile from '../HighlightTile.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { getProduct } from '../../../data/products/index.ts';
import dipImage from '../../../assets/renders/skytimer-1/poznaj/przelaczniki-makro.png';
import connectorImage from '../../../assets/renders/skytimer-1/poznaj/zlacze-front.png';
import topImage from '../../../assets/renders/skytimer-1/poznaj/gora-wymiary.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const id = 'skytimer-1';
const dict = getDictionary(locale);
const h = dict.products[id].story.highlights;
const product = getProduct(id);
if (!product) throw new Error('Brak produktu skytimer-1 w danych');
if (!product.physical) throw new Error('Brak wymiarów i masy (physical) w danych skytimer-1');

const [c1, c2] = product.colors ?? [undefined, undefined];

const { sizeMm, weightG, kitWeightG } = product.physical;
const [short, long] = sizeMm;
const sizeVars = { weight: weightG, kitWeight: kitWeightG ?? '', short, long };

/*
 * Krawędzie płytki na renderze z góry (piksele klatki 1600 × 1200, zmierzone na renderze).
 * Kamera ortograficzna: 1600 px = 4,4 j., płytka 3,01 × 2,33 j. = 1095 × 847 px, na środku.
 * Linie wymiarów stoją 50 px od krawędzi płytki.
 */
const FRAME = { w: 1600, h: 1200 };
const BOARD = { left: 252, right: 1347, top: 176, bottom: 1023 };
const GAP = 50;
const TICK = 18;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;

// Wspólne ustawienia obrazów: AVIF/WebP, jakość wyższa niż domyślna (rendery z drobnymi napisami).
const img = {
  formats: ['avif', 'webp'] satisfies ImageOutputFormat[],
  quality: 80,
  loading: 'lazy',
} as const satisfies Partial<ComponentProps<typeof Picture>>;
---

<section
  class="highlights"
  aria-labelledby="highlights-title"
  style={c1 && c2 ? `--accent-from: ${c1}; --accent-to: ${c2}` : undefined}
>
  <div class="highlights__inner">
    <h2 class="highlights__title" id="highlights-title" data-reveal>
      {h.heading}
    </h2>

    <div class="highlights__grid">
      {/* 1. Przełączniki */}
      <HighlightTile span="full" title={h.dip.title} text={h.dip.text}>
        <div class="dip">
          <Picture
            class="dip__img"
            src={dipImage}
            alt={h.dip.alt}
            widths={[800, 1300, 1960]}
            sizes="(max-width: 734px) 100vw, 980px"
            {...img}
          />
          <dl class="stats">
            {h.dip.stats.map((s) => (
              <div class="stats__item">
                <dt class="stats__label">{s.label}</dt>
                <dd class="stats__value">{s.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </HighlightTile>

      {/* 2. Złącze */}
      <HighlightTile span="full" title={h.connector.title} text={h.connector.text}>
        <Picture
          class="highlights__img"
          src={connectorImage}
          alt={h.connector.alt}
          widths={[800, 1440]}
          sizes="(max-width: 734px) 100vw, 980px"
          {...img}
        />
      </HighlightTile>

      {/* 3. Zasilanie | sygnały */}
      <HighlightTile span="half" title={h.power.title} text={h.power.text} index={0}>
        <p slot="before" class="big-value">
          {h.power.value}
        </p>
      </HighlightTile>

      <HighlightTile span="half" title={h.playback.title} text={h.playback.text} index={1}>
        {/* Dwa długie i krótki sygnał = 2 min 15 s. Ozdoba: treść jest w tekście kafelka. */}
        <p slot="before" class="signals" aria-hidden="true">
          <span class="signals__long"></span>
          <span class="signals__long"></span>
          <span class="signals__short"></span>
        </p>
      </HighlightTile>

      {/* 4. Zabezpieczenia: trzy punkty */}
      <HighlightTile span="full" title={h.safety.title}>
        <dl slot="after" class="points">
          {h.safety.items.map((item) => (
            <div class="points__item">
              <dt class="points__term">{item.term}</dt>
              <dd class="points__text">{item.text}</dd>
            </div>
          ))}
        </dl>
      </HighlightTile>

      {/* 5. Rozmiar: masa + wymiary na rzucie z góry */}
      <HighlightTile
        span="full"
        layout="split"
        title={h.size.title}
        text={format(h.size.text, sizeVars)}
      >
        <p slot="before" class="big-value big-value--hero">
          {format(h.size.value, sizeVars)}
        </p>
        <figure class="dims">
          <Picture
            class="dims__img"
            src={topImage}
            alt={format(h.size.alt, sizeVars)}
            widths={[640, 1100, 1600]}
            sizes="(max-width: 734px) 100vw, 560px"
            {...img}
          />
          <svg
            class="dims__lines"
            viewBox={`0 0 ${FRAME.w} ${FRAME.h}`}
            aria-hidden="true"
            preserveAspectRatio="none"
          >
            {/* Długość (poziomo, nad płytką) */}
            <path
              pathLength="1"
              d={`M${BOARD.left} ${BOARD.top - GAP}H${BOARD.right}
                  M${BOARD.left} ${BOARD.top - GAP - TICK}v${2 * TICK}
                  M${BOARD.right} ${BOARD.top - GAP - TICK}v${2 * TICK}`}
            />
            {/* Szerokość (pionowo, na lewo od płytki) */}
            <path
              pathLength="1"
              d={`M${BOARD.left - GAP} ${BOARD.top}V${BOARD.bottom}
                  M${BOARD.left - GAP - TICK} ${BOARD.top}h${2 * TICK}
                  M${BOARD.left - GAP - TICK} ${BOARD.bottom}h${2 * TICK}`}
            />
          </svg>
          <span
            class="dims__label dims__label--long"
            style={`left: 50%; top: ${pct(BOARD.top - GAP, FRAME.h)}`}
            aria-hidden="true"
          >
            {format(h.size.dimension, { n: long })}
          </span>
          <span
            class="dims__label dims__label--short"
            style={`left: ${pct(BOARD.left - GAP, FRAME.w)}; top: ${pct((BOARD.top + BOARD.bottom) / 2, FRAME.h)}`}
            aria-hidden="true"
          >
            {format(h.size.dimension, { n: short })}
          </span>
        </figure>
      </HighlightTile>
    </div>
  </div>
</section>

<style>
  /* Druga scena: ciemnoszare tło na całą szerokość, czarne kafelki (jak u Apple). */
  .highlights {
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark);
  }

  .highlights__inner {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(5rem, 11vw, 9rem) var(--gutter) clamp(5rem, 11vw, 9rem);
  }

  .highlights__title {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.03em;
  }

  .highlights__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 734px) {
    .highlights__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.875rem;
    }
  }

  /* ---------- Obrazy ---------- */
  .highlights__grid :global(picture) {
    display: block;
    width: 100%;
  }

  .highlights__grid :global(.highlights__img) {
    width: 100%;
    height: auto;
  }

  /* Telefon: płytka zajmuje 75% kadru złącza, więc kadr powiększony o 25% (boki to czerń,
     obcina je karta). */
  @media (max-width: 734px) {
    .highlights__grid :global(.highlights__img) {
      width: 125%;
      max-width: none;
      margin-inline: -12.5%;
    }
  }

  /* ---------- 1. Przełączniki: zdjęcie + liczby ---------- */
  .dip {
    width: 100%;
  }

  /* Zdjęcie wypełnia kartę, górna krawędź płynnie znika w czerni (płytka jest ucięta kadrem). */
  .dip :global(.dip__img) {
    width: 100%;
    height: auto;
    margin-top: 1rem;
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 28%,
      #000 78%,
      transparent 100%
    );
    mask-image: linear-gradient(180deg, transparent 0%, #000 28%, #000 78%, transparent 100%);
  }

  /* Liczby wyrównane do tekstu kafelka (ten sam odstęp od lewej krawędzi). */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0.5rem var(--pad) var(--pad);
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .stats__value {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .stats__label {
    color: var(--color-text-2-on-dark);
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  @media (max-width: 734px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  /* ---------- Duże liczby w kolorach produktu (zasilanie, masa) ---------- */
  .big-value {
    width: fit-content;
    font-size: clamp(2.75rem, 2.1rem + 2vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    white-space: nowrap;
    background: linear-gradient(
      90deg,
      var(--accent-from, var(--color-text-on-dark)),
      var(--accent-to, var(--color-text-on-dark))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Masa: główna liczba kafelka, większa. */
  .big-value--hero {
    font-size: clamp(4rem, 2.6rem + 4.4vw, 6.5rem);
    line-height: 1;
  }

  /* ---------- 4. Zabezpieczenia: trzy punkty w kolumnach ---------- */
  .points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
  }

  .points__item {
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .points__term {
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .points__text {
    margin: 0.5rem 0 0;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (max-width: 899px) {
    .points {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  /* ---------- 3. Odtwarzanie czasu: sygnały jak w Morse'ie, w kolorach produktu ---------- */
  .signals {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    /* Ta sama wysokość co liczba "250 mAh" obok: tytuły w wierszu stoją na jednej wysokości. */
    height: calc(clamp(2.75rem, 2.1rem + 2vw, 4rem) * 1.05);
  }

  .signals span {
    height: 0.875rem;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--accent-from, var(--color-text-on-dark)),
      var(--accent-to, var(--color-text-on-dark))
    );
  }

  .signals__long {
    width: 4.5rem;
  }

  .signals__short {
    width: 0.875rem;
  }

  /* ---------- 4. Rozmiar: rzut z góry z liniami wymiarów ---------- */
  .dims {
    position: relative;
    width: min(100%, 36rem);
    margin: 0 auto;
    color: var(--color-text-2-on-dark);
  }

  .dims :global(.dims__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .dims__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .dims__lines path {
    fill: none;
    stroke: currentColor;
    /* Jednostki rysunku 1600 px: 3,5 ≈ 1,2 px przy szerokości 560 px. (Bez non-scaling-stroke:
       psuje rysowanie linii przez pathLength.) */
    stroke-width: 3.5;
  }

  .dims__label {
    position: absolute;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  /* Nad linią poziomą. */
  .dims__label--long {
    transform: translate(-50%, calc(-100% - 0.5rem));
  }

  /* Na lewo od linii pionowej, obrócony jak na rysunku technicznym. */
  .dims__label--short {
    /* Po obrocie o -90° oś Y patrzy w prawo, więc ujemne translateY odsuwa w lewo od linii. */
    transform: translate(-50%, -50%) rotate(-90deg) translateY(calc(-0.5em - 0.5rem));
  }

  /* Na telefonie obraz zostaje od krawędzi do krawędzi, ale nie wyższy niż potrzeba. */
  @media (max-width: 734px) {
    .dims {
      width: 100%;
      margin-top: 2rem;
    }
  }

  /* ---------- Ruch: tylko raz, przy wejściu kafelka; bez JS / z ograniczeniem ruchu od razu pełne ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .highlights__title:not(.is-in) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .highlights__title {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }

    /* Sygnały "grają" po kolei jak z buzzera (długi, długi, krótki).
       clip-path zamiast scaleX: skalowanie spłaszczałoby zaokrąglone końce w trakcie ruchu.
       Stan końcowy jawnie jako inset(0): "none" nie interpoluje się z inset() i przeskakuje. */
    .signals span {
      clip-path: inset(0 0 0 0 round 999px);
    }

    .signals span:nth-child(1) {
      --d: 400ms;
      --t: 420ms;
    }

    .signals span:nth-child(2) {
      --d: 950ms;
      --t: 420ms;
    }

    .signals span:nth-child(3) {
      --d: 1500ms;
      --t: 160ms;
    }

    :global(.reveal-js) :global(.tile:not(.is-in)) .signals span {
      clip-path: inset(0 100% 0 0 round 999px);
    }

    /* Przejście tylko przy odsłanianiu: ukrycie po starcie skryptu ma być natychmiastowe. */
    :global(.tile.is-in) .signals span {
      transition: clip-path var(--t) var(--ease-out) var(--d);
    }

    /* Linie wymiarów rysują się od końca do końca, potem pojawiają się liczby. */
    :global(.reveal-js) :global(.tile:not(.is-in)) .dims__lines path {
      stroke-dashoffset: 1;
    }

    :global(.reveal-js) :global(.tile:not(.is-in)) .dims__label {
      opacity: 0;
    }

    .dims__lines path {
      stroke-dasharray: 1;
    }

    :global(.tile.is-in) .dims__lines path {
      transition: stroke-dashoffset 600ms var(--ease-out) 300ms;
    }

    :global(.tile.is-in) .dims__label {
      transition: opacity 300ms var(--ease-out) 800ms;
    }
  }
</style>
