---
/**
 * "Który SkyTimer 1 dla Ciebie?" (wzór: "Which iPhone is right for you?" na apple.com).
 * Koniec strony produktu: dwie kolumny (zestaw / sama płytka), cena, "Zamów" i co jest w środku.
 *
 * Ceny z danych (src/data/products/skytimer-1.ts), także przecena. Omnibus: przy obniżce obok
 * przekreślonej ceny ZAWSZE najniższa cena z 30 dni (walidacja danych nie przepuści przeceny bez niej).
 * "Zamów" prowadzi do konfiguratora z wybraną wersją (?wersja=kit / ?wersja=pcb).
 */
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary, productTexts } from '../../../i18n/index.ts';
import { configuratorPath } from '../../../i18n/routes.ts';
import { getProduct } from '../../../data/products/index.ts';
import { activePromo, currentPrice, formatPrice } from '../../../lib/price.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const id = 'skytimer-1';
const dict = getDictionary(locale);
const t = dict.products[id].story.compare;
const texts = productTexts(dict, id);
const product = getProduct(id);
const typeStep = product?.configurator?.steps.find((s) => s.id === 'type');
if (!typeStep) throw new Error('SkyTimer 1: brak kroku "type" w konfiguratorze');
const today = new Date(); // dzień buildu

// Co jest w której wersji. Zestaw: lista z podręcznika; wybór wariantu tylko dla zestawu (konfigurator).
const FEATURES = ['board', 'variant', 'battery', 'modules', 'mounting'] as const;
const INCLUDED: Record<string, readonly (typeof FEATURES)[number][]> = {
  kit: FEATURES,
  pcb: ['board'],
};

const columns = typeStep.options.map((option) => {
  const price = option.price;
  const now = price ? currentPrice(price, today) : null;
  const promo = price ? activePromo(price, today) : null;
  const name = texts.steps?.type?.options[option.id] ?? option.id;
  return {
    id: option.id,
    name,
    now: now !== null ? formatPrice(now, locale) : dict.common.priceOnRequest,
    old: promo && price?.regular != null ? formatPrice(price.regular, locale) : null,
    lowest:
      promo?.lowestPrice30Days != null
        ? format(dict.common.lowestPrice30Days, {
            price: formatPrice(promo.lowestPrice30Days, locale),
          })
        : null,
    href: `${configuratorPath(locale, id)}?wersja=${option.id}`,
    orderLabel: format(t.orderLabel, { option: name }),
    features: FEATURES.map((f) => ({
      label: t.features[f],
      included: (INCLUDED[option.id] ?? []).includes(f),
    })),
  };
});
---

<section class="compare" aria-labelledby="compare-title">
  <div class="compare__inner">
    <h2 class="compare__title" id="compare-title">
      {t.heading}
    </h2>

    <div class="compare__grid">
      {columns.map((c) => (
        <article class="compare__col" aria-labelledby={`compare-${c.id}`}>
          <h3 class="compare__name" id={`compare-${c.id}`}>
            {c.name}
          </h3>

          <p class="compare__price">
            {c.old && (
              <>
                <s class="compare__old">
                  <span class="visually-hidden">{dict.common.regularPrice}</span> {c.old}
                </s>{' '}
              </>
            )}
            <span class="compare__now">{c.now}</span>
          </p>
          {/* Akapit także w kolumnie bez obniżki: obie kolumny mają te same wiersze siatki. */}
          <p class="compare__lowest" aria-hidden={c.lowest ? undefined : 'true'}>
            {c.lowest}
          </p>

          <a class="compare__cta" href={c.href} aria-label={c.orderLabel}>
            {dict.common.order}
          </a>

          <ul class="compare__features" role="list">
            {c.features.map((f) => (
              <li class:list={['compare__feature', { 'is-off': !f.included }]}>
                {f.included ? (
                  f.label
                ) : (
                  <>
                    {/* Niewidoczna nazwa trzyma wysokość wiersza równą z drugą kolumną. */}
                    <span class="compare__ghost" aria-hidden="true">
                      {f.label}
                    </span>
                    <span class="compare__dash" aria-hidden="true" />
                    <span class="visually-hidden">
                      {f.label}: {t.notIncluded}
                    </span>
                  </>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Ostatnia scena: czarna (sceny na przemian: czarna / ciemnoszara). */
  .compare {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
  }

  .compare__inner {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(5rem, 11vw, 9rem) var(--gutter) clamp(5rem, 11vw, 9rem);
  }

  .compare__title {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.03em;
    text-align: center;
    text-wrap: balance;
  }

  /*
   * Kolumny dzielą wiersze siatki (subgrid): nazwa, cena, najniższa cena, przycisk i lista
   * wypadają na tej samej wysokości, nawet gdy nazwa w jednej kolumnie zawija się na dwie linie.
   */
  .compare__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 5vw, 5rem);
  }

  .compare__col {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    justify-items: center;
    align-content: start;
    text-align: center;
  }

  .compare__name {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .compare__price {
    margin-top: 0.75rem;
    font-size: 1.3125rem;
    font-variant-numeric: tabular-nums;
  }

  .compare__now {
    font-weight: 600;
  }

  .compare__old {
    color: var(--color-text-2-on-dark);
  }

  .compare__lowest {
    max-width: 16rem;
    margin-top: 0.375rem;
    color: var(--color-text-2-on-dark);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .compare__cta {
    display: inline-flex;
    align-self: start;
    align-items: center;
    height: 2.75rem;
    margin-top: 1.5rem;
    padding-inline: 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-text-on-dark);
    color: var(--color-bg-dark);
    font-size: var(--text-body);
    text-decoration: none;
    text-box: trim-both cap alphabetic;
  }

  .compare__cta:focus-visible {
    outline: 2px solid var(--color-text-on-dark);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .compare__cta:hover {
      background: color-mix(in srgb, var(--color-text-on-dark) 82%, var(--color-bg-dark));
    }
  }

  /*
   * Lista jak w porównaniu iPhone'ów: pozycje zestawu białym tekstem, a gdzie czegoś nie ma,
   * cienka kreska. Te same wiersze w obu kolumnach, więc wypadają na tej samej wysokości.
   */
  .compare__features {
    display: grid;
    width: 100%;
    max-width: 18rem;
    margin: 2.75rem 0 0;
    padding: 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    list-style: none;
  }

  .compare__feature {
    display: grid;
    min-height: 3.25rem;
    padding-block: 0.875rem;
    place-items: center;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-size: 1.0625rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  .compare__feature.is-off {
    position: relative;
  }

  .compare__ghost {
    visibility: hidden;
  }

  .compare__dash {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.25rem;
    height: 1px;
    background: var(--color-text-2-on-dark);
    translate: -50% -50%;
  }

  @media (max-width: 734px) {
    .compare__name {
      font-size: 1.25rem;
    }

    .compare__price {
      font-size: 1.125rem;
    }

    .compare__feature {
      font-size: 0.9375rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .compare__cta {
      transition:
        background-color 240ms var(--ease-out),
        transform var(--duration-press) var(--ease-out);
    }

    .compare__cta:active {
      transform: scale(0.97);
    }
  }
</style>
