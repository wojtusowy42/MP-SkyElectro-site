---
/**
 * "Dane techniczne": tabela parametrów z podręcznika + link do podręcznika w PDF.
 * Scena ciemnoszara. Desktop: nazwa po lewej, wartość po prawej, cienkie linie między wierszami.
 * PDF: public/docs/ (wersja skompresowana do sieci, ok. 0,9 MB; oryginał 27 MB w projekcie).
 */
import type { Locale } from '../../../i18n/locales.ts';
import { getDictionary } from '../../../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).products['skytimer-1'].story.specs;
const PDF = '/docs/skytimer-1-podrecznik-uzytkownika.pdf';
---

<section class="specs" aria-labelledby="specs-title">
  <div class="specs__inner">
    <h2 class="specs__title" id="specs-title">
      {t.heading}
    </h2>
    <dl class="specs__list">
      {t.rows.map(([label, value]) => (
        <div class="specs__row">
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
    <a class="specs__pdf" href={PDF} download>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        <path
          d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 15.5h12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
      {t.manual}
    </a>
  </div>
</section>

<style>
  .specs {
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark);
  }

  .specs__inner {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(5rem, 11vw, 9rem) var(--gutter);
  }

  .specs__title {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.03em;
  }

  .specs__list {
    margin: 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .specs__row {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 2.2fr);
    gap: 1rem 2rem;
    padding-block: 1.125rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .specs__row dt {
    font-weight: 600;
  }

  .specs__row dd {
    margin: 0;
    color: var(--color-text-2-on-dark);
  }

  .specs__pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    color: var(--color-text-on-dark);
    font-size: 1.0625rem;
    text-decoration: none;
  }

  @media (hover: hover) {
    .specs__pdf:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  @media (max-width: 734px) {
    .specs__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
