---
/**
 * Rozdział "Ustawianie czasów" SkyTimer 1 (wzór: rozdział "Wyświetlacz PROLED XDR" na apple.com:
 * nagłówek → główna atrakcja rozdziału). Blok "Liczby mówią same za siebie" usunięty
 * (decyzja właściciela 2026-11-06).
 * Ukryty 2026-11-06, przywrócony 2026-11-07 razem z nowym układem strony.
 *
 * Atrakcja: symulator przełączników DIP. Klikasz przełączniki jak na płytce i widzisz,
 * co ustawi timer: czas flop, czas dether (z bonusem) i sygnały, które zagra po włączeniu.
 * Wygląd: prawdziwa płytka z Blendera (decyzja właściciela 2026-11-07), klikasz jej przełączniki.
 * Render bez naklejki z czasami (właściciel 2026-11-07); czasy są tekstem pod płytką.
 * 20 renderów z tej samej kamery (Kadr_2_a, SkyTimer_Kadry_strony.blend) z suwakami w kolejnych
 * pozycjach (z łagodnym startem i hamowaniem): pas przełączników ze wszystkich to jeden obraz (klatki
 * jedna pod drugą). Każdy przełącznik pokazuje swoją kolumnę i przechodzi przez klatki samym CSS
 * (transition ze steps). Różnią się tylko suwaki, więc nie ma szwów.
 * Współrzędne: 2a_przelaczniki_DIP.json. Oryginały: 02 Ustawianie czasow/Sekwencja suwaka bez naklejki/.
 * Dlaczego symulator, a nie kolejny render: tego nie da się pokazać zdjęciem, a to jest
 * główna zaleta timera (czasy bez komputera). Liczy src/lib/skytimer-timing.ts (testy),
 * fakty z src/data/skytimer-1-spec.ts.
 *
 * Bez JS: stan początkowy policzony w buildzie (ten sam kod), przełączniki nieaktywne.
 * Dostępność: każdy przełącznik to button role="switch" (aria-checked), wynik w aria-live.
 */
import { getImage, Picture } from 'astro:assets';
import StoryChapter from '../StoryChapter.astro';
import offImage from '../../../assets/renders/skytimer-1/story/dip-off.jpg';
import framesImage from '../../../assets/renders/skytimer-1/story/dip-suwak-klatki.jpg';
import type { Locale } from '../../../i18n/locales.ts';
import { HTML_LANG } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { SKYTIMER_1_TIMING as T } from '../../../data/skytimer-1-spec.ts';
import { timing } from '../../../lib/skytimer-timing.ts';
import { formatDuration } from '../../../lib/duration.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const lang = HTML_LANG[locale];
const story = getDictionary(locale).products['skytimer-1'].story;
const t = story.timing;
const u = story.units;
const dur = (ms: number, tenths = false) => formatDuration(ms, u, lang, tenths);

// Przełączniki: grupa i wartość (tekst). Flop z dziesiątymi częściami sekundy.
const switches = [
  ...T.flop.switches.map((ms) => ({ group: 'flop' as const, label: dur(ms, true) })),
  ...T.dether.switches.map((ms) => ({ group: 'dether' as const, label: dur(ms) })),
];

// Stan początkowy: wszystkie przełączniki na OFF (właściciel 2026-11-07).
const initial: number[] = [];
const state = switches.map((_, i) => initial.includes(i + 1));
const r = timing(state);

const flopNote = format(t.sim.flopNote, { offset: dur(T.flop.offset, true) });
const flopText = r.flopMs === null ? t.sim.flopOff : dur(r.flopMs, true);
const detherText = dur(r.detherMs);
const totalText = dur(r.detherMs + r.bonusMs);
const bonusText =
  r.bonusMs > 0
    ? format(t.sim.bonus, { bonus: format(u.plus, { value: dur(r.bonusMs) }) })
    : t.sim.noBonus;

// Teksty dla skryptu (zmiany w przeglądarce).
const config = {
  lang,
  units: { sec: u.sec, min: u.min, minSec: u.minSec },
  flopOff: t.sim.flopOff,
  flopOffNote: t.sim.flopOffNote,
  flopNote,
  plus: u.plus,
  bonus: t.sim.bonus,
  noBonus: t.sim.noBonus,
  signals: t.sim.signals,
};

const flopCount = T.flop.switches.length;

// Geometria w pikselach renderu 3200 × 2000 (2a_przelaczniki_DIP.json), przeliczana na % kadru.
const CROP = { x: 600, y: 230, w: 2000, h: 1540 }; // kadr dip-off.jpg
const STRIP = { top: 720, h: 360 }; // pas przełączników w klatkach dip-suwak-klatki.jpg
const COLUMN_TOP = 560; // obszar kliknięcia: od górnych nóżek do dołu płytki
const FRAME_COUNT = 20;
const FIRST_X = 873.6; // środek przełącznika 1
const PITCH = 161.4; // rozstaw przełączników
const pct = (n: number) => `${(n * 100).toFixed(3)}%`;
const leftPx = (i: number) => FIRST_X + i * PITCH - PITCH / 2 - CROP.x;
const columnH = CROP.y + CROP.h - COLUMN_TOP;
const columnStyle = (i: number) =>
  [
    `left: ${pct(leftPx(i) / CROP.w)}`,
    `width: ${pct(PITCH / CROP.w)}`,
    `top: ${pct((COLUMN_TOP - CROP.y) / CROP.h)}`,
    `height: ${pct(columnH / CROP.h)}`,
  ].join('; ');
const sliceStyle = (i: number) =>
  [
    `top: ${pct((STRIP.top - COLUMN_TOP) / columnH)}`,
    `height: ${pct(STRIP.h / columnH)}`,
    `background-size: ${switches.length * 100}% ${FRAME_COUNT * 100}%`,
    `background-position-x: ${pct(i / (switches.length - 1))}`,
  ].join('; ');
const frames = await getImage({ src: framesImage, format: 'webp', quality: 86 });
---

<StoryChapter id="czasy" eyebrow={t.eyebrow} heading={t.heading} intro={t.intro}>
  <div
    class="sim"
    role="group"
    aria-label={t.sim.label}
    data-sim
    data-config={JSON.stringify(config)}
  >
    <p class="sim__hint">{t.sim.hint}</p>

    {/* Prawdziwa płytka. Cała kolumna z czasem pod płytką jest przyciskiem. */}
    <div class="dip" style={`--frames: url('${frames.src}'); --frame-steps: ${FRAME_COUNT - 1}`}>
      <Picture
        class="dip__board"
        src={offImage}
        alt={t.sim.imageAlt}
        widths={[640, 960, 1280, 1920]}
        sizes="(max-width: 680px) 100vw, 640px"
        formats={['avif', 'webp']}
        quality={82}
        loading="lazy"
      />
      <div role="group" aria-label={t.sim.switchesLabel}>
        {switches.map((sw, i) => (
          <button
            class="dip__switch"
            style={columnStyle(i)}
            type="button"
            role="switch"
            aria-checked={state[i] ? 'true' : 'false'}
            aria-label={format(t.sim.switch, { n: i + 1, value: sw.label })}
            disabled
            data-switch={i}
          >
            <span class="dip__slice" style={sliceStyle(i)} aria-hidden="true"></span>
            <span class="dip__value" aria-hidden="true">
              {sw.label}
            </span>
          </button>
        ))}
      </div>
    </div>

    {/* Które przełączniki za co odpowiadają: klamry w tych samych kolumnach co na płytce. */}
    <div
      class="dip__groups"
      aria-hidden="true"
      style={`--start: ${pct(leftPx(0) / CROP.w)}; --pitch: ${pct(PITCH / CROP.w)}; --flop: ${flopCount}; --dether: ${switches.length - flopCount}`}
    >
      <p class="dip__group dip__group--flop">{t.sim.flopGroup}</p>
      <p class="dip__group dip__group--dether">{t.sim.detherGroup}</p>
    </div>

    {/* Wyniki: flop | dether | z bonusem */}
    <dl class="sim__results" aria-live="polite">
      <div class="sim__cell">
        <dt class="sim__label">{t.sim.flop}</dt>
        <dd class="sim__value" data-flop>
          {flopText}
        </dd>
        <dd class="sim__note" data-flop-note>
          {r.flopMs === null ? t.sim.flopOffNote : flopNote}
        </dd>
      </div>
      <div class="sim__cell">
        <dt class="sim__label">{t.sim.dether}</dt>
        <dd class="sim__value" data-dether>
          {detherText}
        </dd>
        <dd class="sim__note">{t.sim.detherNote}</dd>
      </div>
      <div class="sim__cell">
        <dt class="sim__label">{t.sim.total}</dt>
        <dd class="sim__value" data-total>
          {totalText}
        </dd>
        <dd class="sim__note" data-bonus>
          {bonusText}
        </dd>
      </div>
    </dl>

    {/* Co zagra timer po włączeniu */}
    <div class="sim__playback" data-playback hidden={!r.playback && !r.configMode}>
      <p class="sim__label">{t.sim.playback}</p>
      <div class="sim__signals">
        <div
          class="beeps"
          role="img"
          aria-label={r.playback ? format(t.sim.signals, r.playback) : t.sim.noPlayback}
          data-beeps
          hidden={!r.playback || r.configMode}
        >
          {r.playback &&
            [
              ...Array.from({ length: r.playback.long }, () => 'long'),
              ...Array.from({ length: r.playback.short }, () => 'short'),
            ].map((k) => <span class={`beeps__${k}`} />)}
        </div>
        <p class="sim__note" data-no-playback hidden={!!r.playback || r.configMode}>
          {t.sim.noPlayback}
        </p>
        <p class="sim__note" data-config-mode hidden={!r.configMode}>
          {t.sim.config}
        </p>
      </div>
      <p class="sim__legend" aria-hidden="true">
        {t.sim.legend}
      </p>
    </div>
  </div>
</StoryChapter>

<script>
  import { timing } from '../../../lib/skytimer-timing.ts';
  import { formatDuration } from '../../../lib/duration.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-sim]')) {
    const c = JSON.parse(root.dataset.config ?? '{}') as {
      lang: string;
      units: { sec: string; min: string; minSec: string };
      flopOff: string;
      flopOffNote: string;
      flopNote: string;
      plus: string;
      bonus: string;
      noBonus: string;
      signals: string;
    };
    const fill = (t: string, v: Record<string, string | number>) =>
      t.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
    const dur = (ms: number, tenths = false) => formatDuration(ms, c.units, c.lang, tenths);
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;

    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-switch]')];
    const flop = $('[data-flop]');
    const flopNote = $('[data-flop-note]');
    const dether = $('[data-dether]');
    const total = $('[data-total]');
    const bonus = $('[data-bonus]');
    const beeps = $('[data-beeps]');
    const noPlayback = $('[data-no-playback]');
    const configMode = $('[data-config-mode]');
    const playback = $('[data-playback]');

    const update = () => {
      const r = timing(buttons.map((b) => b.getAttribute('aria-checked') === 'true'));
      flop.textContent = r.flopMs === null ? c.flopOff : dur(r.flopMs, true);
      flopNote.textContent = r.flopMs === null ? c.flopOffNote : c.flopNote;
      dether.textContent = dur(r.detherMs);
      total.textContent = dur(r.detherMs + r.bonusMs);
      bonus.textContent =
        r.bonusMs > 0
          ? fill(c.bonus, { bonus: fill(c.plus, { value: dur(r.bonusMs) }) })
          : c.noBonus;

      beeps.hidden = !r.playback || r.configMode;
      noPlayback.hidden = !!r.playback || r.configMode;
      configMode.hidden = !r.configMode;
      // Cały blok tylko, gdy timer coś zagra (przy wszystkich na OFF tekst był mylący).
      playback.hidden = !r.playback && !r.configMode;
      if (r.playback) {
        beeps.setAttribute('aria-label', fill(c.signals, r.playback));
        const kinds = [
          ...Array<string>(r.playback.long).fill('long'),
          ...Array<string>(r.playback.short).fill('short'),
        ];
        beeps.replaceChildren(
          ...kinds.map((k) => {
            const s = document.createElement('span');
            s.className = `beeps__${k}`;
            return s;
          }),
        );
      }
    };

    for (const b of buttons) {
      b.disabled = false;
      b.addEventListener('click', () => {
        b.setAttribute(
          'aria-checked',
          b.getAttribute('aria-checked') === 'true' ? 'false' : 'true',
        );
        update();
      });
    }
  }
</script>

<style>
  /* ---------- Panel: bez ramki, węższy niż strona ---------- */
  .sim {
    width: calc(100% - 2 * var(--gutter));
    max-width: 52rem;
    margin-inline: auto;
  }

  .sim__hint {
    margin-bottom: clamp(0.75rem, 2vw, 1.5rem);
    color: var(--color-text-2-on-dark);
    font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.0625rem);
    font-weight: 600;
    text-align: center;
  }

  /* ---------- Płytka i przełączniki ---------- */
  /* Płytka węższa niż panel: na komputerze wyniki mieszczą się na ekranie razem z nią. */
  .dip,
  .dip__groups {
    max-width: 40rem;
    margin-inline: auto;
  }

  /* Dolny margines to miejsce na czasy pod płytką (dip__value, poza obrazem). */
  .dip {
    position: relative;
    margin-bottom: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
  }

  .dip :global(picture) {
    display: block;
  }

  .dip :global(.dip__board) {
    width: 100%;
    height: auto;
  }

  .dip__switch {
    position: absolute;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .dip__switch:disabled {
    cursor: default;
  }

  .dip__switch:focus-visible {
    outline: 2px solid var(--color-text-on-dark);
    outline-offset: -1px;
  }

  /* Kolumna klatek: góra obrazu = suwak na OFF (jak obraz bazowy), dół = na ON. */
  .dip__slice {
    position: absolute;
    left: 0;
    width: 100%;
    background-image: var(--frames);
    background-repeat: no-repeat;
    background-position-y: 0%;
    /* Skalowanie łapie rząd pikseli sąsiedniej klatki; brzegi pasa i tak są takie same jak płytka. */
    clip-path: inset(1px 0);
    pointer-events: none;
  }

  .dip__switch[aria-checked='true'] .dip__slice {
    background-position-y: 100%;
  }

  /* Czas przełącznika pod płytką: biały, gdy doliczany. */
  .dip__value {
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 50%;
    color: var(--color-text-2-on-dark);
    font-size: clamp(0.6875rem, 0.55rem + 0.4vw, 0.875rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    translate: -50% 0;
  }

  .dip__switch[aria-checked='true'] .dip__value {
    color: var(--color-text-on-dark);
  }

  /* Klamry pod płytką, w kolumnach przełączników. */
  .dip__groups {
    display: flex;
    margin-top: 0.75rem;
  }

  .dip__group {
    position: relative;
    margin-inline: 2px;
    padding-top: 0.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.32);
    color: var(--color-text-on-dark);
    font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.0625rem);
    font-weight: 600;
    text-align: center;
  }

  /* % liczone od szerokości płytki, więc klamry stoją w tych samych kolumnach co przełączniki. */
  .dip__group--flop {
    width: calc(var(--flop) * var(--pitch) - 4px);
    margin-left: calc(var(--start) + 2px);
  }

  .dip__group--dether {
    width: calc(var(--dether) * var(--pitch) - 4px);
  }

  /* ---------- Wyniki ---------- */
  .sim__results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .sim__cell {
    padding: 1.5rem 1.25rem 0 0;
  }

  .sim__cell + .sim__cell {
    padding-left: 1.25rem;
    border-left: 1px solid rgb(255 255 255 / 0.14);
  }

  .sim__label {
    color: var(--color-text-2-on-dark);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .sim__value {
    margin: 0.375rem 0 0;
    font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .sim__note {
    margin: 0.375rem 0 0;
    color: var(--color-text-2-on-dark);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .sim__playback[hidden],
  .sim__note[hidden],
  .beeps[hidden] {
    display: none;
  }

  /* ---------- Sygnały ---------- */
  .sim__playback {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 2rem;
    text-align: center;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .beeps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  /* :global: sygnały po zmianie tworzy skrypt (bez atrybutu zakresu stylów Astro). */
  .beeps :global(span) {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-text-on-dark);
  }

  .beeps :global(.beeps__long) {
    width: 3rem;
  }

  .beeps :global(.beeps__short) {
    width: 0.5rem;
  }

  .sim__signals .sim__note {
    margin: 0;
  }

  .sim__legend {
    color: var(--color-text-2-on-dark);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  @media (max-width: 734px) {
    .sim__results {
      grid-template-columns: minmax(0, 1fr);
    }

    .sim__cell,
    .sim__cell + .sim__cell {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: baseline;
      column-gap: 1rem;
      padding: 1rem 0;
      border-left: 0;
    }

    .sim__cell + .sim__cell {
      border-top: 1px solid rgb(255 255 255 / 0.14);
    }

    .sim__label {
      grid-area: 1 / 1;
    }

    .sim__value {
      grid-area: 1 / 2 / span 2;
      margin: 0;
      font-size: 1.75rem;
    }

    .sim__cell .sim__note {
      grid-area: 2 / 1;
    }

    .sim__playback {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0;
    }
  }

  /* Najwęższe telefony: płytka na całą szerokość ekranu, żeby czasy pod nią się nie stykały. */
  @media (max-width: 360px) {
    .dip,
    .dip__groups {
      margin-inline: calc(-1 * var(--gutter));
    }
  }

  @media (hover: hover) {
    .dip__switch:not(:disabled):hover {
      background: rgb(255 255 255 / 0.1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Skoki dokładnie co klatkę: suwak jedzie, a nie przenika. */
    .dip__slice {
      transition: background-position-y 300ms steps(var(--frame-steps));
    }

    .dip__value {
      transition: color var(--duration-ui) var(--ease-out);
    }

    .dip__switch {
      transition: background-color var(--duration-ui) var(--ease-out);
    }
  }
</style>
