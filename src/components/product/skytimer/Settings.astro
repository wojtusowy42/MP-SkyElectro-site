---
/**
 * "Konfiguracja": osiem ustawień z trybu konfiguracji (podręcznik, rozdz. 12) z numerami
 * przełączników. Scena ciemnoszara, kafelki czarne. Na górze nagłówek + zdanie, obok zdjęcie
 * przełączników w czarnej karcie (render ma czarne tło).
 * Zdjęcie: klatka 66 obrotu (Raw Assets/Blender Renders/SkyTimer obrót 360/), przycięta jak sekwencja.
 */
import { Picture } from 'astro:assets';
import type { Locale } from '../../../i18n/locales.ts';
import { getDictionary } from '../../../i18n/index.ts';
import image from '../../../assets/renders/skytimer-1/poznaj/przelaczniki-skos.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).products['skytimer-1'].story.settings;
---

<section class="settings" aria-labelledby="settings-title">
  <div class="settings__inner">
    <div class="settings__head">
      <div class="settings__copy">
        <p class="settings__eyebrow">{t.eyebrow}</p>
        <h2 class="settings__title" id="settings-title">
          {t.heading}
        </h2>
        <p class="settings__text">{t.text}</p>
      </div>
      <div class="settings__media" data-reveal>
        <Picture
          class="settings__img"
          src={image}
          alt={t.imageAlt}
          formats={['avif', 'webp']}
          quality={80}
          widths={[500, 800, 1130]}
          sizes="(max-width: 899px) 100vw, 480px"
          loading="lazy"
        />
      </div>
    </div>

    <ul class="settings__grid" role="list">
      {t.items.map((item, i) => (
        <li class="settings__tile" style={`--i: ${i}`} data-reveal>
          <p class="settings__switch">
            <span class="visually-hidden">{t.switchLabel} </span>
            {item.switches}
          </p>
          <h3 class="settings__tile-title">{item.title}</h3>
          <p class="settings__tile-text">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .settings {
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark);
  }

  .settings__inner {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(5rem, 11vw, 9rem) var(--gutter);
  }

  .settings__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .settings__eyebrow {
    margin-bottom: 0.75rem;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .settings__title {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .settings__text {
    margin-top: 1.25rem;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.0625rem, 0.98rem + 0.3vw, 1.3125rem);
    line-height: 1.42;
    text-wrap: pretty;
  }

  .settings__media {
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-bg-dark);
  }

  .settings__media :global(picture),
  .settings__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- Kafelki ustawień ---------- */
  .settings__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .settings__tile {
    padding: 1.75rem 1.5rem 2rem;
    border-radius: 1.5rem;
    background: var(--color-bg-dark);
  }

  /* Numer przełącznika w kolorach produktu. */
  .settings__switch {
    width: fit-content;
    margin-bottom: 1.25rem;
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(
      135deg,
      var(--accent-from, var(--color-text-on-dark)),
      var(--accent-to, var(--color-text-on-dark))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .settings__tile-title {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.018em;
  }

  .settings__tile-text {
    margin-top: 0.375rem;
    color: var(--color-text-2-on-dark);
    font-size: 0.9375rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  @media (max-width: 1068px) {
    .settings__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 899px) {
    .settings__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .settings__grid {
      gap: 0.75rem;
    }

    .settings__tile {
      padding: 1.5rem 1.25rem 1.625rem;
      border-radius: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .settings__media:not(.is-in),
    :global(.reveal-js) .settings__tile:not(.is-in) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .settings__media,
    .settings__tile {
      transition:
        opacity 900ms var(--ease-out),
        transform 900ms var(--ease-out);
    }

    .settings__tile {
      transition-delay: calc(var(--i) * 60ms);
    }
  }
</style>
