---
/**
 * Rozdział "Bezpieczeństwo" SkyTimer 1 (wzór: rozdział "Bezpieczeństwo" na stronie MacBooka Pro
 * z PROLED XDR: nagłówek, potem cztery kafelki: grafika, tytuł, jedno-dwa zdania).
 *
 * Grafiki to nie ikony z biblioteki, tylko to, co timer naprawdę robi:
 *   odtwarzanie: dwa długie i krótki sygnał (2 min 15 s), ostrzeżenia: sześć szybkich sygnałów
 *   oraz krótki z długim, RDT: fale radiowe, AFA: czas do automatycznego startu (z danych).
 * Typografia kafelków jak w decyzjach (sekcja 13): tytuł i tekst w osobnych liniach.
 * Grafiki białe (monochrom, bez gradientów: uwaga właściciela 2026-11-06).
 */
import StoryChapter from '../StoryChapter.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { HTML_LANG } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { SKYTIMER_1_SPEC } from '../../../data/skytimer-1-spec.ts';
import { formatDuration } from '../../../lib/duration.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const story = getDictionary(locale).products['skytimer-1'].story;
const t = story.safety;
const dur = (ms: number) => formatDuration(ms, story.units, HTML_LANG[locale]);
const afa = {
  minutes: dur(SKYTIMER_1_SPEC.afa.afterMs),
  warning: dur(SKYTIMER_1_SPEC.afa.warningMs),
};

const tiles = [
  { id: 'playback', ...t.items.playback },
  { id: 'warnings', ...t.items.warnings },
  { id: 'rdt', ...t.items.rdt },
  { id: 'afa', title: t.items.afa.title, text: format(t.items.afa.text, afa) },
] as const;
---

<StoryChapter id="bezpieczenstwo" eyebrow={t.eyebrow} heading={t.heading} intro={t.intro}>
  <ul class="safety">
    {tiles.map((tile, i) => (
      <li class="safety__tile" style={`--i: ${i % 2}`} data-reveal>
        <div class={`safety__art safety__art--${tile.id}`} aria-hidden="true">
          {tile.id === 'playback' && (
            <>
              <span class="sig sig--long" />
              <span class="sig sig--long" />
              <span class="sig sig--short" />
            </>
          )}
          {tile.id === 'warnings' && (
            <>
              {Array.from({ length: 6 }, () => (
                <span class="sig sig--dot" />
              ))}
              <span class="sig__gap" />
              <span class="sig sig--short" />
              <span class="sig sig--long" />
            </>
          )}
          {tile.id === 'rdt' && (
            <svg viewBox="0 0 120 64">
              <circle cx="60" cy="52" r="5" />
              <path d="M46 40a20 20 0 0 1 28 0" />
              <path d="M35 29a35 35 0 0 1 50 0" />
              <path d="M24 18a50 50 0 0 1 72 0" />
            </svg>
          )}
          {tile.id === 'afa' && <span class="safety__number">{afa.minutes}</span>}
        </div>
        <h3 class="safety__title">{tile.title}</h3>
        <p class="safety__text">{tile.text}</p>
      </li>
    ))}
  </ul>
</StoryChapter>

<style>
  .safety {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
    list-style: none;
  }

  .safety__tile {
    padding: clamp(1.75rem, 1rem + 2.4vw, 3rem);
    border-radius: 1.75rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }

  /* Grafika: stała wysokość, więc tytuły w wierszu stoją na jednej linii. */
  .safety__art {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 4rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .sig {
    height: 0.625rem;
    border-radius: 999px;
    background: var(--color-text-on-dark);
  }

  .sig--long {
    width: 4rem;
  }

  .sig--short,
  .sig--dot {
    width: 0.625rem;
  }

  /* Sześć szybkich sygnałów: gęściej niż zwykłe. */
  .safety__art--warnings {
    gap: 0.3rem;
  }

  .safety__art--warnings .sig--long {
    width: 2.5rem;
  }

  .safety__art--warnings .sig--short {
    margin-right: 0.2rem;
  }

  .sig__gap {
    width: 1.25rem;
  }

  .safety__art svg {
    height: 80%;
    fill: none;
    stroke: var(--color-text-on-dark);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .safety__art circle {
    fill: var(--color-text-on-dark);
    stroke: none;
  }

  .safety__number {
    font-size: 3rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .safety__title {
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .safety__text {
    max-width: 26rem;
    margin-top: 0.625rem;
    color: var(--color-text-body-on-dark);
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.1875rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (max-width: 734px) {
    .safety {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Wejście raz; obok siebie kaskada 80 ms (jak kafelki wyróżników), na telefonie bez kaskady. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .safety__tile:not(:global(.is-in)) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .safety__tile {
      transition:
        opacity 700ms var(--ease-out) calc(var(--i) * 80ms),
        transform 700ms var(--ease-out) calc(var(--i) * 80ms);
    }

    @media (max-width: 734px) {
      .safety__tile {
        transition-delay: 0ms;
      }
    }
  }
</style>
