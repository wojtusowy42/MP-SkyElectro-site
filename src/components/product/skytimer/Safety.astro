---
/**
 * "Bezpieczeństwo": duże zdjęcie płytki + cztery funkcje (Anti Fly Away, RDT, odtwarzanie czasu,
 * ostrzeżenia). Scena czarna: render ma czarne tło, więc zdjęcie nie ma krawędzi.
 * Desktop: zdjęcie po lewej, lista po prawej. Telefon: zdjęcie nad listą.
 * Zdjęcie: klatka 102 obrotu (Raw Assets/Blender Renders/SkyTimer obrót 360/), przycięta jak sekwencja.
 */
import { Picture } from 'astro:assets';
import type { Locale } from '../../../i18n/locales.ts';
import { getDictionary } from '../../../i18n/index.ts';
import image from '../../../assets/renders/skytimer-1/poznaj/piny-pod-katem.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).products['skytimer-1'].story.safety;
---

<section class="safety" aria-labelledby="safety-title">
  <div class="safety__inner">
    <p class="safety__eyebrow">{t.eyebrow}</p>
    <h2 class="safety__title" id="safety-title">
      {t.heading}
    </h2>

    <div class="safety__grid">
      <div class="safety__media" data-reveal>
        <Picture
          class="safety__img"
          src={image}
          alt={t.imageAlt}
          formats={['avif', 'webp']}
          quality={80}
          widths={[600, 900, 1130]}
          sizes="(max-width: 899px) 100vw, 560px"
          loading="lazy"
        />
      </div>
      <ul class="safety__list" role="list">
        {t.items.map((item, i) => (
          <li class="safety__item" style={`--i: ${i}`} data-reveal>
            <h3 class="safety__item-title">{item.title}</h3>
            <p class="safety__item-text">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .safety {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
  }

  .safety__inner {
    max-width: calc(var(--content-wide) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(5rem, 11vw, 9rem) var(--gutter);
  }

  .safety__eyebrow,
  .safety__title {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .safety__eyebrow {
    margin-bottom: 0.75rem;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .safety__title {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .safety__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .safety__media :global(picture),
  .safety__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .safety__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .safety__item {
    padding-block: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .safety__item:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }

  .safety__item-title {
    font-size: clamp(1.3125rem, 1.15rem + 0.5vw, 1.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .safety__item-text {
    margin-top: 0.5rem;
    color: var(--color-text-2-on-dark);
    font-size: 1.125rem;
    line-height: 1.47;
    text-wrap: pretty;
  }

  @media (max-width: 899px) {
    .safety__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .safety__media {
      margin-inline: calc(-1 * var(--gutter));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .safety__media:not(.is-in),
    :global(.reveal-js) .safety__item:not(.is-in) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .safety__media,
    .safety__item {
      transition:
        opacity 900ms var(--ease-out),
        transform 900ms var(--ease-out);
    }

    .safety__item {
      transition-delay: calc(var(--i) * 90ms);
    }
  }
</style>
