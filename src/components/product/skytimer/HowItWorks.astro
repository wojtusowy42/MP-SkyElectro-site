---
/**
 * "Jak to działa": jeden duży akapit (wzór: bloki tekstu na stronach iPhone'a na apple.com).
 * Tekst szary, najważniejsze frazy białe. Mały nagłówek nad akapitem jak "nadtytuł" u Apple.
 * Scena ciemnoszara (--color-surface-dark) między czarnymi.
 *
 * Wejście: raz, gdy akapit wjeżdża na ekran, wyróżnione frazy rozjaśniają się kolejno
 * (bez JS i z ograniczeniem ruchu od razu białe). Fakty z podręcznika użytkownika.
 */
import type { Locale } from '../../../i18n/locales.ts';
import { getDictionary } from '../../../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).products['skytimer-1'].story.how;
let k = 0; // kolejność wyróżnień (opóźnienie rozjaśnienia)
---

<section class="how" aria-labelledby="how-title">
  <div class="how__inner">
    <h2 class="how__eyebrow" id="how-title">
      {t.heading}
    </h2>
    <p class="how__copy" data-reveal>
      {t.parts.map(([text, strong]) =>
        strong ? <strong style={`--k: ${k++}`}>{text}</strong> : text,
      )}
    </p>
  </div>
</section>

<style>
  .how {
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark);
  }

  .how__inner {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(6rem, 13vw, 11rem) var(--gutter);
  }

  .how__eyebrow {
    margin-bottom: 1.25rem;
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .how__copy {
    max-width: 54rem;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.75rem, 1.15rem + 2.3vw, 3rem);
    font-weight: 600;
    line-height: 1.17;
    letter-spacing: -0.026em;
    text-wrap: pretty;
  }

  .how__copy strong {
    font-weight: inherit;
    color: var(--color-text-on-dark);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .how__copy:not(.is-in) strong {
      color: var(--color-text-2-on-dark);
    }

    .how__copy strong {
      transition: color 700ms var(--ease-out);
      transition-delay: calc(200ms + var(--k) * 180ms);
    }
  }
</style>
