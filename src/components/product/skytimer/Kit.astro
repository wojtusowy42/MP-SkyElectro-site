---
/**
 * Rozdział "W zestawie" SkyTimer 1: siatka elementów, każdy ze zdjęciem, nazwą i jednym
 * krótkim zdaniem (dawny rozdział "Moduły" jest tu, żeby te same zdjęcia nie były dwa razy).
 * Bez cen: ceny są tylko na stronie Kup.
 * Rendery: Raw Assets/04 Rendery/SkyTimer 1/Learn more (v3)/ (Kafelek_k01-k11).
 */
import { Picture } from 'astro:assets';
import StoryChapter from '../StoryChapter.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { SKYTIMER_1_SPEC } from '../../../data/skytimer-1-spec.ts';
import type { ImageMetadata } from 'astro';

// Zdjęcia elementów: 01-...11-, w tej samej kolejności co t.items.
const tileImages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../../../assets/renders/skytimer-1/story/zestaw-elementy/*.jpg', { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).products['skytimer-1'].story.kit;
if (tileImages.length !== t.items.length) throw new Error(`Kit: ${tileImages.length} zdjęć elementów, ${t.items.length} pozycji`);
const fill = (text: string) => format(text, { mah: SKYTIMER_1_SPEC.batteryMah });
---

<StoryChapter id="zestaw" eyebrow={t.eyebrow} heading={t.heading} intro={t.intro}>
  <ul class="kit__grid">
    {t.items.map((item, i) => (
      <li class="kit__tile" data-reveal>
        <Picture class="kit__tile-img" src={tileImages[i]!} alt="" widths={[300, 500, 800]} sizes="(max-width: 734px) 45vw, 240px" formats={['avif', 'webp']} quality={80} loading="lazy" />
        <h3 class="kit__tile-name">{fill(item.name)}</h3>
        {item.note && <p class="kit__tile-note">{fill(item.note)}</p>}
      </li>
    ))}
  </ul>
</StoryChapter>

<style>
  /* elementy zestawu: zdjęcie, nazwa i jedno zdanie, żeby od razu było widać, co jest czym */
  .kit__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
    list-style: none;
  }

  .kit__tile {
    padding: clamp(0.75rem, 1.5vw, 1.25rem) clamp(0.75rem, 1.5vw, 1.25rem) clamp(1.25rem, 2vw, 1.75rem);
    border-radius: 1.25rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16); /* czarny kafelek ze zdjęciem: rendery mają czarne tło, więc mają pełny kontrast */
    text-align: center;
  }

  .kit__tile :global(.kit__tile-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .kit__tile-name {
    margin-top: 0.75rem;
    color: var(--color-text-on-dark);
    font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.0625rem);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .kit__tile-note {
    margin-top: 0.25rem;
    color: var(--color-text-body-on-dark); /* #a1a1a6 przy tak małym tekście znika na czerni */
    font-size: clamp(0.875rem, 0.8rem + 0.25vw, 0.9375rem);
    line-height: 1.35;
    text-wrap: balance;
  }

  @media (max-width: 734px) {
    .kit__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .kit__tile:not(:global(.is-in)) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .kit__tile {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }
  }
</style>
