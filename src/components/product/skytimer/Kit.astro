---
/**
 * Rozdział "W zestawie" SkyTimer 1 (wzór: "Co jest w pudełku" na apple.com): jedno zdjęcie
 * całego zestawu rozłożonego na płasko, obok lista: miniatura elementu, nazwa i jedno krótkie zdanie.
 * Miniatury, bo sama lista obok zdjęcia nie mówiła, co jest czym (uwaga właściciela 2026-11-08).
 * Bez kafelków (decyzja właściciela 2026-11-08). Bez cen: ceny są tylko na stronie Kup.
 * Rendery: Raw Assets/04 Rendery/SkyTimer 1/Learn more (v3)/ (zestaw poziomo).
 */
import { Picture } from 'astro:assets';
import StoryChapter from '../StoryChapter.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { SKYTIMER_1_SPEC } from '../../../data/skytimer-1-spec.ts';
import zestaw from '../../../assets/renders/skytimer-1/story/zestaw.jpg';
import type { ImageMetadata } from 'astro';

// Miniatury elementów: 01-...11-, w tej samej kolejności co t.items.
const thumbs = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../../../assets/renders/skytimer-1/story/zestaw-elementy/*.jpg', { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).products['skytimer-1'].story.kit;
if (thumbs.length !== t.items.length) throw new Error(`Kit: ${thumbs.length} miniatur, ${t.items.length} pozycji`);
const fill = (text: string) => format(text, { mah: SKYTIMER_1_SPEC.batteryMah });
const pictureProps = {
  formats: ['avif', 'webp'],
  quality: 80,
  loading: 'lazy' as const,
};
---

<StoryChapter id="zestaw" eyebrow={t.eyebrow} heading={t.heading} intro={t.intro}>
  <div class="kit">
    <Picture class="kit__img" src={zestaw} alt={t.alt} widths={[800, 1200, 1600, 2400]} sizes="(max-width: 1068px) 100vw, 680px" {...pictureProps} />

    <ul class="kit__list" aria-label={t.listLabel} data-reveal>
      {t.items.map((item, i) => (
        <li class="kit__item">
          <Picture class="kit__thumb" src={thumbs[i]!} alt="" widths={[96, 144]} sizes="48px" formats={['avif', 'webp']} quality={80} loading="lazy" />
          <span class="kit__text">
            <span class="kit__name">{fill(item.name)}</span>
            {item.note && <span class="kit__note">{fill(item.note)}</span>}
          </span>
        </li>
      ))}
    </ul>
  </div>
</StoryChapter>

<style>
  /*
   * Cały rozdział ma się mieścić na jednym ekranie (uwaga właściciela 2026-11-08):
   * na szerokim ekranie zdjęcie po lewej, lista obok w dwóch ciasnych kolumnach.
   */
  .kit {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
    max-width: calc(var(--content-wide) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .kit :global(.kit__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Lista jak spis w pudełku: kolumny, cienka linia nad każdą pozycją, bez ramek. */
  .kit__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Wiersz: miniatura (render na czerni, więc bez ramki) i obok nazwa ze zdaniem. */
  .kit__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  /* Stała szerokość, żeby nazwy zaczynały się w jednej linii. */
  .kit__item :global(picture) {
    flex: none;
    width: 3rem;
    height: 3rem;
  }

  /* Zdjęcia elementów mają szeroki czarny margines: powiększenie wycina go (tło i tak czarne). */
  .kit__item :global(.kit__thumb) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1.35);
  }

  .kit__text {
    display: grid;
    gap: 0.125rem;
  }

  .kit__name {
    color: var(--color-text-on-dark);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .kit__note {
    color: var(--color-text-body-on-dark); /* #a1a1a6 przy małym tekście znika na czerni */
    font-size: 0.8125rem;
    line-height: 1.35;
    text-wrap: pretty;
  }

  @media (min-width: 1069px) {
    .kit {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }

    .kit__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Telefon: bez dużego zdjęcia, miniatury i same nazwy w dwóch kolumnach. */
  @media (max-width: 734px) {
    .kit {
      gap: 1rem;
    }

    .kit__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }

    /* Miniatury mówią, co jest czym, więc duże zdjęcie na telefonie odpada (zmieści się jeden ekran). */
    .kit :global(.kit__img) {
      display: none;
    }

    .kit__item {
      gap: 0.5rem;
      padding-block: 0.375rem;
    }

    .kit__item :global(picture) {
      width: 2.75rem;
      height: 2.75rem;
    }

    .kit__name {
      font-size: 0.875rem;
    }

    .kit__note {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .kit__list:not(:global(.is-in)) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .kit__list {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }
  }
</style>
