---
/**
 * Rozdział "W zestawie" SkyTimer 1 (wzór: "Co jest w pudełku" na apple.com): jedno zdjęcie
 * całego zestawu rozłożonego na płasko, pod nim lista w kolumnach: nazwa i jedno krótkie zdanie.
 * Bez kafelków (decyzja właściciela 2026-11-08). Bez cen: ceny są tylko na stronie Kup.
 * Rendery: Raw Assets/04 Rendery/SkyTimer 1/Learn more (v3)/ (zestaw poziomo i pionowo).
 */
import { Picture } from 'astro:assets';
import StoryChapter from '../StoryChapter.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { SKYTIMER_1_SPEC } from '../../../data/skytimer-1-spec.ts';
import zestaw from '../../../assets/renders/skytimer-1/story/zestaw.jpg';
import zestawPion from '../../../assets/renders/skytimer-1/story/zestaw-pion.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).products['skytimer-1'].story.kit;
const fill = (text: string) => format(text, { mah: SKYTIMER_1_SPEC.batteryMah });
const pictureProps = {
  formats: ['avif', 'webp'],
  quality: 80,
  loading: 'lazy' as const,
};
---

<StoryChapter id="zestaw" eyebrow={t.eyebrow} heading={t.heading} intro={t.intro}>
  <div class="kit">
    {/* Na telefonie ten sam zestaw w pionie: poziomy jest tam za drobny. Ukryty obraz z loading=lazy się nie pobiera. */}
    <Picture class="kit__img kit__img--wide" src={zestaw} alt={t.alt} widths={[800, 1200, 1600, 2400]} sizes="(max-width: 734px) 100vw, 1200px" {...pictureProps} />
    <Picture class="kit__img kit__img--tall" src={zestawPion} alt={t.alt} widths={[600, 900, 1200]} sizes="100vw" {...pictureProps} />

    <ul class="kit__list" aria-label={t.listLabel} data-reveal>
      {t.items.map((item) => (
        <li class="kit__item">
          <span class="kit__name">{fill(item.name)}</span>
          {item.note && <span class="kit__note">{fill(item.note)}</span>}
        </li>
      ))}
    </ul>
  </div>
</StoryChapter>

<style>
  .kit {
    max-width: calc(var(--content-wide) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .kit :global(.kit__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .kit :global(.kit__img--tall) {
    display: none;
  }

  /* Lista jak spis w pudełku: kolumny, cienka linia nad każdą pozycją, bez ramek. */
  .kit__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    max-width: var(--content-max);
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    padding: 0;
    list-style: none;
  }

  .kit__item {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding-block: 1rem 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .kit__name {
    color: var(--color-text-on-dark);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .kit__note {
    color: var(--color-text-body-on-dark); /* #a1a1a6 przy małym tekście znika na czerni */
    font-size: 0.9375rem;
    line-height: 1.35;
    text-wrap: pretty;
  }

  @media (max-width: 1068px) {
    .kit__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 734px) {
    .kit :global(.kit__img--wide) {
      display: none;
    }

    .kit :global(.kit__img--tall) {
      display: block;
    }

    /* Telefon: jedna kolumna, ciaśniej. */
    .kit__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .kit__item {
      padding-block: 0.75rem 0.875rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .kit__list:not(:global(.is-in)) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .kit__list {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }
  }
</style>
