---
/**
 * Rozdział "W zestawie" SkyTimer 1 (wzór: "Co jest w pudełku" na apple.com): lista w kolumnach,
 * w każdym wierszu miniatura elementu, nazwa i jedno krótkie zdanie. Bez dużego zdjęcia całego
 * zestawu: obok miniatur pokazywało to samo drugi raz (uwagi właściciela 2026-11-08).
 * Bez kafelków (decyzja właściciela 2026-11-08). Bez cen: ceny są tylko na stronie Kup.
 * Rendery: Raw Assets/04 Rendery/SkyTimer 1/Learn more (v3)/ (Kafelek_k01-k11).
 */
import { Picture } from 'astro:assets';
import StoryChapter from '../StoryChapter.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { accessoryPath } from '../../../i18n/routes.ts';
import { accessoryForKitItem } from '../../../data/accessories.ts';
import { SKYTIMER_1_SPEC } from '../../../data/skytimer-1-spec.ts';
import type { ImageMetadata } from 'astro';

// Miniatury elementów: 01-...11-, w tej samej kolejności co t.items.
const thumbs = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../../../assets/renders/skytimer-1/story/zestaw-elementy/*.jpg', { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, m]) => ({ src: m.default, name: path.split('/').at(-1)!.replace(/^\d+-|\.jpg$/g, '') }));

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).products['skytimer-1'].story.kit;
if (thumbs.length !== t.items.length) throw new Error(`Kit: ${thumbs.length} miniatur, ${t.items.length} pozycji`);
const fill = (text: string) => format(text, { mah: SKYTIMER_1_SPEC.batteryMah });
// Pozycja, którą można kupić osobno, prowadzi do strony akcesorium.
const hrefOf = (name: string) => {
  const accessory = accessoryForKitItem(name);
  return accessory ? accessoryPath(locale, { accessory: accessory.id }) : undefined;
};
---

<StoryChapter id="zestaw" eyebrow={t.eyebrow} heading={t.heading} intro={t.intro}>
  <div class="kit">
    <ul class="kit__list" aria-label={t.listLabel} data-reveal>
      {t.items.map((item, i) => (
        <li>
          <a class="kit__item" href={hrefOf(thumbs[i]!.name)}>
          <Picture class="kit__thumb" src={thumbs[i]!.src} alt="" widths={[96, 160]} sizes="(max-width: 734px) 44px, 72px" formats={['avif', 'webp']} quality={80} loading="lazy" />
          <span class="kit__text">
            <span class="kit__name">{fill(item.name)}</span>
            {item.note && <span class="kit__note">{fill(item.note)}</span>}
          </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</StoryChapter>

<style>
  /* Cały rozdział ma się mieścić na jednym ekranie (uwaga właściciela 2026-11-08). */
  .kit {
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Lista jak spis w pudełku: kolumny, cienka linia nad każdą pozycją, bez ramek. */
  .kit__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Wiersz: miniatura (render na czerni, więc bez ramki) i obok nazwa ze zdaniem. */
  .kit__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  /* Stała szerokość, żeby nazwy zaczynały się w jednej linii. */
  .kit__item :global(picture) {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    overflow: hidden; /* powiększone zdjęcie nie zasłania linii nad wierszem */
  }

  /* Zdjęcia elementów mają szeroki czarny margines: powiększenie go wycina. */
  .kit__item :global(.kit__thumb) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1.25);
  }

  .kit__item {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .kit__item[href]:hover .kit__name {
      text-decoration: underline;
    }
  }

  .kit__text {
    display: grid;
    gap: 0.125rem;
  }

  .kit__name {
    color: var(--color-text-on-dark);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .kit__note {
    color: var(--color-text-body-on-dark); /* #a1a1a6 przy małym tekście znika na czerni */
    font-size: 0.875rem;
    line-height: 1.35;
    text-wrap: pretty;
  }

  @media (max-width: 1068px) {
    .kit__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Telefon: mniejsze miniatury i same nazwy w dwóch kolumnach. */
  @media (max-width: 734px) {
    .kit__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }

    .kit__item {
      gap: 0.5rem;
      padding-block: 0.375rem;
    }

    .kit__item :global(picture) {
      width: 2.75rem;
      height: 2.75rem;
    }

    .kit__name {
      font-size: 0.875rem;
    }

    .kit__note {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .kit__list:not(:global(.is-in)) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .kit__list {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
    }
  }
</style>
