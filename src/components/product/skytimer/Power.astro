---
/**
 * Rozdział "Zasilanie" SkyTimer 1 (wzór: rozdział "Bateria" na stronie MacBooka Pro z PROLED XDR:
 * nagłówek, render akumulatora i ładowarki, ramka z trzema liczbami).
 * Liczby z danych (src/data/skytimer-1-spec.ts), teksty ze słownika.
 */
import { Picture } from 'astro:assets';
import StoryChapter from '../StoryChapter.astro';
import StatGrid, { type Stat } from '../StatGrid.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { SKYTIMER_1_SPEC } from '../../../data/skytimer-1-spec.ts';
import zasilanie from '../../../assets/renders/skytimer-1/story/zasilanie.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const story = getDictionary(locale).products['skytimer-1'].story;
const t = story.power;
const s = t.stats;

const stats: Stat[] = [
  {
    label: s.battery.label,
    value: format(s.battery.value, { n: SKYTIMER_1_SPEC.batteryMah }),
    caption: s.battery.caption,
  },
  { label: s.charger.label, value: s.charger.value, caption: s.charger.caption },
  {
    label: s.saving.label,
    value: format(story.units.times, { n: SKYTIMER_1_SPEC.ledSlowdownAfterHour }),
    caption: s.saving.caption,
  },
];
---

<StoryChapter id="zasilanie" eyebrow={t.eyebrow} heading={t.heading} intro={t.intro}>
  <Picture
    class="power__img"
    src={zasilanie}
    alt={t.alt}
    widths={[800, 1200, 1600, 2000]}
    sizes="(max-width: 734px) 100vw, 720px"
    formats={['avif', 'webp']}
    quality={80}
    loading="lazy"
  />
  <StatGrid stats={stats} variant="box" />
</StoryChapter>

<style>
  :global(.power__img) {
    width: min(100% - 2 * var(--gutter), 45rem);
    height: auto;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
  }
</style>
