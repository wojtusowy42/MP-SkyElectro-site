---
/**
 * "Przyjrzyj się bliżej" dla SkyTimer 1: ustawienia sekwencji obrotu + teksty ze słownika.
 *
 * Klatki: render z Blendera (scena SkyTimer_Anim_Zlozenie, kamera Kadr_Obrot, skrypt kadr_obrot.py),
 * 120 klatek co 3°, oryginały w Raw Assets/Blender Renders/SkyTimer obrót 360/.
 * Na stronie: public/sequence/skytimer-1/obrot/<szerokość>/<numer>.webp (przycięte 1130 × 908, WebP).
 * Widoki: klatka 0 = elektronika (z góry), 15 = złącze pod kątem 45°, 60 = przełączniki DIP.
 *
 * Opisy (callouts): x, y = punkt na klatce (0-1 od lewego górnego rogu przyciętej klatki),
 * side = po której stronie płytki stoi podpis. Punkty elementów 3D (ATmega, rezonator, złącze,
 * przełączniki) w widokach 0 i 60 policzone rzutem obiektów przez kamerę obrotu w Blenderze;
 * elementy nadruku (numery przełączników, napis ON, zworki JP1/JP2) i widok 15 odczytane
 * z wyrenderowanych klatek.
 */
import CloserLookBase, { type CloserLookView } from '../CloserLook.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { getProduct } from '../../../data/products/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const story = getDictionary(locale).products['skytimer-1'].story;
const t = story.closer;
const physical = getProduct('skytimer-1')?.physical;
if (!physical) throw new Error('Brak wymiarów i masy (physical) w danych skytimer-1');
const [short, long] = physical.sizeMm;
const intro = format(story.design.intro, { short, long, weight: physical.weightG });

const FRAMES = {
  path: '/sequence/skytimer-1/obrot',
  count: 120,
  widths: [720, 1130], // dostępne zestawy klatek
  aspect: 1130 / 908, // proporcje przyciętej klatki
};

type Side = 'left' | 'right';
type Pos = {
  x: number;
  y: number;
  side: Side;
  span?: [number, number];
  focus?: { x: number; y: number; rx: number; ry: number };
};
const VIEWS = {
  electronics: {
    frame: 0,
    callouts: {
      mcu: { x: 0.5, y: 0.385, side: 'left', focus: { x: 0.5, y: 0.37, rx: 0.21, ry: 0.17 } },
      connector: {
        x: 0.3,
        y: 0.572,
        side: 'left',
        focus: { x: 0.465, y: 0.6, rx: 0.33, ry: 0.11 },
      },
      resonator: {
        x: 0.727,
        y: 0.3,
        side: 'right',
        focus: { x: 0.727, y: 0.3, rx: 0.07, ry: 0.11 },
      },
      jumpers: {
        x: 0.865,
        y: 0.555,
        side: 'right',
        focus: { x: 0.865, y: 0.555, rx: 0.07, ry: 0.12 },
      },
    },
  },
  // Pod kątem 45°: widać jednocześnie obudowę złącza, piny i płytkę (bok "na krawędź" był nieczytelny).
  connector: {
    frame: 15,
    callouts: {
      pins: { x: 0.3, y: 0.265, side: 'left', focus: { x: 0.45, y: 0.3, rx: 0.24, ry: 0.11 } },
      header: { x: 0.58, y: 0.585, side: 'right', focus: { x: 0.4, y: 0.57, rx: 0.3, ry: 0.09 } },
    },
  },
  switches: {
    frame: 60,
    callouts: {
      // Klamry pod numerami: przełączniki 1-4 i 5-10 (numery na wysokości y ≈ 0.60).
      on: { x: 0.095, y: 0.43, side: 'left', focus: { x: 0.15, y: 0.43, rx: 0.08, ry: 0.06 } },
      flop: {
        x: 0.2755,
        y: 0.665,
        side: 'left',
        span: [0.134, 0.417],
        focus: { x: 0.2755, y: 0.55, rx: 0.19, ry: 0.15 },
      },
      dether: {
        x: 0.649,
        y: 0.665,
        side: 'right',
        span: [0.432, 0.866],
        focus: { x: 0.649, y: 0.55, rx: 0.27, ry: 0.15 },
      },
    },
  },
} satisfies Record<string, { frame: number; callouts: Record<string, Pos> }>;

const views: CloserLookView[] = (Object.keys(VIEWS) as (keyof typeof VIEWS)[]).map((id) => {
  const texts = t.views[id];
  const callouts = texts.callouts as Record<string, { title: string; text: string }>;
  return {
    id,
    label: texts.label,
    frame: VIEWS[id].frame,
    callouts: Object.entries(VIEWS[id].callouts as Record<string, Pos>).map(([key, pos]) => {
      const c = callouts[key];
      if (!c) throw new Error(`Brak tekstu opisu ${id}.${key} w słowniku`);
      return { ...pos, title: c.title, text: c.text };
    }),
  };
});
---

<CloserLookBase
  eyebrow={story.design.eyebrow}
  heading={t.heading}
  intro={intro}
  hint={t.hint}
  stageLabel={t.stageLabel}
  valueText={t.valueText}
  viewsLabel={t.viewsLabel}
  views={views}
  frames={FRAMES.path}
  count={FRAMES.count}
  widths={FRAMES.widths}
  aspect={FRAMES.aspect}
/>
