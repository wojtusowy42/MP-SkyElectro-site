---
/**
 * Zakończenie jasnych stron "Dowiedz się więcej" (jak "Kup" na końcu stron Apple): render, hasło, krótki tekst, przycisk Kup.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  heading: string;
  text: string;
  href: string;
  label: string;
}

const { image, alt, heading, text, href, label } = Astro.props;
---

<section class="buy" aria-labelledby="kup-title">
  <Picture
    class="buy__img"
    src={image}
    alt={alt}
    widths={[600, 1000, 1400]}
    sizes="(max-width: 734px) 90vw, 640px"
    formats={['avif', 'webp']}
    quality={80}
    loading="lazy"
  />
  <h2 class="buy__heading" id="kup-title">{heading}</h2>
  <p class="buy__text">{text}</p>
  <a class="button button--primary" href={href}>{label}</a>
</section>

<style>
  .buy {
    display: grid;
    justify-items: center;
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin: clamp(5rem, 10vw, 8rem) auto 0;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .buy :global(.buy__img) {
    display: block;
    width: min(100%, 640px);
    height: auto;
  }

  .buy__heading {
    margin-top: 1.5rem;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .buy__text {
    margin: 0.75rem 0 1.75rem;
    color: var(--color-text-2);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
  }
</style>
