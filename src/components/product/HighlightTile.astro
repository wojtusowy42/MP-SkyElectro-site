---
/**
 * Jeden kafelek w siatce wyróżników (wzór: kafelki "Poznaj..." na apple.com).
 * Czarna karta na ciemnoszarym tle sekcji.
 *
 * Tekst jak u Apple: JEDEN akapit wyrównany do lewej, fraza wiodąca biała (title),
 * dopowiedzenie szare (text), oba tym samym pogrubionym krojem. Rozmiar zależy od
 * szerokości kafelka (container query): szeroki kafelek ok. 28 px, wąski 19 px.
 * W HTML to nagłówek h3 + akapit, wyświetlane w jednej linii (czytnik ekranu dostaje nagłówek).
 *
 * span: szerokość w siatce 6-kolumnowej (desktop):
 *   full = cały wiersz, two-thirds = 4/6, half = 3/6, third = 2/6.
 * Na telefonie każdy kafelek ma pełną szerokość.
 *
 * layout:
 *   stack (domyślnie) = [before] → tekst → obraz od krawędzi do krawędzi u dołu,
 *   split = tekst po lewej, obraz po prawej (desktop; na telefonie jak stack).
 *
 * Slot domyślny (obraz) sięga do krawędzi karty, jak zdjęcia u Apple; rendery mają
 * czarne tło (#000) jak karta, więc krawędzi obrazu nie widać.
 * Slot "before": element NAD tekstem (np. duża liczba).
 */
interface Props {
  span: 'full' | 'two-thirds' | 'half' | 'third';
  title: string;
  text?: string | undefined;
  layout?: 'stack' | 'split';
  /** Kolejność w siatce: opóźnia wejście kafelka (90 ms na pozycję, tylko desktop). */
  index?: number;
}

const { span, title, text, layout = 'stack', index = 0 } = Astro.props;
const hasVisual = Astro.slots.has('default');
---

<article
  class:list={['tile', `tile--${span}`, `tile--${layout}`, { 'tile--text': !hasVisual }]}
  style={`--i: ${index}`}
  data-reveal
>
  <div class="tile__head">
    {Astro.slots.has('before') && (
      <div class="tile__before">
        <slot name="before" />
      </div>
    )}
    <div class="tile__copy">
      <h3 class="tile__title">{title}</h3>
      {text && (
        <>
          {' '}
          <p class="tile__text">{text}</p>
        </>
      )}
    </div>
  </div>
  {hasVisual && (
    <div class="tile__visual">
      <slot />
    </div>
  )}
</article>

<style>
  .tile {
    /* Odstęp od krawędzi karty; obraz znosi go ujemnym marginesem. */
    --pad: clamp(1.75rem, 1rem + 2.4vw, 3rem);

    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
    padding: var(--pad) var(--pad) 0;
    border-radius: 1.75rem;
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    container-type: inline-size;
    isolation: isolate;
  }

  .tile--full {
    grid-column: span 6;
  }

  .tile--two-thirds {
    grid-column: span 4;
  }

  .tile--half {
    grid-column: span 3;
  }

  .tile--third {
    grid-column: span 2;
  }

  /* Kafelek bez obrazu: treść od góry. Kafelki tekstowe w jednym wierszu mają wtedy
     liczby i teksty na tych samych wysokościach. */
  .tile--text {
    padding-bottom: var(--pad);
  }

  .tile__before {
    margin-bottom: 1rem;
  }

  /* Jeden akapit: biała fraza + szare dopowiedzenie. */
  .tile__copy {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    color: var(--color-text-2-on-dark);
    font-size: clamp(1.1875rem, 4.4cqi, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.016em;
    text-wrap: pretty;
  }

  .tile__title,
  .tile__text {
    display: inline;
    font: inherit;
    letter-spacing: inherit;
  }

  .tile__title {
    color: var(--color-text-on-dark);
  }

  /* Obraz od krawędzi do krawędzi: ujemny margines znosi boczny padding karty. */
  .tile__visual {
    position: relative;
    display: grid;
    flex: 1;
    min-height: 0;
    margin-inline: calc(-1 * var(--pad));
    place-items: center;
  }

  /* Tekst po lewej, obraz po prawej (np. rozmiar płytki z wymiarami). */
  @media (min-width: 735px) {
    .tile--split {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: var(--pad);
      padding-bottom: var(--pad);
    }

    .tile--split .tile__visual {
      margin: 0 calc(-1 * var(--pad)) 0 0;
    }
  }

  @media (max-width: 734px) {
    .tile,
    .tile--full,
    .tile--two-thirds,
    .tile--half,
    .tile--third {
      grid-column: auto;
    }

    .tile {
      border-radius: 1.5rem;
    }
  }

  /* Wejście: raz, gdy kafelek wjeżdża na ekran (skrypt w ProductStory dodaje .is-in). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .tile:not(.is-in) {
      opacity: 0;
      transform: translateY(2rem) scale(0.98);
    }

    .tile {
      transition:
        opacity 900ms var(--ease-out),
        transform 900ms var(--ease-out);
      transition-delay: calc(var(--i) * 90ms);
    }

    /* Telefon: jedna kolumna, każdy kafelek wjeżdża sam, więc kaskada tylko by opóźniała. */
    @media (max-width: 734px) {
      .tile {
        transition-delay: 0ms;
      }
    }
  }
</style>
