---
/**
 * Jeden kafelek w siatce wyróżników (wzór: "Poznaj MacBooka Pro" na apple.com).
 * Czarna karta na ciemnoszarym tle sekcji, wyśrodkowany nagłówek u góry,
 * pod nim (opcjonalnie) jedno zdanie, a niżej obraz/grafika ze slotu, która wypełnia resztę.
 *
 * span: szerokość w siatce 6-kolumnowej (desktop):
 *   full = cały wiersz, two-thirds = 4/6, half = 3/6, third = 2/6.
 * Na telefonie każdy kafelek ma pełną szerokość.
 *
 * Slot domyślny (obraz) sięga do lewej, prawej i dolnej krawędzi karty, jak zdjęcia u Apple.
 * Rendery mają czarne tło (#000) jak karta, więc krawędzi obrazu nie widać.
 * Slot "before": element NAD nagłówkiem (np. duża liczba). Kafelek bez obrazu
 * (pusty slot domyślny) ma treść wyśrodkowaną w pionie.
 */
interface Props {
  span: 'full' | 'two-thirds' | 'half' | 'third';
  title: string;
  text?: string | undefined;
  /** Kolejność w siatce: opóźnia wejście kafelka (90 ms na pozycję). */
  index?: number;
}

const { span, title, text, index = 0 } = Astro.props;
const hasVisual = Astro.slots.has('default');
---

<article
  class:list={['tile', `tile--${span}`, { 'tile--text': !hasVisual }]}
  style={`--i: ${index}`}
  data-reveal
>
  {Astro.slots.has('before') && (
    <div class="tile__before">
      <slot name="before" />
    </div>
  )}
  <div class="tile__copy">
    <h3 class="tile__title">{title}</h3>
    {text && <p class="tile__text">{text}</p>}
  </div>
  {hasVisual && (
    <div class="tile__visual">
      <slot />
    </div>
  )}
</article>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
    padding: 2.5rem 2.5rem 0;
    border-radius: 1.75rem;
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    text-align: center;
    isolation: isolate;
  }

  .tile--full {
    grid-column: span 6;
  }

  .tile--two-thirds {
    grid-column: span 4;
  }

  .tile--half {
    grid-column: span 3;
  }

  .tile--third {
    grid-column: span 2;
  }

  /* Kafelek bez obrazu: treść od góry, nie wyśrodkowana w pionie. Dwa kafelki tekstowe w jednym
     wierszu mają wtedy tytuły na tej samej wysokości, nawet gdy jeden tytuł łamie się na 2 linie. */
  .tile--text {
    justify-content: flex-start;
    padding-block: 3rem;
  }

  .tile__before {
    display: grid;
    place-items: center;
    margin-bottom: 1.25rem;
  }

  .tile__copy {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    margin-inline: auto;
  }

  .tile--full .tile__copy {
    max-width: 42rem;
  }

  .tile__title {
    font-size: clamp(1.5rem, 1.25rem + 0.8vw, 2rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .tile--text .tile__title {
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    line-height: 1.08;
    letter-spacing: -0.028em;
  }

  .tile__text {
    margin-top: 0.75rem;
    color: var(--color-text-2-on-dark);
    font-size: 1.0625rem;
    line-height: 1.42;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }

  /* Obraz od krawędzi do krawędzi: ujemny margines znosi boczny padding karty. */
  .tile__visual {
    position: relative;
    display: grid;
    flex: 1;
    min-height: 0;
    margin-inline: -2.5rem;
    place-items: center;
  }

  @media (max-width: 734px) {
    .tile,
    .tile--full,
    .tile--two-thirds,
    .tile--half,
    .tile--third {
      grid-column: auto;
    }

    .tile {
      padding: 2rem 1.5rem 0;
      border-radius: 1.5rem;
    }

    .tile--text {
      padding-bottom: 2rem;
    }

    .tile__visual {
      margin-inline: -1.5rem;
    }
  }

  /* Wejście: raz, gdy kafelek wjeżdża na ekran (skrypt w siatce dodaje .is-in). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .tile:not(.is-in) {
      opacity: 0;
      transform: translateY(2rem) scale(0.98);
    }

    .tile {
      transition:
        opacity 900ms var(--ease-out),
        transform 900ms var(--ease-out);
      transition-delay: calc(var(--i) * 90ms);
    }

    /* Telefon: jedna kolumna, każdy kafelek wjeżdża sam, więc kaskada tylko by opóźniała. */
    @media (max-width: 734px) {
      .tile {
        transition-delay: 0ms;
      }
    }
  }
</style>
