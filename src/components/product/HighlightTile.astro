---
/**
 * Jeden kafelek w siatce wyróżników (wzór: kafelki "Poznaj..." na apple.com).
 * Biała karta na jasnym tle sekcji (#F6F5F8), ciemny tekst. Kolory z tokenów jasnych,
 * do nadpisania zmiennymi --tile-bg, --tile-fg, --tile-fg-2 (np. dla ciemnej sekcji).
 *
 * Czytelność przede wszystkim: tytuł (pogrubiony) i tekst (zwykły) w osobnych liniach,
 * wyrównane do lewej, oba w kolorze tekstu (hierarchię robi rozmiar i grubość, nie szarość),
 * jedna stała skala w całej sekcji: tytuł 24-32 px, tekst 17-21 px, interlinia 1,45,
 * najwyżej ok. 42 znaki w linii.
 *
 * span: szerokość w siatce 6-kolumnowej (desktop): full = cały wiersz, half = 3/6.
 * Na telefonie każdy kafelek ma pełną szerokość.
 *
 * layout:
 *   stack (domyślnie) = [before] → tytuł i tekst → obraz od krawędzi do krawędzi u dołu,
 *   split = tekst po lewej, obraz po prawej (desktop; na telefonie jak stack).
 *
 * Slot domyślny (obraz) sięga do krawędzi karty, jak zdjęcia u Apple; rendery mają
 * białe tło jak karta, więc krawędzi obrazu nie widać.
 * Slot "before": element NAD tytułem (np. duża liczba). Slot "after": pod tekstem (np. lista).
 */
interface Props {
  span: 'full' | 'half';
  title: string;
  text?: string | undefined;
  layout?: 'stack' | 'split';
  /** Pozycja w wierszu: kafelek obok wjeżdża 80 ms później (tylko desktop). */
  index?: number;
}

const { span, title, text, layout = 'stack', index = 0 } = Astro.props;
const hasVisual = Astro.slots.has('default');
---

<article
  class:list={['tile', `tile--${span}`, `tile--${layout}`, { 'tile--text': !hasVisual }]}
  style={`--i: ${index}`}
  data-reveal
>
  <div class="tile__head">
    {Astro.slots.has('before') && (
      <div class="tile__before">
        <slot name="before" />
      </div>
    )}
    <h3 class="tile__title">{title}</h3>
    {text && <p class="tile__text">{text}</p>}
    {Astro.slots.has('after') && (
      <div class="tile__after">
        <slot name="after" />
      </div>
    )}
  </div>
  {hasVisual && (
    <div class="tile__visual">
      <slot />
    </div>
  )}
</article>

<style>
  .tile {
    /* Odstęp od krawędzi karty; obraz znosi go ujemnym marginesem. */
    --pad: clamp(1.75rem, 0.9rem + 2.8vw, 3.5rem);

    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
    padding: var(--pad) var(--pad) 0;
    border-radius: 1.75rem;
    background: var(--tile-bg, var(--color-surface));
    color: var(--tile-fg, var(--color-text));
    isolation: isolate;
  }

  .tile--full {
    grid-column: span 6;
  }

  .tile--half {
    grid-column: span 3;
  }

  .tile--text {
    padding-bottom: var(--pad);
  }

  .tile__head {
    position: relative;
    z-index: 1;
  }

  .tile__before {
    margin-bottom: 1.5rem;
  }

  .tile__title {
    max-width: 24ch;
    font-size: clamp(1.5rem, 1.15rem + 1.1vw, 2rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .tile__text {
    max-width: 42ch;
    margin-top: 0.75rem;
    color: var(--tile-fg-2, var(--color-text));
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.3125rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .tile__after {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* Obraz od krawędzi do krawędzi: ujemny margines znosi boczny padding karty. */
  .tile__visual {
    position: relative;
    display: grid;
    flex: 1;
    min-height: 0;
    margin-inline: calc(-1 * var(--pad));
    place-items: center;
  }

  /* Tekst po lewej (węższa kolumna), obraz po prawej. */
  @media (min-width: 735px) {
    .tile--split {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
      gap: var(--pad);
      padding-bottom: var(--pad);
    }

    .tile--split .tile__visual {
      margin: 0;
    }
  }

  @media (max-width: 734px) {
    .tile,
    .tile--full,
    .tile--half {
      grid-column: auto;
    }

    .tile {
      border-radius: 1.5rem;
    }
  }

  /* Wejście: raz, gdy kafelek wjeżdża na ekran (skrypt w ProductStory dodaje .is-in).
     Krótko i bez skalowania: treść ma być czytelna od razu, ruch tylko ją podaje. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-js) .tile:not(.is-in) {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    .tile {
      transition:
        opacity 700ms var(--ease-out),
        transform 700ms var(--ease-out);
      transition-delay: calc(var(--i) * 80ms);
    }

    /* Telefon: jedna kolumna, każdy kafelek wjeżdża sam. */
    @media (max-width: 734px) {
      .tile {
        transition-delay: 0ms;
      }
    }
  }
</style>
