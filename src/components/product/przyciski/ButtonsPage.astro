---
/**
 * Strona "Dowiedz się więcej" przycisków pojemnościowych. Jasna, kafelkowa: układ jak apple.com/pl/ipad-mini
 * (hero → "Co go wyróżnia" w kaflach → porównanie modeli → Kup).
 * Kafle: szerokie jeden pod drugim, krótsze parami. Wszystkie obrazy to rendery:
 *   Raw Assets/03 Modele 3D/Blender/rendery_przyciski_strona.py (płytki, przewody, klasyczny, moduł zasilania),
 *   Raw Assets/04 Rendery/Przyciski/palec_warstwa.py (palec ze zdjęcia: kafel "dotyk").
 *
 * Hero: wideo z Blendera (ujęcie "srednice-anim", Raw Assets/04 Rendery/Przyciski/hero_na_strone.sh): płytki 12, 16 i 20 mm
 * kolejno wsuwają się po podłodze i zatrzymują w schodkach polem TOUCH do góry. Odtwarza się raz i zostaje na ostatniej klatce.
 * Pod wideo ostatnia klatka jako obraz: bez JS, z ograniczeniem ruchu albo przy zablokowanym autoplay widać ją od razu.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import LocalNav from '../LocalNav.astro';
import LightSection from '../LightSection.astro';
import FeatureTiles from '../FeatureTiles.astro';
import LightBuy from '../LightBuy.astro';
import type { Locale } from '../../../i18n/locales.ts';
import { format, getDictionary } from '../../../i18n/index.ts';
import { configuratorPath } from '../../../i18n/routes.ts';
import { przyciski } from '../../../data/products/przyciski.ts';
import heroLanded from '../../../assets/renders/przyciski/hero-srednice-anim.jpg';
import touchImage from '../../../assets/renders/przyciski/dotyk.jpg';
import edgeImage from '../../../assets/renders/przyciski/krawedz.png';
import sizesImage from '../../../assets/renders/przyciski/srednice.png';
import classicImage from '../../../assets/renders/przyciski/klasyczny.png';
import wiresImage from '../../../assets/renders/przyciski/przewody.png';
import powerImage from '../../../assets/renders/przyciski/zasilanie.png';
import size12 from '../../../assets/renders/przyciski/srednica-12.png';
import size16 from '../../../assets/renders/przyciski/srednica-16.png';
import size20 from '../../../assets/renders/przyciski/srednica-20.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const texts = dict.products['przyciski-pojemnosciowe'];
const t = texts.story;
const buyHref = configuratorPath(locale, 'przyciski-pojemnosciowe');

// Średnice z opcji konfiguratora ('d12' → 12), żeby strona nie rozjechała się z ofertą.
const SIZE_IMAGES: Record<number, ImageMetadata> = { 12: size12, 16: size16, 20: size20 };
const diameters = (przyciski.configurator?.steps[0]?.options ?? []).map((o) => ({
  id: o.id as keyof typeof t.sizes.items,
  mm: Number(o.id.slice(1)),
}));
for (const d of diameters) {
  if (!t.sizes.items[d.id] || !SIZE_IMAGES[d.mm]) {
    throw new Error(`Średnica ${d.id}: brak tekstu w story.sizes.items albo renderu srednica-${d.mm}.png`);
  }
}

const tl = t.highlights.tiles;
// Kolejność kafli; wide = na całą szerokość, reszta parami. fade: dłoń urywa się na krawędzi obrazu.
const tiles = (
  [
    { id: 'hold', image: touchImage, wide: true, fade: true },
    { id: 'flat', image: edgeImage },
    { id: 'sizes', image: sizesImage },
    { id: 'early', image: classicImage, wide: true },
    { id: 'wires', image: wiresImage },
    { id: 'skytimer', image: powerImage },
  ] satisfies { id: keyof typeof tl; image: ImageMetadata; wide?: boolean; fade?: boolean }[]
).map((tile) => ({ ...tile, ...tl[tile.id] }));
---

<div class="buttons" data-theme="light">
  <LocalNav
    title={texts.name}
    label={t.localNavLabel}
    links={[
      { label: t.localLinks.overview, href: '#przeglad' },
      { label: t.localLinks.sizes, href: '#srednice' },
    ]}
    orderHref={buyHref}
    orderLabel={dict.common.buy}
  />

  <section class="hero">
    <h1 class="hero__name">{texts.name}</h1>
    <p class="hero__tagline">{t.tagline}</p>
    <div class="hero__stage">
      <Picture
        class="hero__img"
        src={heroLanded}
        alt={t.heroAlt}
        widths={[800, 1280, 1920, 2880]}
        sizes="(max-width: 47.99em) 180vw, 100vw"
        formats={['avif', 'webp']}
        quality={82}
        loading="eager"
      />
      <video class="hero__video" muted playsinline preload="auto" aria-hidden="true" data-hero-video>
        <!-- 2880: ekrany o gęstości od 1,5 (laptopy ze skalowaniem, telefony): przy 1920 napisy na płytkach były rozmyte -->
        <source src="/video/przyciski/srednice-anim-2880.webm" type='video/webm; codecs="av01.0.12M.08"' media="(min-resolution: 1.5dppx)" />
        <source src="/video/przyciski/srednice-anim-2880.mp4" type="video/mp4" media="(min-resolution: 1.5dppx)" />
        <source src="/video/przyciski/srednice-anim-1920.webm" type='video/webm; codecs="av01.0.09M.08"' />
        <source src="/video/przyciski/srednice-anim-1920.mp4" type="video/mp4" />
      </video>
    </div>
    <a class="button button--primary" href={buyHref}>{dict.common.buy}</a>
  </section>

  <LightSection id="przeglad" heading={t.highlights.heading}>
    <FeatureTiles tiles={tiles} />
  </LightSection>

  <LightSection id="srednice" heading={t.sizes.heading} lead={t.sizes.lead}>
    <ul class="sizes" role="list">
      {diameters.map((d) => (
        <li class="sizes__card">
          {/* Wszystkie trzy w tej samej skali (kamera dopasowana do 20 mm). */}
          <Picture
            class="sizes__img"
            src={SIZE_IMAGES[d.mm]!}
            alt={format(t.sizes.alt, { d: d.mm })}
            widths={[400, 700, 1000]}
            sizes="(max-width: 734px) 80vw, 300px"
            formats={['avif', 'webp']}
            quality={80}
            loading="lazy"
          />
          <p class="sizes__title">{format(t.sizes.field, { d: d.mm })}</p>
          <p class="sizes__text">{t.sizes.items[d.id]}</p>
          <a class="button button--primary" href={buyHref}>{dict.common.buy}</a>
        </li>
      ))}
    </ul>
  </LightSection>

  <LightBuy
    image={sizesImage}
    alt={t.buy.alt}
    heading={t.buy.heading}
    text={t.buy.text}
    href={buyHref}
    label={dict.common.buy}
  />
</div>

<script>
  // Wideo przykrywa obraz dopiero, gdy da się je odtworzyć (pierwsza klatka: pusta podłoga), i rusza po krótkiej chwili.
  // Ostatnia klatka = obraz pod spodem, więc po zakończeniu nic nie przeskakuje.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const start = () => {
      video.classList.add('is-shown');
      setTimeout(() => video.play().catch(() => video.classList.remove('is-shown')), 600);
    };
    if (video.readyState >= 3) start();
    else video.addEventListener('canplaythrough', start, { once: true });
    video.addEventListener('error', () => video.classList.remove('is-shown'), true);
  }
</script>

<style>
  .buttons {
    --button-fill: var(--color-text);
    --button-ink: var(--color-surface);
    --button-fill-hover: #000;
    --button-line: var(--color-text);
    padding-bottom: clamp(5rem, 10vw, 8rem);
    /* Jasnoszare tło jak u Apple, dokładnie kolor tła renderów hero: zdjęcie nie ma krawędzi, białe kafle odcinają się od tła. */
    background: #f6f6f6;
    color: var(--color-text);
    overflow-x: clip; /* hero 100vw z paskiem przewijania byłoby szersze od strony */
  }

  .sizes {
    padding-left: 0;
    list-style: none;
  }

  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    justify-items: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
  }

  /* Nagłówek, animacja i Kup na jednym ekranie: scena dostaje wysokość, która zostaje pod paskami (44 px + pasek produktu). */
  @media (min-width: 48em) {
    .hero {
      min-height: calc(100svh - 2.75rem - var(--local-nav-height));
    }
  }

  .hero__name {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .hero__tagline {
    margin-top: 0.5rem;
    font-size: clamp(2.5rem, 1.4rem + 4.6vw, 4.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* Na całą szerokość ekranu: płytki wjeżdżają zza krawędzi ekranu, a nie zza niewidocznej linii w połowie strony.
     Kadr 3:1 przycinany (cover) do wysokości, która zostaje: płytki z cieniem leżą w pasie 38-71% wysokości kadru, więc niski ekran
     ucina tylko pustą podłogę (min. 15% szerokości = 45% kadru). Na telefonie scena jest wyższa niż 1/3 szerokości:
     cover ucina boki i płytki wychodzą większe. */
  .hero__stage {
    --stage-w: min(100vw, 1920px);
    position: relative;
    align-self: center;
    width: var(--stage-w);
    height: min(60vw, 18.75rem); /* telefon: hero bez min-height, wysokość wprost */
    min-height: calc(var(--stage-w) * 0.15);
    max-height: max(calc(var(--stage-w) / 3), min(60vw, 18.75rem));
    --stage-gap: clamp(1rem, 3vw, 2rem);
    margin-block: var(--stage-gap);
    overflow: hidden;
  }

  .hero__stage :global(.hero__img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 47% 57%; /* płytki z cieniem: x 26-69%, y 38-71% kadru; przy cięciu zostaje równy margines */
  }

  /* Wideo leży na obrazie w tym samym kadrze; widoczne dopiero przy odtwarzaniu (skrypt). */
  .hero__video {
    opacity: 0;
  }

  @media (min-width: 48em) {
    .hero__stage {
      height: calc(100% - 2 * var(--stage-gap)); /* cały wolny wiersz siatki hero, w granicach min/max */
    }
  }

  .hero__video:global(.is-shown) {
    opacity: 1;
  }

  /* ---------- Porównaj średnice ---------- */
  .sizes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .sizes__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem 1.5rem 2.5rem;
    border-radius: 1.75rem;
    background: var(--color-surface);
    text-align: center;
  }

  .sizes__card :global(.sizes__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .sizes__title {
    margin-top: 1rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .sizes__text {
    flex: 1;
    margin: 0.5rem 0 1.75rem;
    color: var(--color-text-2);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  @media (max-width: 734px) {
    .sizes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
