---
/**
 * Pasek produktu przyklejony u góry (wzór: lokalna nawigacja na stronach produktów apple.com).
 * Nazwa produktu po lewej, mały "Zamów" po prawej. Półprzezroczyste, rozmyte tło.
 * Stoi pod paskiem menu strony, a przy przewijaniu przykleja się do górnej krawędzi
 * (position: sticky, bez JS). Wysokość: --local-nav-height (ustawia ProductStory).
 *
 * Motyw: nad sekcją z data-theme="light" pasek robi się jasny (jak na apple.com, gdy strona
 * przechodzi w jasną część). Sprawdzane przy przewijaniu, najwyżej raz na klatkę.
 */
interface Props {
  title: string;
  /** Opis nawigacji dla czytników ekranu. */
  label: string;
  orderHref: string;
  orderLabel: string;
}

const { title, label, orderHref, orderLabel } = Astro.props;
---

<nav class="local-nav" aria-label={label} data-local-nav>
  <div class="local-nav__bar">
    <p class="local-nav__title">{title}</p>
    <a class="local-nav__cta" href={orderHref}>
      {orderLabel}
    </a>
  </div>
</nav>

<script>
  for (const nav of document.querySelectorAll<HTMLElement>('[data-local-nav]')) {
    let raf = 0;
    const update = () => {
      raf = 0;
      // Co jest tuż pod dolną krawędzią paska?
      const y = nav.getBoundingClientRect().bottom + 1;
      const under = document.elementsFromPoint(innerWidth / 2, y).find((el) => !nav.contains(el));
      const light = !!under?.closest('[data-theme="light"]');
      nav.classList.toggle('is-light', light);
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .local-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--local-nav-height);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(22 22 23 / 0.72);
    color: var(--color-text-on-dark);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
  }

  .local-nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .local-nav__title {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .local-nav__cta {
    display: inline-flex;
    align-items: center;
    height: 1.875rem;
    padding-inline: 0.875rem;
    border-radius: var(--radius-pill);
    background: var(--color-text-on-dark);
    color: var(--color-bg-dark);
    font-size: 0.875rem;
    text-decoration: none;
    text-box: trim-both cap alphabetic;
  }

  .local-nav__cta:focus-visible {
    outline: 2px solid var(--color-text-on-dark);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .local-nav__cta:hover {
      background: color-mix(in srgb, var(--color-text-on-dark) 82%, var(--color-bg-dark));
    }

    .local-nav:global(.is-light) .local-nav__cta:hover {
      background: color-mix(in srgb, var(--color-text) 82%, var(--color-surface));
    }
  }

  /* Jasny motyw (nad jasnymi sekcjami). */
  .local-nav:global(.is-light) {
    border-bottom-color: rgb(0 0 0 / 0.1);
    background: rgb(251 251 253 / 0.8);
    color: var(--color-text);
  }

  .local-nav:global(.is-light) .local-nav__cta {
    background: var(--color-text);
    color: var(--color-surface);
  }

  @media (max-width: 734px) {
    .local-nav__title {
      font-size: 1.1875rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .local-nav {
      transition:
        background-color 300ms var(--ease-out),
        color 300ms var(--ease-out),
        border-color 300ms var(--ease-out);
    }

    .local-nav__cta {
      transition:
        background-color 240ms var(--ease-out),
        color 240ms var(--ease-out),
        transform var(--duration-press) var(--ease-out);
    }

    .local-nav__cta:active {
      transform: scale(0.96);
    }
  }
</style>
