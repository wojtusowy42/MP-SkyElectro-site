---
/**
 * Pasek menu na górze strony (wzór: apple.com).
 *
 * NA RAZIE STATYCZNY: logo + nazwy pozycji, bez linków i bez menu mobilnego.
 * Na telefonie (do 833 px) widać samo logo.
 *
 * theme: 'dark' nad czarnym hero, 'light' na jasnych stronach (np. konfigurator).
 * Przy przejściu między stronami pasek płynnie zmienia kolor (view transition w global.css).
 */
import Logo from '../assets/brand/logo.svg';
import { SITE } from '../config/site.ts';
import type { Locale } from '../i18n/locales.ts';
import { navLabels } from '../lib/navigation.ts';

interface Props {
  locale: Locale;
  theme?: 'dark' | 'light';
}

const { locale, theme = 'dark' } = Astro.props;
const labels = navLabels(locale);
---

<header class="nav" data-theme={theme}>
  <div class="nav__bar">
    <Logo class="nav__logo" role="img" aria-label={SITE.name} />
    <ul class="nav__list" role="list">
      {labels.map((label) => (
        <li class="nav__item">{label}</li>
      ))}
    </ul>
  </div>
</header>

<style>
  .nav {
    view-transition-name: site-nav;
    background: color-mix(in srgb, var(--color-surface-dark) 75%, var(--color-bg-dark));
    color: var(--color-text-on-dark);
  }

  .nav[data-theme='light'] {
    background: color-mix(in srgb, var(--color-surface) 70%, var(--color-bg));
    color: var(--color-text);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-line) 60%, transparent);
  }

  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    height: var(--nav-height);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav__logo {
    flex-shrink: 0;
    width: auto;
    height: 1.25rem;
  }

  .nav__list {
    display: flex;
    flex: 1;
    justify-content: space-between;
    max-width: 50rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__item {
    font-size: var(--text-nav);
    letter-spacing: -0.005em;
    white-space: nowrap;
    opacity: 0.8;
  }

  @media (max-width: 833px) {
    .nav__bar {
      justify-content: center;
    }

    .nav__list {
      display: none;
    }
  }
</style>
