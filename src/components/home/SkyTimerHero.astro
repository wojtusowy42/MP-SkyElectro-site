---
/**
 * Hero strony głównej: SkyTimer 1 na czarnym tle (wzór: hero MacBooka Pro na apple.com).
 * Nazwa, hasło, dwa przyciski i render płytki uciętej dołem, bez animacji.
 * "Dowiedz się więcej" prowadzi na stronę produktu (animacja złożenia, IntroVideo).
 * "Kup" prowadzi na stronę Kup (konfigurator i ceny).
 *
 * Render: Raw Assets/04 Rendery/SkyTimer 1/Hero/Warianty/SkyTimer hero A frontal@2x.png
 * (6016 × 1384, czarne tło z poświatą, krawędzie czysto czarne), tu jako hero.jpg (q95, 4:4:4).
 * Od 2026-11-07: "SkyTimer hero A frontal@2x.png" (widok z przodu, ujęcie A).
 * Wersja 1x tego renderu (3008 × 692) = rozmiar w px CSS na desktopie.
 *
 * Geometria: render ma stałą szerokość na każdym progu (--img-w), więc płytka ma zawsze ten sam
 * rozmiar, a na węższych ekranach ucinają się tylko czarne boki. Płytka zaczyna się zawsze --gap
 * pod przyciskami (czarna góra renderu wchodzi pod tekst), dół renderu = dół sekcji, czyli cięcie
 * wypada w tym samym miejscu płytki na każdym ekranie, nawet gdy hasło złamie się na dwie linie.
 * Sekcja wsuwa się pod pasek menu (--nav-h), więc przez półprzezroczysty pasek widać czerń.
 */
import { Picture } from 'astro:assets';
import render from '../../assets/renders/skytimer-1/hero.jpg';

interface Props {
  title: string;
  tagline: string;
  primaryLabel: string;
  /** Strona produktu ("Dowiedz się więcej"). */
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  imageAlt: string;
}

const { title, tagline, primaryLabel, primaryHref, secondaryLabel, secondaryHref, imageAlt } =
  Astro.props;

/** Płytka w renderze (px w hero.jpg), zmierzone po czerwieni maski. */
const BOARD = { top: 544, left: 2032, right: 3980 };
---

<section
  class="hero"
  style={[
    `--ratio: ${render.height / render.width}`,
    `--subject: ${BOARD.top / render.height}`,
    `--center: ${(BOARD.left + BOARD.right) / 2 / render.width}`,
  ].join('; ')}
>
  <div class="hero__text">
    <h2 class="hero__title">{title}</h2>
    <p class="hero__tagline">{tagline}</p>
    <div class="hero__actions">
      <a class="button button--primary" href={primaryHref}>
        {primaryLabel}
      </a>
      <a class="button button--secondary" href={secondaryHref}>
        {secondaryLabel}
      </a>
    </div>
  </div>
  <div class="hero__media">
    <Picture
      class="hero__image"
      src={render}
      alt={imageAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={82}
      widths={[1200, 1800, 2256, 3008, 4512, 6016]}
      sizes="(max-width: 734px) 250vw, (max-width: 1068px) 2256px, 3008px"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    /* Progi jak na apple.com: telefon ≤ 734 px, tablet ≤ 1068 px, desktop powyżej.
       Płytka zajmuje 33,5% szerokości renderu. */
    --title-top: 3.5rem; /* 56 px */
    --title-size: 4rem; /* 64 px */
    --tagline-size: 1.75rem; /* 28 px */
    --img-w: 3008px; /* płytka ok. 1010 px */
    --gap: 3rem; /* przyciski → góra płytki */
    --img-h: calc(var(--img-w) * var(--ratio));

    overflow: hidden;
    /* Sekcja zaczyna się pod paskiem menu (SiteNav), --title-top liczy się od dołu paska. */
    margin-top: calc(var(--nav-h) * -1);
    padding-top: calc(var(--nav-h) + var(--title-top));
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    text-align: center;
  }

  .hero__text {
    position: relative;
    z-index: 1;
    padding-inline: 1.5rem;
  }

  .hero__title {
    font-size: var(--title-size);
    font-weight: 600;
    line-height: 1.0625;
    letter-spacing: -0.02em;
  }

  .hero__tagline {
    margin-top: 0.375rem;
    font-size: var(--tagline-size);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  /* Przycisk (decyzje, sekcja 13): pigułka o stałej wysokości, tekst wyśrodkowany optycznie
     (text-box; bez wsparcia zostaje zwykłe centrowanie), obrys drugiego jako cień wewnętrzny.
     Bez animacji stanów (góra strony bez animacji, decyzja właściciela). */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem; /* 44 px */
    padding-inline: 1.375rem;
    border-radius: 999px;
    font-size: 1.0625rem; /* 17 px */
    line-height: 1;
    text-box: trim-both cap alphabetic;
    text-decoration: none;
    white-space: nowrap;
  }

  .button:focus-visible {
    outline: 2px solid var(--color-text-on-dark);
    outline-offset: 3px;
  }

  .button--primary {
    background: var(--color-text-on-dark);
    color: var(--color-bg-dark);
  }

  .button--primary:hover {
    background: var(--color-surface);
  }

  .button--secondary {
    box-shadow: inset 0 0 0 1px var(--color-line-on-dark);
    color: var(--color-text-on-dark);
  }

  /* Pas o wysokości widocznej części renderu (od góry płytki w dół). */
  .hero__media {
    position: relative;
    height: calc(var(--img-h) * (1 - var(--subject)));
    margin-top: var(--gap);
  }

  /* Render przyklejony do dołu, środek płytki na środku ekranu. */
  .hero :global(.hero__image) {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: var(--img-w);
    max-width: none;
    height: auto;
    translate: calc(var(--img-w) * var(--center) * -1) 0;
  }

  @media (max-width: 1068px) {
    .hero {
      --title-top: 3rem; /* 48 px */
      --title-size: 3.5rem; /* 56 px */
      --tagline-size: 1.5rem; /* 24 px */
      --img-w: 2256px; /* płytka ok. 760 px */
      --gap: 2.75rem;
    }
  }

  @media (max-width: 734px) {
    .hero {
      --title-top: 2.5rem; /* 40 px */
      --title-size: 2.5rem; /* 40 px */
      --tagline-size: 1.3125rem; /* 21 px */
      --img-w: 250vw; /* płytka ok. 84% szerokości ekranu */
      --gap: 2.25rem;
    }

    .hero__actions {
      gap: 0.75rem;
      margin-top: 1.25rem;
    }

    .button {
      height: 2.25rem; /* 36 px */
      padding-inline: 1rem;
      font-size: 0.875rem; /* 14 px */
    }
  }
</style>
