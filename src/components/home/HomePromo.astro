---
/**
 * Sekcja strony głównej pod hero (wzór: pasy i kafelki na apple.com).
 * layout="band": pełna szerokość, jedna pod drugą. layout="tile": kafelek w siatce 2 kolumn
 * (wide = na całą szerokość siatki).
 * Napis na górze, pod nim grafika. Bez renderu (image) puste miejsce z opisem grafiki do zrobienia (imageNote).
 * eyebrow: mały napis nad nazwą (np. "Wkrótce"); produkty "wkrótce" nie mają przycisków (links = []).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  title: string;
  tagline: string;
  links: { label: string; href: string }[];
  /** Opis grafiki do zrobienia (gdy nie ma image). */
  imageNote?: string;
  /** Render na tle sekcji (czarne rendery do theme="dark"). */
  image?: ImageMetadata;
  imageAlt?: string;
  eyebrow?: string;
  layout: 'band' | 'tile';
  theme: 'light' | 'dark';
  wide?: boolean;
}

const { title, tagline, links, imageNote, image, imageAlt = '', eyebrow, layout, theme, wide = false } =
  Astro.props;
---

<section class:list={['promo', `promo--${layout}`, `promo--${theme}`, { 'promo--wide': wide }]}>
  <div class="promo__text">
    {eyebrow && <p class="promo__eyebrow">{eyebrow}</p>}
    <h2 class="promo__title">{title}</h2>
    <p class="promo__tagline">{tagline}</p>
    {
      links.length > 0 && (
        <div class="promo__actions">
          {links.map((link, i) => (
            <a class:list={['button', i === 0 ? 'button--primary' : 'button--secondary']} href={link.href}>
              {link.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
  {
    image ? (
      <Picture
        class="promo__image"
        src={image}
        alt={imageAlt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={82}
        widths={[800, 1200, 1600, 2000]}
        sizes={wide || layout === 'band' ? '(max-width: 1068px) 100vw, 980px' : '(max-width: 734px) 100vw, 50vw'}
        loading="lazy"
      />
    ) : (
      <div class="promo__media" aria-hidden="true">
        <span>{imageNote}</span>
      </div>
    )
  }
</section>

<style>
  .promo {
    --title-size: 3.5rem; /* 56 px */
    --tagline-size: 1.75rem; /* 28 px */
    --media-h: 27.5rem; /* 440 px */

    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    padding-top: 3.5rem;
    text-align: center;
  }

  .promo--tile {
    --title-size: 3rem; /* 48 px */
    --tagline-size: 1.625rem; /* 26 px */
    --media-h: 21rem; /* 336 px */

    padding-top: 3rem;
  }

  .promo--light {
    --button-fill: var(--color-text);
    --button-ink: var(--color-surface);
    --button-fill-hover: #000;
    --button-line: var(--color-text);

    background: var(--color-bg);
    color: var(--color-text);
  }

  .promo--dark {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
  }

  .promo--wide {
    grid-column: 1 / -1;
  }

  .promo__text {
    padding-inline: 1.5rem;
  }

  .promo__eyebrow {
    margin-bottom: 0.25rem;
    font-size: 1.0625rem;
    font-weight: 600;
    opacity: 0.6;
  }

  /* Render: na całą szerokość sekcji (czarne brzegi renderu zlewają się z tłem), wysokość z proporcji. */
  .promo :global(.promo__image) {
    width: min(100%, var(--content-max));
    height: auto;
    margin-top: 1rem;
  }

  /* Kafelek: render do samych krawędzi kafelka, bez limitu szerokości (na szerokich ekranach kafelek > 980 px). */
  .promo--tile :global(.promo__image) {
    width: 100%;
  }

  .promo__title {
    font-size: var(--title-size);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.02em;
  }

  .promo__tagline {
    margin-top: 0.375rem;
    font-size: var(--tagline-size);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .promo__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  /* Miejsce na grafikę: ten sam rozmiar, jaki dostanie render. */
  .promo__media {
    display: grid;
    place-items: center;
    width: min(100% - 2 * var(--gutter), var(--content-max));
    height: var(--media-h);
    margin-top: 2.5rem;
    border: 1px dashed currentColor;
    border-bottom: 0;
    border-radius: 1.125rem 1.125rem 0 0;
    padding: 1.5rem;
    font-size: 0.875rem;
    opacity: 0.45;
  }

  @media (max-width: 1068px) {
    .promo--band {
      --title-size: 3rem;
      --tagline-size: 1.5rem;
      --media-h: 23rem;
    }

    .promo--tile {
      --title-size: 2.5rem;
      --tagline-size: 1.4375rem;
      --media-h: 17rem;
    }
  }

  @media (max-width: 734px) {
    .promo,
    .promo--tile {
      --title-size: 2rem; /* 32 px */
      --tagline-size: 1.1875rem; /* 19 px */
      --media-h: 16rem;

      padding-top: 2.75rem;
    }

    .promo__actions {
      gap: 0.75rem;
    }
  }
</style>
