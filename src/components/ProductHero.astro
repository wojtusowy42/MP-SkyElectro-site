---
/**
 * Duży ekran produktu na czarnym tle (wzór: hero na apple.com).
 * Nazwa, jedno zdanie, dostępność, dwa przyciski, a pod spodem render,
 * który wchodzi pod tekst i jest ucięty dołem.
 *
 * Przyciski: "Dowiedz się więcej" → strona produktu, "Zamów" → konfigurator.
 *
 * Wymagania co do renderu: czarne tło (#000) w górnej części kadru, produkt na środku,
 * proporcje ok. 2.8:1. `subjectTop` = gdzie w kadrze zaczyna się produkt (0-1 wysokości),
 * żeby odstęp między przyciskami a produktem był zawsze taki sam.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  title: string;
  tagline: string;
  availability?: string | undefined;
  primaryLabel: string;
  /** Dokąd prowadzi główny przycisk (strona "Dowiedz się więcej"). */
  primaryHref?: string | undefined;
  secondaryLabel?: string | undefined;
  /** Dokąd prowadzi drugi przycisk (np. konfigurator). Bez adresu przycisk nic nie robi. */
  secondaryHref?: string | undefined;
  image: ImageMetadata;
  imageAlt: string;
  subjectTop: number;
  /** Kolory produktu (od, do): hasło dostaje gradient jak na apple.com. Bez nich hasło jest białe. */
  colors?: readonly [string, string] | undefined;
  /** h1 na stronie produktu, h2 na stronie głównej (tam h1 to nazwa firmy). */
  headingLevel?: 'h1' | 'h2';
}

const {
  title,
  tagline,
  availability,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  image,
  imageAlt,
  subjectTop,
  colors,
  headingLevel: Heading = 'h1',
} = Astro.props;
---

<section
  class="hero"
  style={[
    `--subject-top: ${subjectTop}`,
    colors && `--accent-from: ${colors[0]}; --accent-to: ${colors[1]}`,
  ]
    .filter(Boolean)
    .join('; ')}
>
  <div class="hero__copy">
    <Heading class="hero__title">{title}</Heading>
    <p class:list={['hero__tagline', { 'hero__tagline--accent': colors }]}>{tagline}</p>
    {availability && <p class="hero__availability">{availability}</p>}
    <div class="hero__actions">
      {primaryHref ? (
        <a class="button button--primary" href={primaryHref}>
          {primaryLabel}
        </a>
      ) : (
        <span class="button button--primary">{primaryLabel}</span>
      )}
      {secondaryLabel &&
        (secondaryHref ? (
          <a class="button button--secondary" href={secondaryHref}>
            {secondaryLabel}
          </a>
        ) : (
          <span class="button button--secondary">{secondaryLabel}</span>
        ))}
    </div>
  </div>

  <div class="hero__media">
    <Picture
      class="hero__image"
      src={image}
      alt={imageAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[1000, 1440, 1920, 2400, 2880]}
      sizes="(max-width: 879px) 984px, 112vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    /* Wysokość renderu: na telefonie stała (kadr przycięty z boków), wyżej rośnie z ekranem. */
    --media-h: max(22rem, 40vw);
    --gap-to-subject: clamp(2rem, 4vw, 3.5rem);

    /* Stała wysokość jak na apple.com (ok. 455 px na telefonie → 692 px na desktopie).
       Render jest ucinany dołem, widać tylko górę produktu. */
    display: grid;
    grid-template-rows: auto 1fr;
    height: clamp(28.5rem, 22.5rem + 24.3vw, 43.25rem);
    overflow: hidden;
    padding-top: clamp(2.5rem, 4.5vw, 3.25rem);
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    text-align: center;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    padding-inline: var(--gutter);
  }

  .hero__title {
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .hero__tagline {
    margin-top: 0.375rem;
    font-size: var(--text-hero-sub);
    line-height: 1.14;
    letter-spacing: -0.016em;
    text-wrap: balance;
  }

  /* Hasło w kolorach produktu (wzór: "Wyświetlacz PROLED XDR" na apple.com). */
  .hero__tagline--accent {
    width: fit-content;
    margin-inline: auto;
    background: linear-gradient(90deg, var(--accent-from), var(--accent-to));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__availability {
    margin-top: 0.625rem;
    color: var(--color-text-2-on-dark);
    font-size: var(--text-lead);
    line-height: 1.19;
    letter-spacing: -0.012em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem 1rem;
    margin-top: 1.375rem;
  }

  /* ---------- Przyciski (pigułki) ----------
     Stała wysokość + flex = tekst zawsze na środku, oba przyciski równe.
     text-box przycina font do wysokości wielkich liter, więc tekst jest wyśrodkowany
     optycznie na każdym foncie (Segoe na Windows siedzi inaczej niż SF na Macu). */
  .button {
    --button-h: 2.75rem; /* 44 px */

    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--button-h);
    min-width: 6.5rem;
    padding-inline: 1.375rem;
    border-radius: calc(var(--button-h) / 2);
    font-size: var(--text-body);
    line-height: 1;
    letter-spacing: -0.012em;
    white-space: nowrap;
    text-box: trim-both cap alphabetic;
  }

  .button--primary {
    background: var(--color-text-on-dark);
    color: var(--color-bg-dark);
  }

  /* Obrys jako cień wewnętrzny: przycisk ma dokładnie ten sam rozmiar co główny. */
  .button--secondary {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-text-on-dark);
    color: var(--color-text-on-dark);
  }

  /* Po najechaniu: główny lekko przygasa, "Zamów" wypełnia się na biało.
     Po kliknięciu oba lekko się wciskają. */
  a.button {
    text-decoration: none;
  }

  a.button:focus-visible {
    outline-offset: 4px;
  }

  @media (hover: hover) {
    a.button--primary:hover {
      background: color-mix(in srgb, var(--color-text-on-dark) 82%, var(--color-bg-dark));
    }

    a.button--secondary:hover {
      background: var(--color-text-on-dark);
      color: var(--color-bg-dark);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    a.button {
      transition:
        background-color 240ms var(--ease-out),
        color 240ms var(--ease-out),
        transform var(--duration-press) var(--ease-out);
    }

    a.button:active {
      transform: scale(0.97);
    }
  }

  /* Telefon: mniejsze przyciski, jak na apple.com. */
  @media (max-width: 734px) {
    .hero__actions {
      gap: 0.875rem;
    }

    .button {
      --button-h: 2.25rem; /* 36 px */

      min-width: 5.5rem;
      padding-inline: 1.0625rem;
      font-size: 0.9375rem; /* 15 px */
    }
  }

  /* ---------- Render ----------
     Render wypełnia resztę sekcji pod przyciskami. Jego czarna góra wchodzi pod tekst,
     a produkt zaczyna się zawsze --gap-to-subject pod przyciskami. Wysokość renderu:
     co najmniej --media-h, a jeśli to za mało, by sięgnąć dołu sekcji, tyle ile trzeba
     (procenty liczą się od wysokości .hero__media). */
  .hero__media {
    position: relative;
  }

  .hero__media :global(.hero__image) {
    --h: max(var(--media-h), calc((100% - var(--gap-to-subject)) / (1 - var(--subject-top))));

    position: absolute;
    top: calc(var(--gap-to-subject) - var(--h) * var(--subject-top));
    left: 0;
    width: 100%;
    max-width: none;
    height: var(--h);
    object-fit: cover;
    object-position: 50% 100%;
  }
</style>
