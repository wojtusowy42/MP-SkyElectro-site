---
/**
 * Strona Kontakt w stylu Apple Support, tylko prościej: cała biała, nagłówek
 * i trzy kolumny (e-mail, telefon, podręcznik). Dane z podręcznika SkyTimer 1 V3 (SITE).
 */
import { SITE } from '../config/site.ts';
import { getDictionary } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const t = getDictionary(Astro.props.locale).pages.contact;
const manualHref = `${import.meta.env.BASE_URL}docs/skytimer-1-podrecznik.pdf`;
---

<section class="contact">
  <h1 class="contact__heading">{t.heading}</h1>
  <p class="contact__lead">{t.lead}</p>

  <ul class="contact__options">
    <li class="option">
      <svg class="option__icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" />
      </svg>
      <h2 class="option__title">{t.emailTitle}</h2>
      <p class="option__text">{t.emailText}</p>
      {
        SITE.orderEmail ? (
          <a class="option__link" href={`mailto:${SITE.orderEmail}`}>
            {SITE.orderEmail}
          </a>
        ) : (
          <p class="option__text">{t.noEmail}</p>
        )
      }
    </li>
    <li class="option">
      <svg class="option__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2" />
      </svg>
      <h2 class="option__title">{t.phone}</h2>
      <p class="option__text">{t.phoneText}</p>
      <a class="option__link" href={`tel:${SITE.phone.replaceAll(' ', '')}`}>{SITE.phone}</a>
    </li>
    <li class="option">
      <svg class="option__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 3h8l4 4v14H6z" /><path d="M14 3v4h4M9 12h6M9 16h6" />
      </svg>
      <h2 class="option__title">{t.manualTitle}</h2>
      <p class="option__text">{t.manualText}</p>
      <a class="option__link" href={manualHref} download>{t.manualLink}</a>
    </li>
  </ul>
</section>

<style>
  /* Kontakt jest cały biały, także pod sekcją i przy przewinięciu "z gumką". */
  :global(body) {
    background: var(--color-surface);
  }

  .contact {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(4.5rem, 10vw, 7.5rem) var(--gutter) clamp(5rem, 10vw, 8rem);
    color: var(--color-text);
    text-align: center;
  }

  .contact__heading {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.035em;
  }

  .contact__lead {
    margin: 1.25rem auto 0;
    max-width: 34rem;
    color: var(--color-text-2);
    font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.3125rem);
    line-height: 1.4;
    text-wrap: balance;
  }

  .contact__options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: clamp(3.5rem, 8vw, 5.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .option {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem 2rem;
  }

  .option + .option {
    border-left: 1px solid var(--color-line);
  }

  .option__icon {
    width: 3.5rem;
    height: 3.5rem;
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .option__title {
    margin-top: 1.5rem;
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .option__text {
    margin-top: 0.375rem;
    color: var(--color-text-2);
    font-size: 0.9375rem;
    text-wrap: balance;
  }

  .option__link {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .option__link::after {
    content: ' ›';
  }

  .option__link:hover {
    text-decoration: underline;
  }

  /* Telefon: kolumny jedna pod drugą, linie poziome zamiast pionowych. */
  @media (max-width: 734px) {
    .contact__options {
      grid-template-columns: 1fr;
    }

    .option {
      padding: 2.5rem 0;
    }

    .option + .option {
      border-left: 0;
      border-top: 1px solid var(--color-line);
    }
  }
</style>
