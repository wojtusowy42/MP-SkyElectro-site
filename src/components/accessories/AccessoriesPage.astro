---
/**
 * Akcesoria (wzór: "Wszystkie akcesoria" w sklepie apple.com), cała strona biała.
 * Bez category: /pl/akcesoria/ (pasek kategorii i wszystkie akcesoria w grupach).
 * Z category: /pl/akcesoria/skytimer-1/ (ten sam pasek, katalog jednej kategorii).
 * Kafelek: zdjęcie, kolory, nazwa, cena. Kliknięcie prowadzi do strony akcesorium.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import stPcb from '../../assets/renders/skytimer-1/konfigurator/pcb.png';
import { ACCESSORIES, ACCESSORY_CATEGORIES, type AccessoryCategory } from '../../data/accessories.ts';
import { format, getDictionary } from '../../i18n/index.ts';
import type { Locale } from '../../i18n/locales.ts';
import { accessoryPath, pathFor } from '../../i18n/routes.ts';
import { accessoryImages } from '../../lib/accessory-images.ts';
import { currentPrice, formatPrice } from '../../lib/price.ts';
import { pickVersion } from '../../lib/versions.ts';

interface Props {
  locale: Locale;
  category?: AccessoryCategory;
}

const { locale, category } = Astro.props;
const dict = getDictionary(locale);
const t = dict.pages.accessories;
const texts = dict.accessories;
const today = new Date(); // dzień buildu

/** Zdjęcie kategorii w pasku. Wieżyczki nie mają jeszcze renderu: sama nazwa. */
const CATEGORY_IMAGES: Partial<Record<AccessoryCategory, ImageMetadata>> = { 'skytimer-1': stPcb };

const groups = (category ? [category] : ACCESSORY_CATEGORIES).map((id) => ({
  id,
  heading: texts.categories[id]!.heading,
  items: ACCESSORIES.filter((a) => a.category === id).map((a) => {
    const images = accessoryImages(a);
    // Kafelek: wersja dla pierwszych opcji (jak strona akcesorium na start).
    const first = Object.fromEntries(a.configurator.steps.map((s) => [s.id, s.options[0]!.id]));
    const price = a.configurator.basePrice ? currentPrice(a.configurator.basePrice, today) : null;
    return {
      id: a.id,
      name: texts.items[a.id]!.name,
      href: accessoryPath(locale, { accessory: a.id }),
      image: images[pickVersion(images.map((i) => i.match), first)]?.src,
      swatches: a.configurator.steps.find((s) => s.id === 'color')?.options.map((o) => o.swatch!) ?? [],
      price: price === null ? dict.common.priceOnRequest : formatPrice(price, locale),
    };
  }),
}));
---

<div class="acc">
  {
    category ? (
      <p class="acc__back">
        <a href={pathFor(locale, { kind: 'page', id: 'accessories' })}>{t.navName}</a>
      </p>
    ) : null
  }
  <h1 class="acc__heading">{category ? texts.categories[category]!.heading : t.heading}</h1>
  {!category && <p class="acc__lead">{t.lead}</p>}

  <nav class="browse" aria-label={t.browse}>
    <h2 class="browse__title">{t.browse}</h2>
    <ul class="browse__list">
      {ACCESSORY_CATEGORIES.map((id) => (
        <li>
          <a
            class="browse__item"
            href={accessoryPath(locale, { category: id })}
            aria-current={id === category ? 'page' : undefined}
          >
            <span class="browse__img">
              {CATEGORY_IMAGES[id] ? (
                <Picture src={CATEGORY_IMAGES[id]} alt="" widths={[160, 320]} sizes="120px" formats={['avif', 'webp']} />
              ) : (
                <span class="browse__noimg">{t.noImage}</span>
              )}
            </span>
            <span class="browse__name">{texts.categories[id]!.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {groups.map((group) => (
    <section class="group" aria-labelledby={`grupa-${group.id}`}>
      {!category && (
        <div class="group__head">
          <h2 class="group__heading" id={`grupa-${group.id}`}>{group.heading}</h2>
          <a class="group__all" href={accessoryPath(locale, { category: group.id })}>{t.seeAll}</a>
        </div>
      )}
      {category && <h2 class="visually-hidden" id={`grupa-${group.id}`}>{t.all}</h2>}
      <ul class="grid">
        {group.items.map((item) => (
          <li class="tile">
            <a class="tile__link" href={item.href}>
              <span class="tile__img">
                {item.image ? (
                  <Picture src={item.image} alt="" widths={[320, 480, 640]} sizes="(max-width: 734px) 45vw, 300px" formats={['avif', 'webp']} quality={80} loading="lazy" />
                ) : (
                  <span class="tile__placeholder">{t.noImage}</span>
                )}
              </span>
              {/* Pusty wiersz też zajmuje miejsce, żeby nazwy w rzędzie zaczynały się równo. */}
              <span
                class="tile__swatches"
                {...(item.swatches.length > 0
                  ? { role: 'img', 'aria-label': format(t.colors, { n: item.swatches.length }) }
                  : { 'aria-hidden': 'true' })}
              >
                {item.swatches.map((s) => <span style={`--swatch: ${s}`} />)}
              </span>
              <span class="tile__name">{item.name}</span>
              <span class="tile__price">{item.price}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  :global(body) {
    background: var(--color-surface);
  }

  .acc {
    max-width: calc(var(--content-wide) + 2 * var(--gutter));
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) clamp(5rem, 10vw, 8rem);
    color: var(--color-text);
  }

  .acc__back a {
    color: var(--color-text-2);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .acc__back a::before {
    content: '‹ ';
  }

  .acc__heading {
    margin-top: 0.25rem;
    font-size: clamp(2.5rem, 1.5rem + 3.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.035em;
  }

  .acc__lead {
    margin-top: 0.75rem;
    max-width: 38rem;
    color: var(--color-text-2);
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem);
  }

  /* ---------- Pasek kategorii ---------- */
  .browse {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .browse__title {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .browse__list {
    display: flex;
    gap: 1.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
  }

  .browse__item {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    width: 9rem;
    text-decoration: none;
  }

  .browse__img {
    display: grid;
    place-items: center;
    width: 9rem;
    aspect-ratio: 1;
    border-radius: 1.25rem;
    background: #f5f5f7;
    overflow: hidden;
    transition: box-shadow var(--duration-ui) var(--ease-out);
  }

  .browse__img :global(img) {
    width: 85%;
    height: auto;
  }

  .browse__noimg {
    color: var(--color-text-2);
    font-size: 0.75rem;
  }

  .browse__item[aria-current='page'] .browse__img {
    box-shadow: inset 0 0 0 2px var(--color-text);
  }

  .browse__name {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  @media (hover: hover) {
    .browse__item:hover .browse__img {
      box-shadow: inset 0 0 0 1px var(--color-line);
    }

    .browse__item[aria-current='page']:hover .browse__img {
      box-shadow: inset 0 0 0 2px var(--color-text);
    }
  }

  /* ---------- Grupy i siatka ---------- */
  .group {
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }

  .group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .group__heading {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .group__all {
    flex: none;
    text-decoration: none;
  }

  .group__all::after {
    content: ' ›';
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 45%), 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tile__link {
    display: grid;
    gap: 0.375rem;
    text-decoration: none;
  }

  .tile__img {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    margin-bottom: 0.625rem;
    border-radius: 1.125rem;
    background: #f5f5f7; /* widać tylko bez zdjęcia: rendery mają białe tło */
    overflow: hidden;
  }

  .tile__img :global(picture) {
    width: 100%;
  }

  .tile__img :global(img) {
    width: 100%;
    height: auto;
    transition: transform 500ms var(--ease-out);
  }

  @media (hover: hover) {
    .tile__link:hover :global(img) {
      transform: scale(1.04);
    }

    .tile__link:hover .tile__name {
      text-decoration: underline;
    }
  }

  .tile__placeholder {
    color: var(--color-text-2);
    font-size: 0.875rem;
  }

  .tile__swatches {
    display: flex;
    min-height: 0.75rem;
    gap: 0.375rem;
  }

  .tile__swatches span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  .tile__name {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .tile__price {
    font-size: 0.9375rem;
  }
</style>
