---
/**
 * Układ strony: <head> z SEO (BaseLayout) + pasek menu + <main>.
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { Locale } from '../i18n/locales.ts';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternates: Record<Locale, string>;
  /** Kolor paska menu: 'dark' nad czarnym hero, 'light' na jasnych stronach. */
  navTheme?: 'dark' | 'light';
}

const { locale, title, description, alternates, navTheme = 'dark' } = Astro.props;
---

<BaseLayout locale={locale} title={title} description={description} alternates={alternates}>
  <SiteHeader locale={locale} theme={navTheme} />
  <main>
    <slot />
  </main>
</BaseLayout>
