---
/**
 * Strona Kup produktu: /pl/<produkt>/kup/  (wzór: strona "Kup" na apple.com)
 * JEDYNE miejsce z cenami i konfiguratorem produktu; "Dowiedz się więcej" ich nie pokazuje.
 * Generowany dla każdego produktu, który ma konfigurator w danych (src/data/products/).
 *
 * Układ: nagłówek (nazwa, dostępność, cena "od"), pod spodem duża szara karta po lewej
 * z galerią renderów (przyklejona przy przewijaniu) i kroki konfiguratora po prawej.
 * Białe tło strony.
 *
 * Rendery: src/assets/renders/<produkt>/, lista w GALLERIES poniżej. Wszystkie na białym tle.
 * Zdjęcia w wersjach (kup/<nazwa>-<id opcji>[-<id opcji>].jpg, np. wariant-v1-blue.jpg)
 * przełączają się razem z wyborami w konfiguratorze.
 */
import type { GetStaticPaths, ImageMetadata } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import Configurator from '../../../components/configurator/Configurator.svelte';
import Gallery from '../../../components/configurator/Gallery.astro';
import { LOCALES } from '../../../i18n/locales.ts';
import { format, getDictionary, productTexts } from '../../../i18n/index.ts';
import { configuratorAlternates } from '../../../i18n/routes.ts';
import { PRODUCTS } from '../../../data/products/index.ts';
import { SKYTIMER_1_SPEC } from '../../../data/skytimer-1-spec.ts';
import { accessoryPath, bagPath } from '../../../i18n/routes.ts';
import { accessoryForKitItem } from '../../../data/accessories.ts';
import { Picture } from 'astro:assets';
import { currentPrice, formatPrice, toDateKey } from '../../../lib/price.ts';
import stPcb from '../../../assets/renders/skytimer-1/konfigurator/pcb.png';
import stPcbTop from '../../../assets/renders/skytimer-1/konfigurator/pcb-top.png';
import stPcbBack from '../../../assets/renders/skytimer-1/konfigurator/pcb-back.png';
import stPcbDetail from '../../../assets/renders/skytimer-1/konfigurator/pcb-detail-dip.png';

/** Rendery w wersjach: ścieżka → zdjęcie. Nazwa pliku = klucz opisu + id opcji, które pokazuje. */
const VERSIONS = import.meta.glob<ImageMetadata>('../../../assets/renders/*/kup/*.jpg', {
  eager: true,
  import: 'default',
});

/**
 * Zdjęcia w karcie, w kolejności. key = klucz opisu w słowniku (products.<id>.images).
 * Zamiast src slajd może mieć versions: nazwy plików z kup/ (np. warianty-*, wariant-*);
 * widać tę wersję, która najlepiej pasuje do wyborów. show = opcje, po których wybraniu
 * galeria przewija do slajdu (kolor nie przewija: zostajesz na oglądanym zdjęciu).
 * Produkt bez wpisu ma pustą kartę.
 */
/**
 * showAt: id kroku konfiguratora (albo 'summary'); galeria przewija do slajdu, gdy klient zjedzie
 * do tego kroku. Dzięki temu po wyborze widać jego efekt, a następny slajd przychodzi z przewijaniem.
 */
type Slide = ({ key: string; src: ImageMetadata } | { versions: string[] }) & {
  show?: string[];
  showAt?: string;
  /** Slajd tylko przy tych wyborach ('krok=opcja'); inny wybór go chowa. */
  only?: string;
  /** Zdjęcie wypełnia całą kartę (cień albo kadr dochodzi do brzegu pliku, więc brzeg nie może być widać). */
  fill?: boolean;
};
const GALLERIES: Record<string, Slide[]> = {
  'skytimer-1': [
    // na start sam timer (płytka); zestaw i warianty po wyborze przewijają się same
    { key: 'pcb', src: stPcb, show: ['pcb'], only: 'type=pcb', fill: true },
    // po wyborze śrub galeria zostaje na śrubkach; cały zestaw dopiero przy podsumowaniu
    { versions: ['zestaw'], show: ['kit'], showAt: 'summary', only: 'type=kit' },
    // przed wyborem wariantu wszystkie trzy, po wyborze tylko wybrany
    { versions: ['warianty', 'wariant'], show: ['v1', 'v2', 'v3'], only: 'type=kit' },
    // śrubki, gdy klient zjedzie do kroku "Śruby" (wybór koloru zostawia galerię na miejscu)
    { versions: ['element-sruby'], showAt: 'screws', only: 'type=kit' },
    { key: 'pcb-top', src: stPcbTop },
    { key: 'pcb-back', src: stPcbBack, fill: true },
    { key: 'pcb-detail-dip', src: stPcbDetail, fill: true },
  ],
};

/** Kafelki zestawu SkyTimer 1, w kolejności story.kit.items (Raw Assets: rendery_kup.py, k01-k11). */
const KIT_TILES = [
  'timer',
  'akumulator',
  'modul-zasilania',
  'ladowarka',
  'buzzer',
  'led',
  'mechanizm',
  'przycisk',
  'sruby',
  'szablony',
  'podrecznik',
];

/**
 * Parametry adresu wybierające opcję przy starcie (nazwa parametru → id kroku).
 * Można linkować np. do /pl/skytimer-1/kup/?wersja=kit.
 */
const URL_PARAMS: Record<string, Record<string, string>> = {
  'skytimer-1': { wersja: 'type' },
};

export const getStaticPaths = (() =>
  LOCALES.flatMap((lang) => {
    const dict = getDictionary(lang);
    return PRODUCTS.filter((p) => p.configurator).map((product) => ({
      params: {
        lang,
        slug: productTexts(dict, product.id).slug,
        configurator: dict.pages.configurator.slug,
      },
      props: { locale: lang, product },
    }));
  })) satisfies GetStaticPaths;

const { locale, product } = Astro.props;
const dict = getDictionary(locale);
const texts = productTexts(dict, product.id);
const definition = product.configurator!;
const labels = dict.pages.configurator;
const today = new Date(); // dzień buildu

const title = format(labels.title, { product: texts.name });
const heading = format(labels.heading, { product: texts.name });

// Cena "od": najtańsza znana opcja pierwszego kroku (+ cena bazowa).
const base = definition.basePrice ? currentPrice(definition.basePrice, today) : 0;
const firstStepPrices = (definition.steps[0]?.options ?? [])
  .map((o) => (o.price ? currentPrice(o.price, today) : 0))
  .filter((p): p is number => p !== null);
// Opcja → krok i pozycja (do opisów i kolejności wersji).
const optionStep = new Map(
  definition.steps.flatMap((step, si) =>
    step.options.map((o, oi) => [o.id, { step: step.id, order: si * 100 + oi }] as const),
  ),
);
/**
 * Wersje zdjęcia z kup/: pliki <key>.jpg (jedna wersja, pasuje zawsze) i <key>-<opcja>[-<opcja>].jpg,
 * po kolei: klucze, potem kolejność opcji w konfiguratorze. Plik z nieznaną opcją jest pomijany.
 */
function versionPictures(keys: string[], altFor: (key: string) => string) {
  const pictures = keys.flatMap((key, ki) =>
    Object.entries(VERSIONS).flatMap(([path, src]) => {
      const name = path
        .split('/')
        .at(-1)!
        .replace(/\.jpg$/, '');
      if (!path.includes(`/${product.id}/kup/`)) return [];
      if (name !== key && !name.startsWith(`${key}-`)) return [];
      const options = name === key ? [] : name.slice(key.length + 1).split('-');
      const steps = options.map((o) => optionStep.get(o));
      if (steps.some((st) => !st)) return [];
      const names = options.map((o, i) => texts.steps?.[steps[i]!.step]?.options[o] ?? o);
      const alt = altFor(key);
      return [
        {
          src,
          alt: names.length > 0 && alt ? `${alt} (${names.join(', ')})` : alt,
          match: options.map((o, i) => `${steps[i]!.step}=${o}`).join(' '),
          // shortcut: do 3 opcji w nazwie (1000^3 < 1e6 * klucz), więcej = zmienić sortowanie
          order: ki * 1e9 + steps.reduce((sum, st) => sum * 1000 + st!.order, 0),
        },
      ];
    }),
  );
  return pictures.sort((a, b) => a.order - b.order).map(({ order: _, ...p }) => p);
}

const gallery = (GALLERIES[product.id] ?? []).map((slide) => {
  const show = {
    ...(slide.show ? { show: slide.show } : {}),
    ...(slide.showAt ? { showAt: slide.showAt } : {}),
    ...(slide.fill ? { fill: true } : {}),
    ...(slide.only ? { only: slide.only } : {}),
  };
  if ('src' in slide) {
    return {
      pictures: [{ src: slide.src, alt: texts.images?.[slide.key] ?? texts.name }],
      ...show,
    };
  }
  return {
    pictures: versionPictures(slide.versions, (k) => texts.images?.[k] ?? texts.name),
    ...show,
  };
});

// "Co jest w zestawie": te same pozycje co na stronie produktu, zdjęcia kup/element-<nazwa>[-kolor].
const kitTexts = product.id === 'skytimer-1' ? dict.products['skytimer-1'].story.kit : null;
const optionName = (stepId: string, optionId: string) =>
  texts.steps?.[stepId]?.options[optionId] ?? optionId;

/**
 * Podpis w wersjach: każde połączenie wyborów z podanych kroków (także niewybrane) dostaje swój tekst,
 * a showVersions pokazuje ten pasujący. Pierwszy (bez wyborów) = podpis ogólny.
 */
function labelVersions(stepIds: string[], text: (names: Record<string, string>) => string) {
  let combos: Record<string, string>[] = [{}];
  for (const id of stepIds) {
    const step = definition.steps.find((s) => s.id === id);
    combos = combos.flatMap((c) => [
      c,
      ...(step?.options ?? []).map((o) => ({ ...c, [id]: o.id })),
    ]);
  }
  return combos.map((c) => ({
    match: Object.entries(c)
      .map(([k, v]) => `${k}=${v}`)
      .join(' '),
    text: text(Object.fromEntries(Object.entries(c).map(([k, v]) => [k, optionName(k, v)]))),
  }));
}

/** Podpisy zależne od wyborów: timer (wariant, kolor) i śruby (wykończenie). Reszta stała. */
const CHOSEN_LABELS: Record<string, (general: string) => { match: string; text: string }[]> = {
  timer: (general) =>
    labelVersions(['variant', 'color'], (n) =>
      !n.variant && !n.color
        ? general
        : [labels.kitTimer, n.variant, n.color && format(labels.kitTimerColor, { color: n.color })]
            .filter(Boolean)
            .join(', '),
    ),
  sruby: (general) =>
    labelVersions(['screws'], (n) =>
      n.screws ? format(labels.kitScrews, { screws: n.screws.toLocaleLowerCase(locale) }) : general,
    ),
};

const kitTiles = kitTexts
  ? KIT_TILES.map((name, i) => {
      const general = format(kitTexts.items[i]!.name, { mah: SKYTIMER_1_SPEC.batteryMah });
      return {
        labels: CHOSEN_LABELS[name]?.(general) ?? [{ match: '', text: general }],
        pictures: versionPictures([`element-${name}`], () => ''), // podpis pod zdjęciem wystarcza
        // część, którą można kupić osobno, prowadzi do strony akcesorium
        href: accessoryForKitItem(name) && accessoryPath(locale, { accessory: accessoryForKitItem(name)!.id }),
      };
    }).filter((t) => t.pictures.length > 0)
  : [];

const fromPrice =
  base !== null && firstStepPrices.length > 0 ? base + Math.min(...firstStepPrices) : null;
---

<BaseLayout
  locale={locale}
  title={title}
  description={dict.site.description}
  alternates={configuratorAlternates(product.id)}
>
  <SiteNav locale={locale} />
  <main class="buy">
    <header class="buy__head">
      <h1 class="buy__title">{heading}</h1>
      <p class="buy__meta">
        {product.status === 'available' ? dict.common.availableNow : dict.common.comingSoon}
      </p>
      {fromPrice !== null && fromPrice > 0 && (
        <p class="buy__meta">
          {format(labels.priceFrom, { price: formatPrice(fromPrice, locale) })}
        </p>
      )}
    </header>

    <div class="buy__grid">
      <div class="buy__media">
        <div class="buy__card">
          {gallery.length > 0 && (
            <Gallery
              images={gallery}
              labels={{
                prev: labels.galleryPrev,
                next: labels.galleryNext,
                dot: labels.galleryDot,
              }}
            />
          )}
        </div>
      </div>

      <div class="buy__steps">
        <Configurator
          client:load
          productId={product.id}
          bagHref={bagPath(locale)}
          definition={definition}
          texts={{
            slug: texts.slug,
            name: texts.name,
            ...(texts.steps ? { steps: texts.steps } : {}),
          }}
          locale={locale}
          hints={labels.optionHints[product.id] ?? {}}
          today={toDateKey(today)}
          urlParams={URL_PARAMS[product.id] ?? {}}
          labels={{
            summary: labels.summary,
            summaryHint: labels.summaryHint,
            quantity: labels.quantity,
            decrease: labels.decrease,
            increase: labels.increase,
            total: labels.total,
            chooseFirst: labels.chooseFirst,
            selectedOption: labels.selectedOption,
            perPiece: dict.common.perPiece,
            priceOnRequest: dict.common.priceOnRequest,
            lowestPrice30Days: dict.common.lowestPrice30Days,
            minOrder: dict.common.minOrder,
            addToBag: labels.addToBag,
            addedToBag: labels.addedToBag,
            viewBag: labels.viewBag,
          }}
        />
        {texts.mountingNote && <p class="buy__note">{texts.mountingNote}</p>}
      </div>
    </div>

    {kitTiles.length > 0 && (
      <section class="kit" aria-labelledby="kit-heading">
        <h2 class="kit__heading" id="kit-heading">
          {labels.kitHeading}
        </h2>
        <p class="kit__intro">{labels.kitIntro}</p>
        <ul class="kit__grid">
          {kitTiles.map((tile) => (
            <li class="kit__tile">
              <a class="kit__link" href={tile.href}>
              <div data-versions>
                {tile.pictures.map((picture, n) => (
                  <div class="kit__picture" data-match={picture.match} hidden={n > 0}>
                    <Picture
                      class="kit__img"
                      src={picture.src}
                      alt={picture.alt}
                      widths={[300, 500, 800]}
                      sizes="(max-width: 734px) 45vw, 280px"
                      formats={['avif', 'webp']}
                      quality={80}
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
              <p class="kit__name" data-versions>
                {tile.labels.map((label, n) => (
                  <span data-match={label.match} hidden={n > 0}>
                    {label.text}
                  </span>
                ))}
              </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="delivery" aria-labelledby="delivery-heading">
      <h2 class="kit__heading" id="delivery-heading">{labels.delivery.heading}</h2>
      <dl class="delivery__list">
        {labels.delivery.items.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.text}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>

  <script>
    import { showVersions } from '../../../lib/versions.ts';

    // Wersje zdjęć (kolor, wariant) w galerii i kafelkach zestawu idą za wyborami w konfiguratorze.
    window.addEventListener('configurator:change', (e) =>
      showVersions((e as CustomEvent<Record<string, string>>).detail),
    );

    // Po załadowaniu strony dociągamy w tle wszystkie ukryte wersje (kolory, warianty), żeby zmiana
    // opcji nie czekała na pobieranie. Zmiana lazy → eager uruchamia pobranie także dla ukrytych zdjęć.
    const preload = () =>
      document
        .querySelectorAll<HTMLImageElement>('main img[loading="lazy"]')
        .forEach((img) => (img.loading = 'eager'));
    window.addEventListener('load', () =>
      'requestIdleCallback' in window ? requestIdleCallback(preload) : setTimeout(preload, 500),
    );
  </script>
</BaseLayout>

<style>
  /* Białe tło strony, zdjęcia w szarych kartach (jak apple.com); białe tło renderów znika przez multiply. */
  :global(body) {
    background: var(--color-surface);
  }

  /* szerzej niż --content-wide: galeria i kroki w proporcjach strony Kup na apple.com */
  .buy {
    max-width: calc(90rem + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) 8rem;
  }

  /* ---------- Nagłówek ---------- */
  .buy__title {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.025em;
  }

  .buy__meta {
    font-size: 1.1875rem;
    line-height: 1.4;
  }

  .buy__title + .buy__meta {
    margin-top: 1.5rem;
  }

  /* ---------- Co jest w zestawie ---------- */
  .kit {
    margin-top: clamp(6rem, 12vw, 10rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-line);
    text-align: center;
  }

  .kit__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .kit__link[href]:hover .kit__name {
      text-decoration: underline;
    }
  }

  .kit__heading {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .kit__intro {
    max-width: 36rem;
    margin: 0.75rem auto 0;
    color: var(--color-text-2);
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.25rem);
    text-wrap: pretty;
  }

  .kit__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Szary kafelek (jak apple.com); multiply na zdjęciu zdejmuje białe tło renderu. */
  .kit__tile {
    padding: clamp(0.75rem, 1.5vw, 1.25rem) clamp(0.75rem, 1.5vw, 1.25rem)
      clamp(1.25rem, 2vw, 1.75rem);
    border-radius: 1.25rem;
    background: var(--color-bg);
  }

  .kit__name [hidden] {
    display: none;
  }

  /* Wersje kafelka leżą jedna na drugiej i przenikają się przy zmianie koloru. */
  .kit__tile [data-versions]:has(.kit__picture) {
    display: grid;
  }

  .kit__picture {
    grid-area: 1 / 1;
    mix-blend-mode: multiply; /* na elemencie z opacity, nie na <img> (inaczej biel w trakcie przejścia) */
  }

  .kit__picture[hidden] {
    display: block;
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .kit__picture {
      transition:
        opacity 350ms var(--ease-out),
        visibility 0s;
    }

    .kit__picture[hidden] {
      transition:
        opacity 350ms var(--ease-out),
        visibility 0s 350ms;
    }
  }

  .kit :global(.kit__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .kit__name {
    margin-top: 0.75rem;
    font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.0625rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  @media (max-width: 734px) {
    .kit__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Dostawa i zwroty ---------- */
  .delivery {
    margin-top: clamp(5rem, 10vw, 8rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-line);
    text-align: center;
  }

  .delivery__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    text-align: left;
  }

  .delivery__list dt {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .delivery__list dd {
    margin: 0.5rem 0 0;
    color: var(--color-text-2);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .buy__note {
    margin-top: 2rem;
    color: var(--color-text-2);
    font-size: 0.875rem;
  }

  /* ---------- Karta + kroki ---------- */
  .buy__grid {
    display: grid;
    gap: 3rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .buy__card {
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-bg);
    aspect-ratio: 1 / 1;
  }

  @media (min-width: 900px) {
    .buy__grid {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 30rem);
      gap: clamp(2.5rem, 4vw, 4.5rem);
      align-items: start;
    }

    /* Karta stoi pod paskiem menu, kiedy przewijasz kroki; koniec kolumny kroków (cena, "Dodaj do torby")
       kończy siatkę, więc dopiero wtedy karta odjeżdża razem ze stroną do "Co jest w zestawie". */
    .buy__media {
      position: sticky;
      top: calc(var(--nav-h) + 3rem);
    }

    .buy__card {
      aspect-ratio: auto;
      height: clamp(26rem, calc(100dvh - var(--nav-h) - 4.5rem), 48rem);
    }
  }
</style>
