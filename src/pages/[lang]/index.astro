---
/**
 * Strona główna w danym języku: /pl/
 * Na razie pasek menu i hero SkyTimer 1. h1 (nazwa firmy) jest dla czytników ekranu i Google,
 * nazwa produktu w hero to h2.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SkyTimerHero from '../../components/home/SkyTimerHero.astro';
import { LOCALES, type Locale } from '../../i18n/locales.ts';
import { getDictionary, productTexts } from '../../i18n/index.ts';
import { alternatesFor, configuratorPath, pathFor } from '../../i18n/routes.ts';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const dict = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  title={dict.pages.home.title}
  description={dict.site.description}
  alternates={alternatesFor('home')}
  theme="dark"
>
  <SiteNav locale={locale} />
  <main>
    <h1 class="visually-hidden">{dict.pages.home.title}</h1>
    <SkyTimerHero
      title={productTexts(dict, 'skytimer-1').name}
      tagline={dict.pages.home.hero.tagline}
      primaryLabel={dict.common.learnMore}
      primaryHref={pathFor(locale, { kind: 'product', id: 'skytimer-1' })}
      secondaryLabel={dict.common.buy}
      secondaryHref={configuratorPath(locale, 'skytimer-1')}
      imageAlt={dict.pages.home.hero.imageAlt}
    />
  </main>
</BaseLayout>
