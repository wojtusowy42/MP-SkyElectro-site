---
/**
 * Strona główna w danym języku: /pl/
 * TYMCZASOWO: surowa lista pozycji katalogu, żeby było widać, że dane i adresy działają.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, type Locale } from '../../i18n/locales.ts';
import { getDictionary, productTexts } from '../../i18n/index.ts';
import { alternatesFor, pathFor } from '../../i18n/routes.ts';
import { CATALOG } from '../../data/catalog.ts';
import { getProduct } from '../../data/products/index.ts';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const dict = getDictionary(locale);

const items = CATALOG.map((entry) => ({
  href: pathFor(locale, entry),
  name: entry.kind === 'product' ? productTexts(dict, entry.id).name : dict.pages[entry.id].name,
  comingSoon: entry.kind === 'product' && getProduct(entry.id)?.status === 'coming-soon',
}));
---

<BaseLayout
  locale={locale}
  title={dict.pages.home.title}
  description={dict.site.description}
  alternates={alternatesFor('home')}
>
  <h1>{dict.pages.home.title}</h1>
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href}>{item.name}</a>
        {item.comingSoon && <> ({dict.common.comingSoon})</>}
      </li>
    ))}
  </ul>
</BaseLayout>
