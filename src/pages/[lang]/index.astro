---
/**
 * Strona główna w danym języku: /pl/
 * Na razie tylko góra: pasek menu + hero SkyTimer 1 (wzór: apple.com).
 */
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import ProductHero from '../../components/ProductHero.astro';
import { LOCALES, type Locale } from '../../i18n/locales.ts';
import { getDictionary, productTexts } from '../../i18n/index.ts';
import { alternatesFor, configuratorPath, pathFor } from '../../i18n/routes.ts';
import { getProduct } from '../../data/products/index.ts';
import skytimerHero from '../../assets/renders/skytimer-1/hero.png';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const dict = getDictionary(locale);

const heroId = 'skytimer-1';
const heroProduct = getProduct(heroId);
const heroAvailable = heroProduct?.status === 'available';
---

<PageLayout
  locale={locale}
  title={dict.pages.home.title}
  description={dict.site.description}
  alternates={alternatesFor('home')}
>
  <h1 class="visually-hidden">{dict.pages.home.title}</h1>

  <ProductHero
    headingLevel="h2"
    title={productTexts(dict, heroId).name}
    tagline={dict.pages.home.hero.tagline}
    availability={heroAvailable ? dict.common.availableNow : dict.common.comingSoon}
    primaryLabel={dict.common.learnMore}
    primaryHref={pathFor(locale, { kind: 'product', id: heroId })}
    secondaryLabel={dict.common.order}
    secondaryHref={configuratorPath(locale, heroId)}
    image={skytimerHero}
    imageAlt={dict.pages.home.hero.imageAlt}
    subjectTop={0.461}
    colors={heroProduct?.colors}
  />
</PageLayout>
