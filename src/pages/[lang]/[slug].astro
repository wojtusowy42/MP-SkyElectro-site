---
/**
 * Wszystkie podstrony w danym języku: /pl/<slug>/
 * (produkty, akcesoria, usługi, kontakt). Adresy biorą się ze słownika języka.
 *
 * SkyTimer 1 ma pełną stronę "Dowiedz się więcej" (ProductStory): ciemną, w rozdziałach.
 * Przyciski pojemnościowe: jasną, kafelkową (ButtonsPage).
 * Ceny i konfigurator produktu są WYŁĄCZNIE na stronie Kup ([configurator].astro).
 * Reszta TYMCZASOWO: surowy HTML bez wyglądu.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import ProductStory from '../../components/product/ProductStory.astro';
import StoryCta from '../../components/product/StoryCta.astro';
import Contact from '../../components/Contact.astro';
import Services from '../../components/Services.astro';
import AccessoriesPage from '../../components/accessories/AccessoriesPage.astro';
import ButtonsPage from '../../components/product/przyciski/ButtonsPage.astro';
import SkyTimerHighlights from '../../components/product/skytimer/Highlights.astro';
import SkyTimerCloserLook from '../../components/product/skytimer/CloserLook.astro';
import SkyTimerTiming from '../../components/product/skytimer/Timing.astro';
import SkyTimerSafety from '../../components/product/skytimer/Safety.astro';
import SkyTimerMounting from '../../components/product/skytimer/Mounting.astro';
import SkyTimerKit from '../../components/product/skytimer/Kit.astro';
import SkyTimerSpecs from '../../components/product/skytimer/Specs.astro';
import skytimerIntroEnd from '../../assets/renders/skytimer-1/story/zlozenie-koniec.png';
import skytimerCtaImage from '../../assets/renders/skytimer-1/story/plytka-zlacze.jpg';
import { LOCALES } from '../../i18n/locales.ts';
import { getDictionary, productTexts } from '../../i18n/index.ts';
import { alternatesFor, configuratorPath, homePath, pathFor, slugFor } from '../../i18n/routes.ts';
import { CATALOG } from '../../data/catalog.ts';
import { getProduct } from '../../data/products/index.ts';

export const getStaticPaths = (() =>
  LOCALES.flatMap((lang) =>
    CATALOG.map((entry) => ({
      params: { lang, slug: slugFor(lang, entry) },
      props: { locale: lang, entry },
    })),
  )) satisfies GetStaticPaths;

const { locale, entry } = Astro.props;
const dict = getDictionary(locale);

const product = entry.kind === 'product' ? getProduct(entry.id) : undefined;
const texts = entry.kind === 'product' ? productTexts(dict, entry.id) : undefined;
const title = texts ? texts.name : entry.kind === 'page' ? dict.pages[entry.id].name : '';
const isSkyTimer = product?.id === 'skytimer-1';
const isServices = entry.kind === 'page' && entry.id === 'services';
const isContact = entry.kind === 'page' && entry.id === 'contact';
const isAccessories = entry.kind === 'page' && entry.id === 'accessories';
const isButtons = product?.id === 'przyciski-pojemnosciowe';
const story = dict.products['skytimer-1'].story;
const buyPath = configuratorPath(locale, 'skytimer-1');

---

{isSkyTimer && (
  <BaseLayout
    locale={locale}
    title={title}
    description={dict.site.description}
    alternates={alternatesFor(entry)}
    theme="dark"
  >
    <SiteNav locale={locale} sticky={false} />
    <main>
      <ProductStory
        title={title}
        localNav={{
          label: story.localNavLabel,
          links: [
            { label: story.localLinks.design, href: '#konstrukcja' },
            { label: story.localLinks.timing, href: '#czasy' },
            { label: story.localLinks.safety, href: '#bezpieczenstwo' },
            { label: story.localLinks.mounting, href: '#montaz' },
            { label: story.localLinks.kit, href: '#zestaw' },
            { label: story.localLinks.specs, href: '#dane' },
          ],
          orderHref: buyPath,
          orderLabel: dict.common.buy,
        }}
        intro={{
          video: `${import.meta.env.BASE_URL}video/skytimer-1/zlozenie`,
          poster: skytimerIntroEnd,
          tagline: story.tagline,
          description: story.introDescription,
        }}
      >
        <SkyTimerHighlights locale={locale} />
        <SkyTimerCloserLook locale={locale} />
        <SkyTimerTiming locale={locale} />
        <SkyTimerSafety locale={locale} />
        <SkyTimerMounting locale={locale} />
        <SkyTimerKit locale={locale} />
        <SkyTimerSpecs locale={locale} />
        <StoryCta
          heading={story.cta.heading}
          text={story.cta.text}
          image={skytimerCtaImage}
          alt={story.cta.alt}
          primaryLabel={dict.common.buy}
          primaryHref={buyPath}
          secondaryLabel={dict.pages.contact.name}
          secondaryHref={pathFor(locale, { kind: 'page', id: 'contact' })}
        />
      </ProductStory>
    </main>
  </BaseLayout>
)}

{isContact && (
  <BaseLayout
    locale={locale}
    title={title}
    description={dict.site.description}
    alternates={alternatesFor(entry)}
  >
    <SiteNav locale={locale} />
    <main>
      <Contact locale={locale} />
    </main>
  </BaseLayout>
)}

{isServices && (
  <BaseLayout
    locale={locale}
    title={title}
    description={dict.site.description}
    alternates={alternatesFor(entry)}
  >
    <SiteNav locale={locale} />
    <main>
      <Services locale={locale} />
    </main>
  </BaseLayout>
)}

{isAccessories && (
  <BaseLayout
    locale={locale}
    title={title}
    description={dict.site.description}
    alternates={alternatesFor(entry)}
  >
    <SiteNav locale={locale} />
    <main>
      <AccessoriesPage locale={locale} />
    </main>
  </BaseLayout>
)}

{isButtons && (
  <BaseLayout
    locale={locale}
    title={title}
    description={dict.site.description}
    alternates={alternatesFor(entry)}
  >
    <SiteNav locale={locale} sticky={false} />
    <main>
      <ButtonsPage locale={locale} />
    </main>
  </BaseLayout>
)}

{!isSkyTimer && !isButtons && !isContact && !isAccessories && !isServices && (
  <BaseLayout
    locale={locale}
    title={title}
    description={dict.site.description}
    alternates={alternatesFor(entry)}
  >
    <p>
      <a href={homePath(locale)}>{dict.pages.home.title}</a>
    </p>
    <h1>{title}</h1>

    {/* ---------- Produkt ---------- */}
    {product?.status === 'coming-soon' && <p>{dict.common.comingSoon}</p>}

    {product?.configurator && (
      <p>
        <a href={configuratorPath(locale, product.id)}>{dict.common.buy}</a>
      </p>
    )}

  </BaseLayout>
)}
